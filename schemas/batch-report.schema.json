{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galnx.local/schemas/batch-report.schema.json",
  "title": "GalNX batch report",
  "description": "Machine-readable report written by 'galnx batch run' / 'galnx batch build'. Preflight/plan runs never execute builds; build runs execute manifest build.commands and may add build/cache stages, artifact, cache and commands fields.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "root",
    "totals",
    "projects"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "required": [
        "total",
        "ok",
        "warn",
        "fail",
        "skipped",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "minimum": 0
        },
        "built": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name",
          "adapter",
          "status",
          "stages",
          "checks",
          "errors",
          "duration_s"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "warn",
              "fail",
              "skipped"
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status",
                "duration_s",
                "checks"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "warn",
                    "fail",
                    "skip"
                  ]
                },
                "duration_s": {
                  "type": "number",
                  "minimum": 0
                },
                "checks": {
                  "$ref": "#/$defs/checkList"
                }
              }
            }
          },
          "checks": {
            "$ref": "#/$defs/checkList"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "artifact": {
            "type": "object",
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "cache": {
            "type": "object",
            "required": [
              "hit",
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "hit": {
                "type": "boolean"
              },
              "key": {
                "type": "string"
              }
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "command",
                "duration_s",
                "exit_code",
                "log"
              ],
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string"
                },
                "duration_s": {
                  "type": "number",
                  "minimum": 0
                },
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "log": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "detail",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warn",
            "fail",
            "skip"
          ]
        },
        "detail": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "checkList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  }
}
