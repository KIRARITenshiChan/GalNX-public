+// ---- [GalNX] self-contained game payload v2 -----------------------------------------------
+// A GalNX pilot NSP carries the game next to the engine in romfs. romfs is read-only and TJS/KAG
+// expects a writable game folder on the SD card (saves, preference files), so on first boot we copy
+// the payload once to the SD card and write the autostart file the platform layer looks for
+// (environ/switch/SwitchUtils.cpp, TVPCheckStartupArg).
+//
+// romfs:/game_files.txt (generated by the GalNX packaging script, not by this patch) format:
+//     version=<payload id, bumped when the payload changes>
+//     target=/kirikiri/<game>          SD-card folder, TJS-visible path
+//     startup=/kirikiri/<game>/data.xp3  path handed to TVPMainScene::startupFrom() (must be a file)
+//     bytes=<total payload size>       optional; enables the free-space precheck
+//     marker=<path>/<file>             optional; defaults to sdmc:/switch/kirikiroid2/.galnx_extracted
+//     file=<relative path under romfs:/game/>   (one line per payload file)
+// A normal (non-GalNX) NRO build has no romfs:/game_files.txt and nothing happens here.
+//
+// v2 changes: free-space precheck (statvfs), CPU boost around the copy, mkdir of the switch folder
+// before marker/autostart, marker hit re-verified with stat(startup), startup-empty warning, and a
+// mkdir bug fix (the directory helper used to create the final *file* name as a directory).
+
+#include <sys/statvfs.h>
+
+static std::string GalNX_Trim(const std::string &s) {
+	size_t first = s.find_first_not_of(" \t\r\n");
+	if (first == std::string::npos)
+		return std::string();
+	size_t last = s.find_last_not_of(" \t\r\n");
+	return s.substr(first, last - first + 1);
+}
+
+// mkdir -p for a native ("sdmc:/...") directory path: every component is created, including the last
+static void GalNX_MkDirs(const std::string &dir) {
+	for (size_t i = 1; i <= dir.size(); ++i) {
+		if (i != dir.size() && dir[i] != '/')
+			continue;
+		if (i <= 4)
+			continue; // "", "sdmc"
+		if (dir[i - 1] == '/')
+			continue; // trailing slash: parent was just created
+		mkdir(dir.substr(0, i).c_str(), 0777);
+	}
+}
+
+// mkdir -p for the parent folder of a native file path (never creates the file name itself)
+static void GalNX_MkParentDirs(const std::string &file) {
+	const size_t pos = file.find_last_of('/');
+	if (pos == std::string::npos || pos == 0)
+		return;
+	GalNX_MkDirs(file.substr(0, pos));
+}
+
+static bool GalNX_WriteWholeFile(const std::string &native, const std::string &content) {
+	GalNX_MkParentDirs(native);
+	FILE *fp = fopen(native.c_str(), "wb");
+	if (!fp)
+		return false;
+	const bool ok = fwrite(content.data(), 1, content.size(), fp) == content.size();
+	fclose(fp);
+	return ok;
+}
+
+// true when the destination already has the expected size (resume after an interrupted copy)
+static bool GalNX_FileHasSize(const std::string &native, long long expected) {
+	struct stat st;
+	if (stat(native.c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+		return false;
+	return (long long)st.st_size == expected;
+}
+
+static bool GalNX_FileExists(const std::string &native) {
+	struct stat st;
+	return stat(native.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
+
+static long long GalNX_FileSize(const char *native) {
+	struct stat st;
+	if (stat(native, &st) != 0 || !S_ISREG(st.st_mode))
+		return -1;
+	return (long long)st.st_size;
+}
+
+// free bytes on the SD card, or -1 when statvfs is unavailable
+static long long GalNX_FreeBytes() {
+	struct statvfs vfs;
+	if (statvfs("sdmc:/", &vfs) != 0)
+		return -1;
+	const long long unit = (long long)(vfs.f_frsize ? vfs.f_frsize : vfs.f_bsize);
+	return (long long)vfs.f_bavail * unit;
+}
+
+// the copy is CPU/SD bound; FastLoad clocks the CPU up for the duration (ignored on failure)
+static void GalNX_BoostMode(bool on) {
+	const Result rc = appletSetCpuBoostMode(on ? ApmCpuBoostMode_FastLoad : ApmCpuBoostMode_Normal);
+	if (R_FAILED(rc))
+		printf("[GALNX] WARNING: appletSetCpuBoostMode(%d) failed (0x%x)\n", on ? 1 : 0, (unsigned)rc);
+	fflush(stdout);
+}
+
+static bool GalNX_CopyFile(const std::string &src, const std::string &dst, long long srcSize) {
+	if (GalNX_FileHasSize(dst, srcSize)) {
+		printf("[GALNX] keep existing %s\n", dst.c_str());
+		fflush(stdout);
+		return true;
+	}
+	FILE *in = fopen(src.c_str(), "rb");
+	if (!in) {
+		printf("[GALNX] FAILED to open payload file %s\n", src.c_str());
+		return false;
+	}
+	GalNX_MkParentDirs(dst);
+	FILE *out = fopen(dst.c_str(), "wb");
+	if (!out) {
+		printf("[GALNX] FAILED to create %s\n", dst.c_str());
+		fclose(in);
+		return false;
+	}
+	static char buf[1024 * 1024];
+	size_t n = 0;
+	bool ok = true;
+	while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
+		if (fwrite(buf, 1, n, out) != n) {
+			ok = false;
+			break;
+		}
+	}
+	if (ferror(in))
+		ok = false;
+	fclose(out);
+	fclose(in);
+	return ok;
+}
+
+static void GalNX_WriteAutostart(const std::string &startup) {
+	if (startup.empty())
+		return;
+	GalNX_MkDirs("sdmc:/switch/kirikiroid2");
+	if (!GalNX_WriteWholeFile("sdmc:/switch/kirikiroid2/autostart.txt", startup + "\n"))
+		printf("[GALNX] WARNING: could not write autostart.txt\n");
+	fflush(stdout);
+}
+
+// Copy the ROMFS payload to the SD card once. Safe to call on every boot: it returns immediately
+// when the marker matches the payload version and the startup file is still present.
+static void GalNX_MaybeExtractGame() {
+	FILE *fp = fopen("romfs:/game_files.txt", "r");
+	if (!fp)
+		return; // ordinary engine build, no embedded payload
+	std::string version, target, startup, marker;
+	long long declaredBytes = -1;
+	std::vector<std::string> files;
+	char line[1024];
+	while (fgets(line, (int)sizeof(line), fp)) {
+		const std::string s = GalNX_Trim(line);
+		if (s.empty() || s[0] == '#')
+			continue;
+		if (s.compare(0, 8, "version=") == 0)
+			version = s.substr(8);
+		else if (s.compare(0, 7, "target=") == 0)
+			target = s.substr(7);
+		else if (s.compare(0, 8, "startup=") == 0)
+			startup = s.substr(8);
+		else if (s.compare(0, 6, "bytes=") == 0)
+			declaredBytes = atoll(s.c_str() + 6);
+		else if (s.compare(0, 7, "marker=") == 0)
+			marker = s.substr(7);
+		else if (s.compare(0, 5, "file=") == 0)
+			files.push_back(s.substr(5));
+	}
+	fclose(fp);
+	if (target.empty() || files.empty()) {
+		printf("[GALNX] romfs:/game_files.txt is malformed (target/files missing), payload ignored\n");
+		fflush(stdout);
+		return;
+	}
+	if (marker.empty())
+		marker = "sdmc:/switch/kirikiroid2/.galnx_extracted";
+	if (startup.empty()) {
+		printf("[GALNX] WARNING: game_files.txt has no startup= entry; the payload will be copied but not launched\n");
+		fflush(stdout);
+	}
+	bool alreadyDone = false;
+	if (!version.empty()) {
+		FILE *m = fopen(marker.c_str(), "r");
+		if (m) {
+			char done[256] = { 0 };
+			const bool got = fgets(done, (int)sizeof(done) - 1, m) != nullptr;
+			fclose(m);
+			alreadyDone = got && GalNX_Trim(done) == version;
+		}
+	}
+	if (alreadyDone && !startup.empty() && !GalNX_FileExists("sdmc:" + startup)) {
+		printf("[GALNX] marker %s matched but sdmc:%s is missing; re-extracting the payload\n",
+			marker.c_str(), startup.c_str());
+		fflush(stdout);
+		alreadyDone = false;
+	}
+	if (alreadyDone) {
+		printf("[GALNX] payload %s already extracted, starting game\n", version.c_str());
+		fflush(stdout);
+		GalNX_WriteAutostart(startup);
+		return;
+	}
+	if (declaredBytes > 0) {
+		const long long freeBytes = GalNX_FreeBytes();
+		const long long margin = 256LL * 1024 * 1024;
+		if (freeBytes < 0) {
+			printf("[GALNX] WARNING: could not query free space on sdmc:/; skipping the precheck\n");
+			fflush(stdout);
+		} else if (freeBytes < declaredBytes + margin) {
+			printf("[GALNX] FAILED: payload needs %lld MiB but sdmc:/ has only %lld MiB free (margin %lld MiB); "
+				"marker not written, free some space and relaunch\n",
+				declaredBytes / (1024 * 1024), freeBytes / (1024 * 1024), margin / (1024 * 1024));
+			fflush(stdout);
+			return;
+		} else {
+			printf("[GALNX] free space check ok: %lld MiB free for a %lld MiB payload\n",
+				freeBytes / (1024 * 1024), declaredBytes / (1024 * 1024));
+			fflush(stdout);
+		}
+	}
+	printf("[GALNX] first boot: copying %u payload file(s) to sdmc:%s\n", (unsigned)files.size(), target.c_str());
+	fflush(stdout);
+	GalNX_MkDirs("sdmc:" + target);
+	GalNX_MkDirs("sdmc:/switch/kirikiroid2");
+	GalNX_BoostMode(true);
+	unsigned copied = 0, skipped = 0, failed = 0;
+	long long total = 0, logged = 0;
+	for (size_t i = 0; i < files.size(); ++i) {
+		const std::string &rel = files[i];
+		const std::string src = "romfs:/game/" + rel;
+		const std::string dst = "sdmc:" + target + "/" + rel;
+		const long long size = GalNX_FileSize(src.c_str());
+		if (size < 0) {
+			printf("[GALNX] payload entry missing from romfs: %s\n", src.c_str());
+			++failed;
+			continue;
+		}
+		if (GalNX_FileHasSize(dst, size)) {
+			++skipped;
+			total += size;
+		} else if (GalNX_CopyFile(src, dst, size)) {
+			++copied;
+			total += size;
+		} else {
+			++failed;
+		}
+		if (total - logged >= 256LL * 1024 * 1024) {
+			logged = total;
+			printf("[GALNX] progress: %u/%u files, %lld MiB\n", (unsigned)(i + 1), (unsigned)files.size(), total / (1024 * 1024));
+			fflush(stdout);
+		}
+	}
+	GalNX_BoostMode(false);
+	printf("[GALNX] payload copy finished: %u copied, %u kept, %u failed, %lld MiB total\n",
+		copied, skipped, failed, total / (1024 * 1024));
+	fflush(stdout);
+	if (failed != 0) {
+		printf("[GALNX] WARNING: %u payload file(s) failed; the game may not start. Marker not written.\n", failed);
+		fflush(stdout);
+		return; // retry the whole copy on the next boot
+	}
+	const std::string markerContent = (version.empty() ? std::string("extracted") : version) + "\n";
+	if (!GalNX_WriteWholeFile(marker, markerContent))
+		printf("[GALNX] WARNING: could not write marker %s\n", marker.c_str());
+	GalNX_WriteAutostart(startup);
+}
+
