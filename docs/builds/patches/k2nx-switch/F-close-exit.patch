diff --git a/src/core/visual/WindowIntf.cpp b/src/core/visual/WindowIntf.cpp
index 773b7f0..7e68eac 100644
--- a/src/core/visual/WindowIntf.cpp
+++ b/src/core/visual/WindowIntf.cpp
@@ -1908,6 +1908,63 @@ TJS_BEGIN_NATIVE_PROP_DECL(layerTreeOwnerInterface)
 TJS_END_NATIVE_PROP_DECL(layerTreeOwnerInterface)
 //----------------------------------------------------------------------
 
+//----------------------------------------------------------------------
+// [GalNX] Win32 compatibility layer. The Win32 build of Kirikiri had a real
+// window that games could minimize / restore, and games rely on it: the BASE
+// ADV SYSTEM engine (MainWindow.EscapeWork) tests `this.minimized` and calls
+// `this.minimize()` when the user presses ESC. The Switch build had no such
+// window state, so evaluating `this.minimized` raised
+// `Member "minimized" does not exist` and aborted the game script.
+// Report a constant non-minimized / non-maximized state and make the state
+// changing calls harmless no-ops.
+TJS_BEGIN_NATIVE_PROP_DECL(minimized)
+{
+	TJS_BEGIN_NATIVE_PROP_GETTER
+	{
+		// [GalNX] never minimized on Switch
+		*result = (tjs_int)0;
+		return TJS_S_OK;
+	}
+	TJS_END_NATIVE_PROP_GETTER
+
+	TJS_DENY_NATIVE_PROP_SETTER
+}
+TJS_END_NATIVE_PROP_DECL(minimized)
+//----------------------------------------------------------------------
+TJS_BEGIN_NATIVE_PROP_DECL(maximized)
+{
+	TJS_BEGIN_NATIVE_PROP_GETTER
+	{
+		// [GalNX] never maximized on Switch
+		*result = (tjs_int)0;
+		return TJS_S_OK;
+	}
+	TJS_END_NATIVE_PROP_GETTER
+
+	TJS_DENY_NATIVE_PROP_SETTER
+}
+TJS_END_NATIVE_PROP_DECL(maximized)
+//----------------------------------------------------------------------
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/minimize)
+{
+	// [GalNX] no-op: there is no OS window to minimize on Switch
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/minimize)
+//----------------------------------------------------------------------
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/maximize)
+{
+	// [GalNX] no-op
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/maximize)
+//----------------------------------------------------------------------
+TJS_BEGIN_NATIVE_METHOD_DECL(/*func. name*/restore)
+{
+	// [GalNX] no-op
+	return TJS_S_OK;
+}
+TJS_END_NATIVE_METHOD_DECL(/*func. name*/restore)
 	TJS_END_NATIVE_MEMBERS
 
 }
