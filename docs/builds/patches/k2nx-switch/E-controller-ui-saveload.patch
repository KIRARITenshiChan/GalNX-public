+// [GalNX] controller access to the in-game menu. The K2S drawer's top-left button opens the game's
+// own TJS menu (save / load / config) through TVPGetMenuDispatch(); a pad cannot press that button
+// because the drawer only knows touch events, so re-create the same call from onPadKeyDown().
+iTJSDispatch2* TVPGetMenuDispatch(tTVInteger hWnd);
+tTJSNI_Window *TVPGetActiveWindow();
+
+static iTVPBaseForm *GalNX_TopUIForm(cocos2d::Node *uiNode) {
+	if (!uiNode || uiNode->getChildren().empty()) return nullptr;
+	return dynamic_cast<iTVPBaseForm*>(uiNode->getChildren().back());
+}
+
+static void GalNX_ToggleInGameMenu(cocos2d::Node *uiNode) {
+	iTVPBaseForm *top = GalNX_TopUIForm(uiNode);
+	TVPInGameMenuForm *menuForm = dynamic_cast<TVPInGameMenuForm*>(top);
+	if (menuForm) {
+		TVPMainScene::GetInstance()->popUIForm(menuForm);
+		GalNXLog("[menu] closed");
+		return;
+	}
+	if (top) {
+		GalNXLog("[menu] open blocked: another K2S form is open (%p)", (void*)top);
+		return;
+	}
+	iTJSDispatch2 *menuobj = TVPGetMenuDispatch((tjs_intptr_t)TVPGetActiveWindow());
+	if (!menuobj) {
+		GalNXLog("[menu] no menu dispatch");
+		GalNX_EvalTJS("typeof kag == \"undefined\" ? \"kag:undefined\" : (\"kag:ok menu:\" + (kag.menu === void ? \"null\" : \"present\"))", "menu-probe");
+		return;
+	}
+	tTJSNI_MenuItem *menu = nullptr;
+	menuobj->NativeInstanceSupport(TJS_NIS_GETINSTANCE, tTJSNC_MenuItem::ClassID, (iTJSNativeInstance**)&menu);
+	if (!menu) { GalNXLog("[menu] no menu instance"); return; }
+	if (menu->GetChildren().empty()) { GalNXLog("[menu] empty menu"); return; }
+	GalNXLog("[menu] open GameMenu items=%d", (int)menu->GetChildren().size());
+	TVPMainScene::GetInstance()->pushUIForm(TVPInGameMenuForm::create("GameMenu", menu));
+}
+
+static bool GalNX_InGameMenuKey(cocos2d::Node *uiNode, int keyCode) {
+	TVPInGameMenuForm *menuForm = dynamic_cast<TVPInGameMenuForm*>(GalNX_TopUIForm(uiNode));
+	if (!menuForm) return false;
+	switch (keyCode) {
+	case cocos2d::Controller::BUTTON_DPAD_UP:
+		menuForm->navMove(-1);
+		GalNXLog("[menu] nav up");
+		return true;
+	case cocos2d::Controller::BUTTON_DPAD_DOWN:
+		menuForm->navMove(1);
+		GalNXLog("[menu] nav down");
+		return true;
+	case cocos2d::Controller::BUTTON_A:
+		GalNXLog("[menu] activate ret=%d", (int)menuForm->navActivate());
+		return true;
+	default:
+		return false;
+	}
+}
