+void TVPInGameMenuForm::navMove(int delta) {
+	const int n = (int)_navItems.size();
+	if (n == 0) return;
+	int i = _navSel;
+	for (int k = 0; k < n; ++k) {
+		i = (i + delta + n) % n;
+		if (_navActions[i]) {
+			_navSel = i;
+			updateNavVisual();
+			return;
+		}
+	}
+}
+
+bool TVPInGameMenuForm::navActivate() {
+	if (_navSel < 0 || _navSel >= (int)_navActions.size()) return false;
+	std::function<void()> action = _navActions[_navSel];
+	if (!action) return false;
+	action();
+	return true;
+}
+
+void TVPInGameMenuForm::updateNavVisual() {
+	for (size_t i = 0; i < _navItems.size(); ++i) {
+		if (_navItems[i]) _navItems[i]->setSelectedVisual((int)i == _navSel);
+	}
+}
