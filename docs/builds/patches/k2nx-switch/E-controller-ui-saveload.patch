+// [GalNX] quick save / quick load. KAG3 keeps its save / load entries in the game's own Window.menu,
+// and this port has no HWND based menu registry, so the menu can never be opened from a pad. Evaluate
+// KAG3's own TJS entry points instead (kag is the global KAGWindow created by Initialize.tjs):
+//   L shoulder -> kag.saveBookMark(0, false)  -> writes <dataPath>/<dataName>0.kdt (or .bmp)
+//   R shoulder -> kag.loadBookMark(0)         -> restores the same slot
+static void GalNX_EvalTJS(const char *expr, const char *tag) {
+	tTJSVariant result;
+	try {
+		TVPExecuteExpression(ttstr(expr), &result);
+		ttstr text(result);
+		std::string utf8 = text.AsStdString();
+		GalNXLog("[tjs] %s -> %s", tag, utf8.c_str());
+	} catch (const eTJS &e) {
+		std::string utf8 = e.GetMessage().AsStdString();
+		GalNXLog("[tjs] %s -> eTJS: %s", tag, utf8.c_str());
+	} catch (...) {
+		GalNXLog("[tjs] %s -> unknown exception", tag);
+	}
+}
+
+static bool GalNX_QuickSaveLoad(int keyCode) {
+	if (keyCode == cocos2d::Controller::BUTTON_LEFT_SHOULDER) {
+		GalNX_EvalTJS("MainObj.f[\"savetitle\"] = \"GalNX save\"", "preset-title");
+		GalNX_EvalTJS("MainObj.SaveAction(1)", "qsave");
+		GalNX_EvalTJS("MainObj.SystemSave()", "syssave");
+		GalNX_EvalTJS("\"saved1\"", "qsave-ok");
+		return true;
+	}
+	if (keyCode == cocos2d::Controller::BUTTON_RIGHT_SHOULDER) {
+		GalNX_EvalTJS("s[\"dlg_load\"] = false", "loadui-nodlg");
+		GalNX_EvalTJS("typeof MainObj", "loadui-mainobj");
+		GalNX_EvalTJS("MainObj.SaveLoadObj = new _SAVELOADOBJECT(MainObj, MainObj.PrimaryLayer, nLOAD_SC)", "loadui-open");
+		GalNX_EvalTJS("MainObj.ActiveObj = MainObj.SaveLoadObj", "loadui-active");
+		GalNX_EvalTJS("\"load-ui-shown\"", "loadui-ok");
+		return true;
+	}
+	if (keyCode == cocos2d::Controller::AXIS_RIGHT_TRIGGER) {
+		GalNX_EvalTJS("MainObj.DataLoadAction(10)", "qload10");
+		GalNX_EvalTJS("\"load10\"", "qload10-ok");
+		return true;
+	}
+	if (keyCode == cocos2d::Controller::BUTTON_START) {
+		GalNX_EvalTJS("MainObj.f[\"savetitle\"] = \"GalNX save\"", "preset-title");
+		GalNX_EvalTJS("s[\"dlg_save\"] = false", "saveui-nodlg");
+		GalNX_EvalTJS("MainObj.SaveLoadObj = new _SAVELOADOBJECT(MainObj, MainObj.PrimaryLayer, nSAVE_SC)", "ui-open");
+		GalNX_EvalTJS("MainObj.ActiveObj = MainObj.SaveLoadObj", "ui-active");
+		GalNX_EvalTJS("\"ui-shown\"", "ui-ok");
+		return true;
+	}
+	if (keyCode == cocos2d::Controller::BUTTON_X) {
+		GalNX_EvalTJS("MainObj.f[\"lastmess\"] === void ? \"lastmess-void\" : \"lastmess-ok\"", "probe-lastmess");
+		GalNX_EvalTJS("MainObj.f[\"savetitle\"] === void ? \"st-void\" : \"st-ok\"", "probe-savetitle");
+		GalNX_EvalTJS("typeof s === \"undefined\" ? \"s-undef\" : (s === void ? \"s-void\" : \"s-ok\")", "probe-sdict");
+		GalNX_EvalTJS("\"\" + Savefolder", "probe-savefolder");
+		GalNX_EvalTJS("MainObj.calcThumbnailSize().size", "probe-thumbsize");
+		GalNX_EvalTJS("MainObj.f[\"scenario\"]", "probe-scenario");
+		return true;
+	}
+	if (keyCode == cocos2d::Controller::AXIS_LEFT_TRIGGER) {
+		GalNX_EvalTJS("MainObj.SystemSave()", "syssave2");
+		GalNX_EvalTJS("\"syssave-done\"", "syssave2-ok");
+		return true;
+	}
+	return false;
+}
