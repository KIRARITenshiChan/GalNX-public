+// [GalNX] B = native back / cancel of the active game object.
+static void GalNX_GameBack(void) {
+    GalNX_EvalTJS("(MainObj.ActiveObj !== void && MainObj.ActiveObj !== MainObj && MainObj.ActiveObj.RightMouseUpAction !== void) ? MainObj.ActiveObj.RightMouseUpAction() : 0", "back");
+}
+
+// [GalNX] X = auto mode on/off (MessObject.tjs ButtonWorkFunc case 8).
+static void GalNX_ToggleAuto(void) {
+    GalNX_EvalScript("if(MainObj.MessObj !== void){ MainObj.MessObj.AutoFlag = !MainObj.MessObj.AutoFlag; if(MainObj.MessObj.AutoFlag){ MainObj.MessObj.AutoWait = false; MainObj.MessObj.AutoBefor = false; } }", "auto");
+}
