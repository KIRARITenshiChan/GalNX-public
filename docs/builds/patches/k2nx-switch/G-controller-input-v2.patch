+    } else {
+        GalNX_EvalScript("s.dlg_load = false;", "loadui-nodlg");
+        GalNX_EvalScript("MainObj.SaveLoadObj = new _SAVELOADOBJECT(MainObj, MainObj.PrimaryLayer, nLOAD_SC); MainObj.ActiveObj = MainObj.SaveLoadObj;", "loadui-open");
+    }
+}
