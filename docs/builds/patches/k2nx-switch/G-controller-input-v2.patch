+// [GalNX] open the game own save / load panel. A K2S form stacked on top of that panel swallows
+// the pad events and looks like a freeze (device report 1), so close every K2S form first.
+static void GalNX_OpenGameSaveLoad(cocos2d::Node *uiNode, bool saveMode) {
+    GalNX_CloseAllK2SForms(uiNode);
+    GalNX_EvalScript("if(MainObj.SaveLoadObj !== void){ MainObj.ActiveObj = MainObj.SaveLoadObj.TempActive; MainObj.SaveLoadObj = void; }", "sl-replace");
