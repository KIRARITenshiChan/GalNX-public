+// [GalNX] patch I: the game persists its settings, the save slot comments, the NEW marker and the
+// continue data only from MainWindow.finalize() (TraceSave + SystemSave). On Switch the close path
+// leaves the process before the TJS window is invalidated, so finalize never runs and all of those
+// values revert to the last properly closed session. Run the same two saves before leaving.
+static bool _galnxSaveOnExitDone = false;
+static void GalNX_SaveGameDataOnExit()
+{
+	if (_galnxSaveOnExitDone) return;
+	_galnxSaveOnExitDone = true;
+	try {
+		TVPExecuteScript(ttstr(TJS_W(
+			"if(MainObj !== void){"
+			"if(MainObj.TraceSave !== void)MainObj.TraceSave();"
+			"if(MainObj.SystemSave !== void)MainObj.SystemSave();"
+			"}")));
+		GalNXLog("[close] persisted system data (TraceSave + SystemSave)");
+	} catch (...) {
+		GalNXLog("[close] persisting system data raised an exception");
+	}
+}
+
