 void TVPMainScene::onPadKeyUp(cocos2d::Controller* ctrl, int keyCode, cocos2d::Event *e) {
+    // [GalNX] patch H: release the Ctrl that the R shoulder holds down.
+    if (keyCode == cocos2d::Controller::BUTTON_RIGHT_SHOULDER) {
+        if (_currentWindowLayer) {
+            bool was = (_scancode[VK_CONTROL] & 1) != 0;
+            _scancode[VK_CONTROL] &= 0x10;
+            if (was) _currentWindowLayer->OnKeyUp(VK_CONTROL, TVPGetCurrentShiftKeyState());
+            GalNXLog("[pad] ctrl up");
+        }
+        return;
+    }
 	unsigned int code = TVPConvertPadKeyCodeToVKCode(keyCode);
 	if (!code || code >= 0x200) return;
 	code = _keymap[code];
