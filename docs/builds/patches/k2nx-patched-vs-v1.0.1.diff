+// [GalNX] close every K2S form (file selector / preferences / message boxes) before opening game UI.
+static void GalNX_CloseAllK2SForms(cocos2d::Node *uiNode) {
+    if (!uiNode) return;
+    cocos2d::Node *prev = nullptr;
+    for (int guard = 0; guard < 8; ++guard) {
+        if (uiNode->getChildren().empty()) break;
+        cocos2d::Node *top = uiNode->getChildren().back();
+        if (top == prev) break;
+        if (!dynamic_cast<iTVPBaseForm*>(top)) break;
+        prev = top;
+        GalNXLog("[ui] closing K2S form %p", (void*)top);
+        TVPMainScene::GetInstance()->popUIForm(top);
+    }
+}
+
+// [GalNX] B = native back / cancel of the active game object.
+static void GalNX_GameBack(void) {
+    GalNX_EvalTJS("(MainObj.ActiveObj !== void && MainObj.ActiveObj !== MainObj && MainObj.ActiveObj.RightMouseUpAction !== void) ? MainObj.ActiveObj.RightMouseUpAction() : 0", "back");
+}
+
+// [GalNX] X = auto mode on/off (MessObject.tjs ButtonWorkFunc case 8).
