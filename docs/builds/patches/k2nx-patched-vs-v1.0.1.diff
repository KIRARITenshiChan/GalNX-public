+			       name.AsNarrowStdString().c_str(), dll.AsNarrowStdString().c_str());
+			return true;
+		}
+		printf("[GalNX] no built-in module for game plugin: %s\n", name.AsNarrowStdString().c_str());
+	} else {
+		printf("[GalNX] no built-in module for plugin: %s\n", name.AsNarrowStdString().c_str());
+	}
