+// ---------------------------------------------------------------------------
+// [GalNX] patch G controller helpers.
+// The BASE ADV SYSTEM scripts already implement the keyboard semantics, so the pad layer only
+// has to reach the same entry points:
+//   A / VK_RETURN -> MessObject.tjs:980 KeyUpAction advances the text; TitleObject.tjs:1143
+//                    KeyUpAction clicks the selected title menu entry (handled by the keymap).
+//   D-Pad         -> arrow keys; TitleObject.tjs KeyUpAction moves the title menu selection.
+//   VK_ESCAPE     -> unusable on this port: userFix.ks:500-505 sets nESC_KEY = false, so ESC runs
+//                    MainWindow.EscapeWork(), sets EscapeObj and calls this.minimize(). Patch F made
+//                    minimize() a no-op, so the game would stay with EscapeObj set and ignore input.
+//                    B maps to the native back action instead: RightMouseUpAction() of the active
+//                    object (MessObject toggles the message window, SaveLoadObject closes the
+//                    save/load panel, CheckDialog cancels, MovieObject stops the movie).
+//   X             -> MessObject.AutoFlag (same as MessObject.tjs ButtonWorkFunc case 8).
+//   Y / PLUS      -> the game own _SAVELOADOBJECT panels (nLOAD_SC / nSAVE_SC).
+//   MINUS         -> MainWindow.onCloseQuery(true): own confirm dialog, then the patch F exit.
+// ---------------------------------------------------------------------------
+static void GalNX_EvalScript(const char *script, const char *tag) {
+    try {
+        TVPExecuteScript(ttstr(script));
+        GalNXLog("[tjs] %s -> ok", tag);
+    } catch (const eTJS &e) {
+        std::string utf8 = e.GetMessage().AsStdString();
+        GalNXLog("[tjs] %s -> eTJS: %s", tag, utf8.c_str());
+    } catch (...) {
+        GalNXLog("[tjs] %s -> unknown exception", tag);
+    }
+}
