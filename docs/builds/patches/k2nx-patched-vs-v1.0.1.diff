+// [GalNX] input diagnostics: appended to sdmc:/galnx-input.log from the game thread.
+#include <cstdio>
+#include <cstdarg>
+static void GalNXLog(const char *fmt, ...) {
+	static bool s_ok = true;
+	if (!s_ok) return;
+	FILE *fp = fopen("sdmc:/galnx-input.log", "a");
+	if (!fp) { s_ok = false; return; }
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(fp, fmt, ap);
+	va_end(ap);
+	fputc(10, fp);
+	fclose(fp);
+}
