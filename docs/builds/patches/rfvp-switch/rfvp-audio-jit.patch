+//! Audio: the software mixer runs on the runtime's audio thread, which also owns the six hardware
+//! wave buffers. The frame thread only queues commands (play/stop/load/...) and then goes back to
+//! the engine, so a frame stalled inside an SD read can never stop the music.
+//!
+//! GalNX P30 note: v1.1.3/1.1.4 pre-rendered PCM into a 3.07 s ring from the frame thread. The
+//! producer kept the ring full, so every sound the engine mixed had to wait 3.07 s in the ring
+//! before it reached the device (the "audio is three seconds late" report). Mixing on the audio
+//! thread keeps the queue at the six hardware buffers (~128 ms, the same as the pre-P27 direct
+//! path) while still being independent of frame times.
+
+use alloc::collections::VecDeque;
+use alloc::vec::Vec;
+use core::cell::UnsafeCell;
+use core::ops::{Deref, DerefMut};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use rfvp::host_api::{
+    AudioParams, AudioSampleFormat, AudioStreamDesc, AudioStreamId, EncodedAudioKind, RfvpAudio,
+    RfvpError, RfvpResult, SoftAudioConfig, SoftAudioMixer, SoftAudioVorbis,
+};
+
+const OUTPUT_SAMPLE_RATE: u32 = 48_000;
+/// Frames in one buffer of the runtime's audio driver (`AudioBufferFrames` in main.c).
+const MIX_FRAMES: usize = 1024;
+
+#[repr(C)]
+struct RfvpOggVorbisInfo {
+    sample_rate: u32,
+    channels: u16,
+}
+
+enum RfvpOggVorbis {}
+
+extern "C" {
+    fn rfvp_ogg_open_memory(
+        bytes: *const u8,
+        byte_len: usize,
+        out_info: *mut RfvpOggVorbisInfo,
+        out_decoder: *mut *mut RfvpOggVorbis,
+    ) -> i32;
+    fn rfvp_ogg_decode_interleaved_i16(
+        decoder: *mut RfvpOggVorbis,
+        out_samples: *mut i16,
+        max_interleaved_samples: i32,
+    ) -> i32;
+    fn rfvp_ogg_seek_start(decoder: *mut RfvpOggVorbis) -> i32;
+    fn rfvp_ogg_close(decoder: *mut RfvpOggVorbis);
+}
+
+/* ---- Tiny spin lock ----------------------------------------------------------------------- */
+
+/// A lock that never sleeps: the frame thread and the audio thread only hold it for a queue swap
+/// or a single mixer call. `core` has no `Mutex`; libnx has the kernel one, but this file also
+/// builds for the CPU test harness, and the critical sections are short enough for a spin.
+struct SpinLock<T: ?Sized> {
+    locked: AtomicBool,
+    data: UnsafeCell<T>,
+}
+
+// The data is only ever reachable through the guard; every type stored here is either plain data or
+// (for the mixer) touched by one thread at a time.
+unsafe impl<T: ?Sized + Send> Sync for SpinLock<T> {}
+
+impl<T> SpinLock<T> {
+    const fn new(data: T) -> Self {
+        Self {
+            locked: AtomicBool::new(false),
+            data: UnsafeCell::new(data),
+        }
+    }
+
+    fn lock(&self) -> SpinGuard<'_, T> {
+        while self.locked.swap(true, Ordering::Acquire) {
+            core::hint::spin_loop();
+        }
+        SpinGuard { lock: self }
+    }
+}
+
+struct SpinGuard<'a, T: ?Sized> {
+    lock: &'a SpinLock<T>,
+}
+
+impl<T: ?Sized> Deref for SpinGuard<'_, T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        unsafe { &*self.lock.data.get() }
+    }
+}
+
+impl<T: ?Sized> DerefMut for SpinGuard<'_, T> {
+    fn deref_mut(&mut self) -> &mut T {
+        unsafe { &mut *self.lock.data.get() }
+    }
+}
+
+impl<T: ?Sized> Drop for SpinGuard<'_, T> {
+    fn drop(&mut self) {
+        self.lock.locked.store(false, Ordering::Release);
+    }
+}
+
+/* ---- Commands the frame thread hands to the audio thread ---------------------------------- */
+
+enum Command {
+    LoadEncoded {
+        id: AudioStreamId,
+        kind: EncodedAudioKind,
+        bytes: Vec<u8>,
+    },
+    CreateStream {
+        id: AudioStreamId,
+        desc: AudioStreamDesc,
+    },
+    SubmitI16 {
+        id: AudioStreamId,
+        samples: Vec<i16>,
+    },
+    SubmitF32 {
+        id: AudioStreamId,
+        samples: Vec<f32>,
+    },
+    Play {
+        id: AudioStreamId,
+        params: AudioParams,
+        fade_in_ms: u32,
+    },
+    Stop {
+        id: AudioStreamId,
+        fade_ms: u32,
+    },
+    Pause {
+        id: AudioStreamId,
+    },
+    Resume {
+        id: AudioStreamId,
+    },
+    SetParams {
+        id: AudioStreamId,
+        params: AudioParams,
+    },
+    SetMasterVolume {
+        volume: f32,
+    },
+    DestroyStream {
+        id: AudioStreamId,
+    },
+}
+
+struct AudioEngine {
+    mixer: SoftAudioMixer<HorizonVorbisBackend>,
+    chunk: Vec<i16>,
+}
+
+// Only reachable through the engine lock; the mixer and its vorbis decoders are used from the one
+// thread that holds that lock.
+unsafe impl Send for AudioEngine {}
+
+impl AudioEngine {
+    fn new() -> Self {
+        Self {
+            mixer: SoftAudioMixer::new(
+                HorizonVorbisBackend,
+                SoftAudioConfig {
+                    output_sample_rate: OUTPUT_SAMPLE_RATE,
+                    mix_frames: MIX_FRAMES,
+                    max_active_bgm: 2,
+                    max_active_se: 16,
+                    max_active_total: 24,
+                },
+            ),
+            chunk: alloc::vec![0; MIX_FRAMES * 2],
+        }
+    }
+
+    fn apply(&mut self, command: Command) {
+        let result = match command {
+            Command::LoadEncoded { id, kind, bytes } => self.mixer.load_encoded(id, kind, &bytes),
+            Command::CreateStream { id, desc } => self.mixer.create_stream(id, desc),
+            Command::SubmitI16 { id, samples } => self.mixer.submit_i16(id, &samples),
+            Command::SubmitF32 { id, samples } => self.mixer.submit_f32(id, &samples),
+            Command::Play {
+                id,
+                params,
+                fade_in_ms,
+            } => self.mixer.play(id, params, fade_in_ms),
+            Command::Stop { id, fade_ms } => self.mixer.stop(id, fade_ms),
+            Command::Pause { id } => self.mixer.pause(id),
+            Command::Resume { id } => self.mixer.resume(id),
+            Command::SetParams { id, params } => self.mixer.set_params(id, params),
+            Command::SetMasterVolume { volume } => self.mixer.set_master_volume(volume),
+            Command::DestroyStream { id } => {
+                self.mixer.destroy_stream(id);
+                Ok(())
+            }
+        };
+        if let Err(error) = result {
+            crate::ffi::log(alloc::format!("rfvp: audio command failed: {error:?}\n").as_str());
+        }
+    }
+
+    fn render(&mut self, out: &mut [i16]) {
+        for part in out.chunks_mut(MIX_FRAMES * 2) {
+            match self.mixer.mix_next(&mut self.chunk) {
+                Ok(true) => part.copy_from_slice(&self.chunk[..part.len()]),
+                _ => part.fill(0),
+            }
+        }
+    }
+}
+
+/* ---- Globals ------------------------------------------------------------------------------ */
+
+static QUEUE: SpinLock<VecDeque<Command>> = SpinLock::new(VecDeque::new());
+static ENGINE: SpinLock<Option<AudioEngine>> = SpinLock::new(None);
+
+fn push(command: Command) {
+    QUEUE.lock().push_back(command);
+}
+
+/// Install the real mixer. Called once, while the session is created and before the audio thread
+/// starts; the frame thread only ever sees the command proxy below.
+pub fn install_mixer() {
+    let mut engine = ENGINE.lock();
+    if engine.is_none() {
+        *engine = Some(AudioEngine::new());
+    }
+}
+
+/// The frame-thread handle to the audio system. Its `RfvpAudio` methods only enqueue commands.
+pub struct HorizonAudio;
+
+impl HorizonAudio {
+    pub fn new() -> Self {
+        install_mixer();
+        Self
+    }
+
+    /// Mix the next `out.len() / 2` frames. Called from the runtime's audio thread (or from the
+    /// frame thread when the audio thread could not be created): drain the commands the frame
+    /// thread queued since the last call, apply them and mix just in time.
+    pub fn render(&mut self, out: &mut [i16]) {
+        let mut commands = QUEUE.lock();
+        let pending: VecDeque<Command> = core::mem::take(&mut *commands);
+        drop(commands);
+        let mut engine = ENGINE.lock();
+        match engine.as_mut() {
+            Some(engine) => {
+                for command in pending {
+                    engine.apply(command);
+                }
+                engine.render(out);
+            }
+            None => out.fill(0),
+        }
+    }
+}
+
+impl Default for HorizonAudio {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl RfvpAudio for HorizonAudio {
+    fn load_encoded(
+        &mut self,
+        id: AudioStreamId,
+        kind: EncodedAudioKind,
+        bytes: &[u8],
+    ) -> RfvpResult<()> {
+        push(Command::LoadEncoded {
+            id,
+            kind,
+            bytes: bytes.to_vec(),
+        });
+        Ok(())
+    }
+
+    fn create_stream(&mut self, id: AudioStreamId, desc: AudioStreamDesc) -> RfvpResult<()> {
+        push(Command::CreateStream { id, desc });
+        Ok(())
+    }
+
+    fn submit_i16(&mut self, id: AudioStreamId, samples: &[i16]) -> RfvpResult<()> {
+        push(Command::SubmitI16 {
+            id,
+            samples: samples.to_vec(),
+        });
+        Ok(())
+    }
+
+    fn submit_f32(&mut self, id: AudioStreamId, samples: &[f32]) -> RfvpResult<()> {
+        push(Command::SubmitF32 {
+            id,
+            samples: samples.to_vec(),
+        });
+        Ok(())
+    }
+
+    fn play(&mut self, id: AudioStreamId, params: AudioParams, fade_in_ms: u32) -> RfvpResult<()> {
+        push(Command::Play {
+            id,
+            params,
+            fade_in_ms,
+        });
+        Ok(())
+    }
+
+    fn stop(&mut self, id: AudioStreamId, fade_ms: u32) -> RfvpResult<()> {
+        push(Command::Stop { id, fade_ms });
+        Ok(())
+    }
+
+    fn pause(&mut self, id: AudioStreamId) -> RfvpResult<()> {
+        push(Command::Pause { id });
+        Ok(())
+    }
+
+    fn resume(&mut self, id: AudioStreamId) -> RfvpResult<()> {
+        push(Command::Resume { id });
+        Ok(())
+    }
+
+    fn set_params(&mut self, id: AudioStreamId, params: AudioParams) -> RfvpResult<()> {
+        push(Command::SetParams { id, params });
+        Ok(())
+    }
+
+    fn set_master_volume(&mut self, volume: f32) -> RfvpResult<()> {
+        push(Command::SetMasterVolume { volume });
+        Ok(())
+    }
+
+    fn destroy_stream(&mut self, id: AudioStreamId) {
+        push(Command::DestroyStream { id });
+    }
+
+    /// The mixer now runs where the device pulls audio, so there is nothing to advance per frame.
+    fn tick(&mut self, _delta_us: u64) -> RfvpResult<()> {
+        Ok(())
+    }
+}
+
+struct HorizonVorbisBackend;
+
+struct HorizonVorbisDecoder {
+    ptr: *mut RfvpOggVorbis,
+}
+
+impl SoftAudioVorbis for HorizonVorbisBackend {
+    type Decoder = HorizonVorbisDecoder;
+
+    fn open(&mut self, bytes: &[u8]) -> RfvpResult<(Self::Decoder, AudioStreamDesc)> {
+        if bytes.is_empty() {
+            return Err(RfvpError::InvalidData);
+        }
+        let mut info = RfvpOggVorbisInfo {
+            sample_rate: 0,
+            channels: 0,
+        };
+        let mut decoder = core::ptr::null_mut();
+        let status =
+            unsafe { rfvp_ogg_open_memory(bytes.as_ptr(), bytes.len(), &mut info, &mut decoder) };
+        if status != 0 || decoder.is_null() || info.sample_rate == 0 || info.channels == 0 {
+            return Err(RfvpError::InvalidData);
+        }
+        Ok((
+            HorizonVorbisDecoder { ptr: decoder },
+            AudioStreamDesc {
+                sample_rate: info.sample_rate,
+                channels: info.channels,
+                sample_format: AudioSampleFormat::I16,
+            },
+        ))
+    }
+
+    fn decode_interleaved_i16(
+        &mut self,
+        decoder: &mut Self::Decoder,
+        out_samples: &mut [i16],
+    ) -> RfvpResult<usize> {
+        let max_samples =
+            i32::try_from(out_samples.len()).map_err(|_| RfvpError::CapacityExceeded)?;
+        let decoded = unsafe {
+            rfvp_ogg_decode_interleaved_i16(decoder.ptr, out_samples.as_mut_ptr(), max_samples)
+        };
+        if decoded < 0 {
+            return Err(RfvpError::InvalidData);
+        }
+        Ok(decoded as usize)
+    }
+
+    fn seek_start(&mut self, decoder: &mut Self::Decoder) -> RfvpResult<()> {
+        let status = unsafe { rfvp_ogg_seek_start(decoder.ptr) };
+        if status == 0 {
+            Ok(())
+        } else {
+            Err(RfvpError::InvalidData)
+        }
+    }
+
+    fn close(&mut self, decoder: Self::Decoder) {
+        if !decoder.ptr.is_null() {
+            unsafe {
+                rfvp_ogg_close(decoder.ptr);
+            }
+        }
+    }
+}
