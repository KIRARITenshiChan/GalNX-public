+    stat_begin_us = 0;
+    out[1] = (uint64_t) stat_draw_calls;
+    stat_draw_calls = 0;
+    out[2] = stat_upload_us;
+    stat_upload_us = 0;
+    out[3] = (uint64_t) stat_upload_calls;
+    stat_upload_calls = 0;
+    out[4] = (uint64_t) stat_flush_calls;
+    stat_flush_calls = 0;
+    out[5] = stat_present_us;
+    stat_present_us = 0;
+    out[6] = stat_thumb_us;
+    stat_thumb_us = 0;
+    out[7] = (uint64_t) stat_thumb_calls;
