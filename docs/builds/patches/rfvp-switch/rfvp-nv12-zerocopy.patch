+/* ---- NV12 movie textures ---------------------------------------------------------------
+ * The movie decoder produces NV12 planes (full-size luma, half-size interleaved chroma). Uploading
+ * them as an SDL NV12 texture lets the GLES2 renderer do YUV -> RGB in its fragment shader: the CPU
+ * never touches the pixels, and only 1.5 bytes per pixel cross into the GPU instead of the 4 bytes
+ * an RGBA conversion needs. */
+
+static int nv12_uv_pitch(int width) {
+    return ((width + 1) / 2) * 2;
+}
+
+int galnx_sdl_nv12_supported(void) {
+    static int cached = -1;
+    SDL_Texture* probe;
+    FILE* force;
+    if (cached >= 0) return cached;
+    /* Debug switch: sdmc:/switch/rfvp/nv12_off.txt forces the RGBA path so the two upload
+     * modes can be compared without rebuilding. */
+    force = fopen("sdmc:/switch/rfvp/nv12_off.txt", "rb");
+    if (force != NULL) {
+        fclose(force);
+        cached = 0;
+        galnx_log("[rfvp] NV12 upload disabled by sdmc:/switch/rfvp/nv12_off.txt\n");
+        return 0;
+    }
+
+    if (!ready) return 0;
+    probe = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_NV12, SDL_TEXTUREACCESS_STREAMING, 16, 16);
+    if (probe == NULL) {
+        cached = 0;
+        galnx_log("[rfvp] NV12 textures unavailable: %s; movies use the RGBA path\n", SDL_GetError());
+        return 0;
+    }
+    SDL_DestroyTexture(probe);
+    cached = 1;
+    return 1;
+}
+
+static int sdl_texture_create_nv12_impl(unsigned id, int width, int height,
+                                        const unsigned char* y_plane, long y_length,
+                                        const unsigned char* uv_plane, long uv_length) {
+    TextureEntry* entry;
+    SDL_Texture* texture;
+    int reused = 0;
+    int uv_pitch;
+    long uv_bytes;
+    if (!ready || width <= 0 || height <= 0) return -1;
+    if (y_plane == NULL || uv_plane == NULL) return -2;
+    uv_pitch = nv12_uv_pitch(width);
+    uv_bytes = (long) uv_pitch * ((height + 1) / 2);
+    if (y_length < (long) width * height) return -3;
+    if (uv_length < uv_bytes) return -3;
+    entry = find_texture(id);
+    if (entry == NULL && texture_count >= MaxTextures) return -2;
+    /* Same id and size: keep the GL object, as the RGBA path does for graphs that redraw. */
+    if (entry != NULL && entry->texture != NULL && entry->width == width &&
+        entry->height == height && entry->format == FormatNv12) {
+        texture = entry->texture;
+        reused = 1;
+    } else {
+        texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_NV12,
+                                   SDL_TEXTUREACCESS_STREAMING, width, height);
+        if (texture == NULL) return -4;
+        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_BLEND);
+        SDL_SetTextureScaleMode(texture, SDL_ScaleModeLinear);
+    }
+    if (SDL_UpdateNVTexture(texture, NULL, y_plane, width, uv_plane, uv_pitch) != 0) {
+        galnx_log("[rfvp] SDL_UpdateNVTexture %dx%d failed: %s\n", width, height, SDL_GetError());
+        if (!reused) SDL_DestroyTexture(texture);
+        return -6;
+    }
+    if (entry == NULL) {
+        entry = &textures[texture_count++];
+    } else if (entry->texture != texture) {
+        SDL_DestroyTexture(entry->texture);
+    }
+    entry->id = (int) id;
+    entry->texture = texture;
+    entry->width = width;
+    entry->height = height;
+    entry->format = FormatNv12;
+    return 0;
+}
+
+int galnx_sdl_texture_create_nv12(unsigned id, int width, int height,
+                                  const unsigned char* y_plane, long y_length,
+                                  const unsigned char* uv_plane, long uv_length) {
+    uint64_t started = stat_now();
+    int rc;
+    batch_flush();
+    rc = sdl_texture_create_nv12_impl(id, width, height, y_plane, y_length, uv_plane, uv_length);
+    stat_upload_calls++;
+    stat_upload_us += stat_now() - started;
+    return rc;
