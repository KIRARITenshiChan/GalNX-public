+        if !self.ensure_video() {
+            return Ok(());
+        }
+        let rc = unsafe {
+            sdl::galnx_sdl_texture_create_nv12(
+                id.0 as c_uint,
+                width as c_int,
+                height as c_int,
+                y_plane.as_ptr() as *const c_uchar,
+                y_plane.len() as c_ulong,
+                uv_plane.as_ptr() as *const c_uchar,
+                uv_plane.len() as c_ulong,
+            )
+        };
+        if rc != 0 {
+            // The caller keeps drawing; the graph simply stays on its previous contents.
+            sdl::log(&alloc::format!(
+                "rfvp: nv12 texture create failed: id={} {}x{} rc={}
+",
+                id.0,
+                width,
+                height,
+                rc
+            ));
+            return Ok(());
+        }
