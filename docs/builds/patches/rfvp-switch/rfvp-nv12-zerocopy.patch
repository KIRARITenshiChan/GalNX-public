+/* GalNX P44: copy the current frame into tight NV12 planes (Y rows, then interleaved UV rows) so
+ * the renderer can upload it as a two-plane texture and convert it on the GPU. Returns the number
+ * of bytes written, or a negative value when the frame cannot be staged. */
+long galnx_movie_stage_nv12(unsigned char* dst, long capacity) {
+    int width, height, uv_pitch, uv_width, uv_rows, row;
+    long y_bytes, uv_bytes, total;
+    if (g_ctx == NULL || dst == NULL) return -1;
+    width = g_ctx->width;
+    height = g_ctx->height;
+    if (width <= 0 || height <= 0) return -1;
+    if (g_ctx->plane_y == NULL || g_ctx->plane_u == NULL) return -1;
+    uv_pitch = ((width + 1) / 2) * 2;
+    uv_width = (width + 1) / 2;
+    uv_rows = (height + 1) / 2;
+    y_bytes = (long) width * height;
+    uv_bytes = (long) uv_pitch * uv_rows;
+    total = y_bytes + uv_bytes;
+    if (capacity < total) return -2;
+
+    for (row = 0; row < height; ++row) {
+        memcpy(dst + (long) row * width, g_ctx->plane_y + (long) row * g_ctx->y_stride,
+               (size_t) width);
+    }
+    if (g_ctx->planar) {
+        const uint8_t* src_u = g_ctx->plane_u;
+        const uint8_t* src_v = g_ctx->plane_v;
+        int stride = g_ctx->uv_stride;
+        if (src_v == NULL) return -1;
+        for (row = 0; row < uv_rows; ++row) {
+            unsigned char* out = dst + y_bytes + (long) row * uv_pitch;
+            int col;
+            for (col = 0; col < uv_width; ++col) {
+                out[col * 2 + 0] = src_u[(long) row * stride + col];
+                out[col * 2 + 1] = src_v[(long) row * stride + col];
+            }
+        }
+    } else {
+        for (row = 0; row < uv_rows; ++row) {
+            memcpy(dst + y_bytes + (long) row * uv_pitch,
+                   g_ctx->plane_u + (long) row * g_ctx->uv_stride, (size_t) uv_width * 2);
+        }
+    }
+    return total;
+}
