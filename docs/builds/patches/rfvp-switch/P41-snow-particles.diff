+/* GalNX P41: which movie index the debug marker asks for, so the ED path can be exercised
+ * without clearing a route. "movie=2" / "index=2" plays movie/02.wmv (moyu ED), anything else
+ * keeps the historical OP target movie/01.wmv. Debug-only, same marker file as above. */
+int rfvp_switch_debug_movie_index(void) {
+    char buf[256] = { 0 };
+    if (!read_movie_debug_file(buf, sizeof(buf))) return 1;
+    if (strstr(buf, "movie=2") != NULL || strstr(buf, "index=2") != NULL) return 2;
+    if (strstr(buf, "movie=3") != NULL || strstr(buf, "index=3") != NULL) return 3;
+    return 1;
+}
+
+/* GalNX P41 SELFTEST ONLY: the movie-skip check in the game scripts reads InputGetState() bit 0/1
+ * (Shift / Ctrl). Citron cannot deliver a pad R press from an injected keyboard key in this
+ * harness, so a marker file "skip=1" in movie_debug.txt lets a Citron run hold Ctrl synthetically
+ * and prove that the script's skip branch really stops the movie. Production runs never have the
+ * marker, so nothing changes for the device. */
+int rfvp_switch_skip_probe(void) {
+    static int cached = -1;
+    if (cached >= 0) return cached;
+    char buf[256] = { 0 };
+    cached = (read_movie_debug_file(buf, sizeof(buf)) && strstr(buf, "skip=1") != NULL) ? 1 : 0;
+    return cached;
+}
+
