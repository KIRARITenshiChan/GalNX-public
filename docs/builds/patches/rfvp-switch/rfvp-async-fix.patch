+/// GalNX P22: the lock that guards one pack file handle.
+///
+/// v1.0.8/v1.0.9 guarded the handle with the crate's Mutex, which is spin::Mutex in the no_std
+/// console build (crates/rfvp/src/lib.rs:975). The decode worker holds this lock across an SD-card
+/// read, and Horizon schedules threads strictly by priority inside one core: the frame thread
+/// (prio 0x2C) spinning in user space on the same ideal core (cpuid -2 resolves to core 0) never
+/// let the lower-priority worker (prio 0x30) run again, so the lock was never released and the
+/// whole process froze with no crash and no error log (GalNX P21 RCA).
+///
+/// The console build now guards the handle with libnx's Mutex, a kernel object: a waiter is parked
+/// by svcArbitrateLock instead of burning its core, and the kernel's priority inheritance keeps the
+/// holder runnable. The worker also moved to core 1 (platform/switch/runtime/main.c), so even the
+/// short spin-locked engine caches cannot stall it behind the frame thread.
+#[cfg(all(target_os = "horizon", feature = "no_std"))]
+mod pack_lock {
+    use core::cell::UnsafeCell;
+    use core::ops::{Deref, DerefMut};
+
+    /// libnx Mutex is newlib's _LOCK_T, a uint32_t (switch/kernel/mutex.h:12); 0 is the
+    /// statically-initialised unlocked state (mutexInit only stores INVALID_HANDLE, also 0).
+    extern "C" {
+        fn mutexLock(mutex: *mut u32);
+        fn mutexUnlock(mutex: *mut u32);
+    }
+
+    pub struct PackMutex<T> {
+        lock: UnsafeCell<u32>,
+        value: UnsafeCell<T>,
+    }
+
+    // SAFETY: the value is only reachable through the lock, and a guard is the only way to see it.
+    unsafe impl<T: Send> Send for PackMutex<T> {}
+    unsafe impl<T: Send> Sync for PackMutex<T> {}
+
+    impl<T> PackMutex<T> {
+        pub const fn new(value: T) -> Self {
+            Self {
+                lock: UnsafeCell::new(0),
+                value: UnsafeCell::new(value),
+            }
+        }
+
+        pub fn lock(&self) -> PackMutexGuard<'_, T> {
+            // SAFETY: lock points at a valid mutex word that lives as long as self.
+            unsafe { mutexLock(self.lock.get()) };
+            PackMutexGuard { mutex: self }
+        }
+    }
+
+    pub struct PackMutexGuard<'a, T> {
+        mutex: &'a PackMutex<T>,
+    }
+
+    impl<T> Deref for PackMutexGuard<'_, T> {
+        type Target = T;
+
+        fn deref(&self) -> &T {
+            // SAFETY: the guard holds the mutex, so no other reference is handed out.
+            unsafe { &*self.mutex.value.get() }
+        }
+    }
+
+    impl<T> DerefMut for PackMutexGuard<'_, T> {
+        fn deref_mut(&mut self) -> &mut T {
+            // SAFETY: the guard holds the mutex, so no other reference is handed out.
+            unsafe { &mut *self.mutex.value.get() }
+        }
+    }
+
+    impl<T> Drop for PackMutexGuard<'_, T> {
+        fn drop(&mut self) {
+            // SAFETY: the same mutex word that was locked in PackMutex::lock.
+            unsafe { mutexUnlock(self.mutex.lock.get()) };
+        }
+    }
+}
+
+#[cfg(all(target_os = "horizon", feature = "no_std"))]
+type PackFileLock<F> = pack_lock::PackMutex<F>;
+/// Every other host keeps the normal mutex: there is no kernel object to park on there.
+#[cfg(not(all(target_os = "horizon", feature = "no_std")))]
+type PackFileLock<F> = Mutex<F>;
