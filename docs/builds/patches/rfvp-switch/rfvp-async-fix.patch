+/* GalNX P22: independent watchdog thread.
+ *
+ * The v1.0.9 watchdog was called from inside the frame tick, so a frame thread that stopped never
+ * reached it. This thread is scheduled on its own and samples the frame counter written by the
+ * main loop: 3 s without a new frame writes watchdog_status.txt and a debug log line, 10 s more
+ * turns async off so the frame thread uses the synchronous path if it ever resumes. It never
+ * blocks the frame thread: it only reads volatile counters and writes a small SD file. */
+static void rfvp_watchdog_thread(void* arg) {
+    (void) arg;
+    g_rfvp_watchdog_alive = 1;
+    unsigned last_frame = 0;
+    u64 last_change_us = rfvp_switch_ticks_us();
+    int reported = 0;
+    for (;;) {
+        svcSleepThread(500000000ULL); /* 500 ms */
+        const u64 now = rfvp_switch_ticks_us();
+        const unsigned frame = g_rfvp_main_frame;
+        if (frame != last_frame) {
+            last_frame = frame;
+            last_change_us = now;
+            reported = 0;
+            continue;
+        }
+        if (!g_rfvp_async_enabled) continue;
+        const u64 stalled_us = now - last_change_us;
+        if (stalled_us < 3000000ULL) continue; /* 3 s without a frame */
+        g_rfvp_watchdog_stalled = 1;
+        write_watchdog_status(frame, (int) (stalled_us / 1000));
+        if (!reported) {
+            reported = 1;
+            char message[128];
+            int len = snprintf(message, sizeof(message),
+                               "rfvp: watchdog stall frame=%u stage=%d hb=%u\n", frame,
+                               g_rfvp_async_stage, g_rfvp_async_heartbeat);
+            rfvp_switch_log(message, (size_t) len);
+        }
+        if (stalled_us >= 10000000ULL) {
+            /* If the frame thread resumes it now takes the synchronous path; the report stays. */
+            g_rfvp_async_enabled = 0;
+            write_watchdog_status(frame, (int) (stalled_us / 1000));
+        }
+    }
+}
