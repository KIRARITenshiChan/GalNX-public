+/* GalNX P22: start the decode worker on core 1.
+ *
+ * v1.0.8/v1.0.9 created it with cpuid -2 (the process default ideal core, i.e. core 0, the same
+ * core the frame thread runs on) and prio 0x30 under the frame thread's 0x2C. The P21 RCA proved
+ * the resulting inversion: the worker held the pack lock across a blocking SD read, the frame
+ * thread spun on that lock in user space, and Horizon's same-core strict priority scheduling never
+ * let the lower-priority worker run again. The kernel mutex in vfs.rs is the actual fix; core 1
+ * removes the coupling completely. If a specific core is refused (applet mode, emulator) fall back
+ * to the default core - with the kernel mutex that stays safe, it only loses the parallelism. */
+static void start_decode_worker(void) {
+    static const int cpus[] = { 1, -2 };
+    Result rc = 0;
+    for (unsigned i = 0; i < sizeof(cpus) / sizeof(cpus[0]); ++i) {
+        rc = threadCreate(&g_rfvp_decode_thread, rfvp_decode_thread, NULL, NULL, 0x100000, 0x30,
+                          cpus[i]);
+        if (R_FAILED(rc)) continue;
+        g_rfvp_async_cpu = cpus[i];
+        g_rfvp_async_create_rc = rc;
+        g_rfvp_async_start_rc = threadStart(&g_rfvp_decode_thread);
+        if (R_FAILED(g_rfvp_async_start_rc)) g_rfvp_async_enabled = 0;
+        return;
+    }
+    g_rfvp_async_create_rc = rc;
+    g_rfvp_async_enabled = 0;
