+
+fn pixel_format_code(format: PixelFormat) -> c_int {
+    match format {
+        PixelFormat::Rgba8 => 0,
+        PixelFormat::Bgra8 => 1,
+        PixelFormat::Rgb8 => 2,
+        PixelFormat::Luma8 => 3,
+        PixelFormat::LumaA8 => 4,
+        PixelFormat::Alpha8 => 5,
+        #[allow(unreachable_patterns)]
+        _ => 0,
+    }
+}
+
+fn blend_mode_code(blend: BlendMode) -> c_int {
+    match blend {
+        BlendMode::Opaque => 0,
+        BlendMode::Alpha => 1,
+        BlendMode::Add => 2,
+        BlendMode::Multiply => 3,
+        BlendMode::Screen => 4,
+    }
+}
+
+fn filter_code(filter: TextureFilter) -> c_int {
+    match filter {
+        TextureFilter::Nearest => 0,
+        TextureFilter::Linear => 1,
+    }
+}
+
+/// A colour as the shim packs it: R in the low byte, then G, B and A.
+fn pack_color(color: ColorRgba) -> c_uint {
+    let channel = |value: f32| -> c_uint {
+        let scaled = value * 255.0;
+        let rounded = if scaled <= 0.0 {
+            0.0
+        } else if scaled >= 255.0 {
+            255.0
+        } else {
+            scaled + 0.5
+        };
+        rounded as c_uint
+    };
+    channel(color.r) | (channel(color.g) << 8) | (channel(color.b) << 16) | (channel(color.a) << 24)
+}
