+/// Pointer and exit-confirmation state for the runtime's own overlay (cursor + dialog).
+#[no_mangle]
+pub unsafe extern "C" fn rfvp_switch_pointer(
+    session: *mut Session,
+    x: *mut c_int,
+    y: *mut c_int,
+    visible: *mut c_int,
+    dialog: *mut c_int,
+) {
+    if session.is_null() {
+        return;
+    }
+    let session = unsafe { &*session };
+    let (px, py, shown) = session.app.pointer_state();
+    if !x.is_null() {
+        unsafe { *x = px };
+    }
+    if !y.is_null() {
+        unsafe { *y = py };
+    }
+    if !visible.is_null() {
+        unsafe { *visible = if shown { 1 } else { 0 } };
+    }
+    if !dialog.is_null() {
+        unsafe { *dialog = if session.app.quit_dialog_open() { 1 } else { 0 } };
+    }
+}
+
+/// One line of input state for the on-device trace, or `None` when the session is gone.
+#[no_mangle]
+pub unsafe extern "C" fn rfvp_switch_input_debug(
+    session: *mut Session,
+    cursor_x: *mut c_int,
+    cursor_y: *mut c_int,
+    macro_stage: *mut c_int,
+    pointer_seen: *mut c_int,
+    buttons: *mut u64,
+    quit_dialog: *mut c_int,
+) {
+    if session.is_null() {
+        return;
+    }
+    let session = unsafe { &*session };
+    let (x, y, stage, seen, held, dialog) = session.app.input_debug_line();
+    if !cursor_x.is_null() {
+        unsafe { *cursor_x = x };
+    }
+    if !cursor_y.is_null() {
+        unsafe { *cursor_y = y };
+    }
+    if !macro_stage.is_null() {
+        unsafe { *macro_stage = stage };
+    }
+    if !pointer_seen.is_null() {
+        unsafe { *pointer_seen = seen };
+    }
+    if !buttons.is_null() {
+        unsafe { *buttons = held };
+    }
+    if !quit_dialog.is_null() {
+        unsafe { *quit_dialog = dialog as c_int };
+    }
+}
