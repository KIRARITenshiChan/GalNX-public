-static void apply_clip(int scissor_valid, int sx, int sy, int sw, int sh) {
-    SDL_Rect clip;
-    base_clip(&clip);
-    if (scissor_valid) {
-        SDL_Rect extra;
-        int x0, y0, x1, y1;
-        extra.x = (int) (map_offset_x + (float) sx * map_scale + 0.5f);
-        extra.y = (int) (map_offset_y + (float) sy * map_scale + 0.5f);
-        extra.w = (int) ((float) sw * map_scale + 0.5f);
-        extra.h = (int) ((float) sh * map_scale + 0.5f);
-        x0 = clip.x > extra.x ? clip.x : extra.x;
-        y0 = clip.y > extra.y ? clip.y : extra.y;
-        x1 = (clip.x + clip.w) < (extra.x + extra.w) ? (clip.x + clip.w) : (extra.x + extra.w);
-        y1 = (clip.y + clip.h) < (extra.y + extra.h) ? (clip.y + clip.h) : (extra.y + extra.h);
-        clip.x = x0;
-        clip.y = y0;
-        clip.w = x1 - x0;
-        clip.h = y1 - y0;
-        if (clip.w < 0) clip.w = 0;
-        if (clip.h < 0) clip.h = 0;
-    }
-    SDL_RenderSetClipRect(renderer, &clip);
-}
