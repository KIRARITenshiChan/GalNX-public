+//! Controller and touch input, as the runtime reads it each frame, turned into engine events.
+//!
+//! Layout requested for the GalNX IROSEKA pilot (see docs/builds/019-rfvp-input-mapping.md):
+//! A = Enter, B = Esc (the in-game pause menu), X = auto mode, Y = load, Plus = save,
+//! Minus = exit, ZR = left mouse button, ZL = right mouse button, R = Ctrl (skip while held),
+//! D-pad = arrow keys, left stick up/down = mouse wheel (text backlog), right stick = pointer.
+//!
+//! X/Y/Plus/Minus are implemented as short synthetic click macros into the game's own pause
+//! menu, so the game keeps owning save/load/exit confirmation UI.
+//!
+//! Touch keeps its own path: a finger always drives the pointer and the left button.
+
+use alloc::vec::Vec;
+
+use rfvp::host_api::{InputModifiers, KeyCode, PointerButton, RfvpEvent};
+
+const SCREEN_WIDTH: i32 = 1280;
+const SCREEN_HEIGHT: i32 = 720;
+const STICK_DEADZONE: i32 = 8_000;
+/// Right stick deflection to pointer pixels: full tilt is about 11 px per poll (660 px/s).
+const POINTER_DIVISOR: i32 = 3_000;
+const WHEEL_STEP: i32 = 120;
+/// Polls between wheel events while the left stick is held: about ten lines a second at 60 Hz.
+const WHEEL_REPEAT_POLLS: u32 = 6;
+
+/// Pause-menu anchor points in 1280x720 game coordinates. The menu is the clock face shown by
+/// Esc; every entry is a mouse target, so the macros park the pointer on one and click it.
+const MENU_SAVE: (i32, i32) = (1117, 171);
+const MENU_LOAD: (i32, i32) = (960, 217);
+const MENU_EXIT: (i32, i32) = (654, 608);
+
+/// Message-window toolbar AUTO button (bottom-right diamond row), in 1280x720 game coordinates.
+const TOOLBAR_AUTO: (i32, i32) = (1079, 700);
+
+/// Confirm button of the 「确定退出游戏？」 dialog, in 1280x720 game coordinates.
+const EXIT_CONFIRM: (i32, i32) = (560, 379);
+
+/// A synthetic pause-menu macro, run one stage per poll: Esc opens the menu, the pointer then
+/// parks on an entry and clicks it, so the game keeps owning its save/load/exit screens.
+struct MenuMacro {
+    x: i32,
+    y: i32,
+    stage: u8,
+    waits: u8,
+    /// True when the macro must open the pause menu first; false for a plain toolbar click.
+    open_menu: bool,
+    /// Optional second left-click (e.g. the confirm button of the exit dialog).
+    click2: Option<(i32, i32)>,
+}
+
+/// `struct RfvpSwitchInput` in main.c.
+#[repr(C)]
+pub struct SwitchInput {
+    /// libnx `HidNpadButton` bits.
+    pub buttons: u64,
+    pub stick_x: i32,
+    pub stick_y: i32,
+    pub right_stick_x: i32,
+    pub right_stick_y: i32,
+    pub touch_count: u32,
+    pub touch_id: u32,
+    pub touch_x: i32,
+    pub touch_y: i32,
+}
+
+// libnx `HidNpadButton`.
+const A: u64 = 1 << 0;
+const B: u64 = 1 << 1;
+const X: u64 = 1 << 2;
+const Y: u64 = 1 << 3;
+#[allow(dead_code)]
+const L: u64 = 1 << 6; // reserved; the requested mapping table leaves L unused
+const R: u64 = 1 << 7;
+const ZL: u64 = 1 << 8;
+const ZR: u64 = 1 << 9;
+const PLUS: u64 = 1 << 10;
+const MINUS: u64 = 1 << 11;
+const LEFT: u64 = 1 << 12;
+const UP: u64 = 1 << 13;
+const RIGHT: u64 = 1 << 14;
+const DOWN: u64 = 1 << 15;
+
+/// D-pad -> arrow keys.
+const DIRECTIONS: [(u64, KeyCode); 4] = [
+    (UP, KeyCode::Up),
+    (DOWN, KeyCode::Down),
+    (LEFT, KeyCode::Left),
+    (RIGHT, KeyCode::Right),
+];
+
+/// A/B -> the game's confirm/back keys (skipped while the console confirmation is up).
+const ACTIONS: [(u64, KeyCode); 2] = [(A, KeyCode::Return), (B, KeyCode::Escape)];
+
+pub struct HorizonInput {
+    cursor_x: i32,
+    cursor_y: i32,
+    previous_buttons: u64,
+    wheel_polls: u32,
+    pending: Option<MenuMacro>,
+    /// Set once the right stick has moved the pointer, so the overlay cursor only appears after
+    /// the player actually used it.
+    pointer_seen: bool,
+    /// The console's own exit confirmation is up: A confirms, B cancels, the game sees neither.
+    quit_dialog: bool,
+    quit_confirmed: bool,
+    touch_active: bool,
+    touch_id: u64,
+    touch_x: i32,
+    touch_y: i32,
+}
+
+impl HorizonInput {
+    pub fn new() -> Self {
+        Self {
+            cursor_x: SCREEN_WIDTH / 2,
+            cursor_y: SCREEN_HEIGHT / 2,
+            previous_buttons: 0,
+            wheel_polls: 0,
+            pending: None,
+            pointer_seen: false,
+            quit_dialog: false,
+            quit_confirmed: false,
+            touch_active: false,
+            touch_id: 0,
+            touch_x: 0,
+            touch_y: 0,
+        }
+    }
+
+    pub fn poll(&mut self, input: &SwitchInput, out: &mut Vec<RfvpEvent>) {
+        let buttons = input.buttons;
+        let down = !self.previous_buttons & buttons;
+        let up = self.previous_buttons & !buttons;
+        let held_before = self.previous_buttons;
+        self.previous_buttons = buttons;
+
+        // R is the skip key: held down it reports Ctrl, exactly like the keyboard binding.
+        let skip = R & buttons;
+        let skip_before = R & held_before;
+        if skip != 0 && skip_before == 0 {
+            self.key_down(KeyCode::Control, out);
+        } else if skip == 0 && skip_before != 0 {
+            self.key_up(KeyCode::Control, out);
+        }
+
+            // The console's own exit confirmation owns A and B while it is up, so the game never sees
+        // those two presses in that state.
+        let confirming = self.quit_dialog;
+        for (mask, key) in DIRECTIONS {
+            let was = held_before & mask != 0;
+            let is = buttons & mask != 0;
+            if is && !was {
+                self.key_down(key, out);
+            } else if was && !is {
+                self.key_up(key, out);
+            }
+        }
+        if !confirming {
+            for (mask, key) in ACTIONS {
+                let was = held_before & mask != 0;
+                let is = buttons & mask != 0;
+                if is && !was {
+                    self.key_down(key, out);
+                } else if was && !is {
+                    self.key_up(key, out);
+                }
+            }
+        }
+
+        // X/Y/Plus queue one game-UI click each; Minus opens the console's escape hatch.
+        // The game's own pause menu is only reachable from some screens (never the title), so
+        // leaving is handled by the console itself: confirm, save, quit.
+        if down & X != 0 {
+            self.queue_pointer_click(TOOLBAR_AUTO.0, TOOLBAR_AUTO.1);
+        }
+        if down & Y != 0 {
+            self.queue_menu_click(MENU_LOAD.0, MENU_LOAD.1);
+        }
+        if down & PLUS != 0 {
+            self.queue_menu_click(MENU_SAVE.0, MENU_SAVE.1);
+        }
+        if confirming {
+            if down & A != 0 {
+                self.quit_dialog = false;
+                self.quit_confirmed = true;
+            } else if down & B != 0 {
+                self.quit_dialog = false;
+            }
+        } else if down & MINUS != 0 {
+            self.quit_dialog = true;
+        }
+
+        self.move_pointer(input.right_stick_x, input.right_stick_y, out);
+        self.scroll(input.stick_y, out);
+        self.click_buttons(down, up, out);
+        self.run_macro(out);
+        self.update_touch(input, out);
+    }
+
+    fn key_down(&self, key: KeyCode, out: &mut Vec<RfvpEvent>) {
+        out.push(RfvpEvent::KeyDown {
+            key,
+            repeat: false,
+            modifiers: InputModifiers::empty(),
+        });
+    }
+
+    fn key_up(&self, key: KeyCode, out: &mut Vec<RfvpEvent>) {
+        out.push(RfvpEvent::KeyUp {
+            key,
+            modifiers: InputModifiers::empty(),
+        });
+    }
+
+    fn pointer_move(&mut self, out: &mut Vec<RfvpEvent>) {
+        self.pointer_seen = true;
+        out.push(RfvpEvent::PointerMove {
+            x: self.cursor_x,
+            y: self.cursor_y,
+            in_screen: true,
+        });
+    }
+
+    /// Queue a pause-menu macro; ignored while another macro is still running.
+    fn queue_menu_click(&mut self, x: i32, y: i32) {
+        self.queue_click(x, y, true, None);
+    }
+
+    /// Queue a pause-menu macro followed by a confirmation click (exit dialog).
+    fn queue_menu_click_then(&mut self, x: i32, y: i32, cx: i32, cy: i32) {
+        self.queue_click(x, y, true, Some((cx, cy)));
+    }
+
+    /// Queue a plain left-click at a game-UI coordinate (no pause menu involved).
+    fn queue_pointer_click(&mut self, x: i32, y: i32) {
+        self.queue_click(x, y, false, None);
+    }
+
+    fn queue_click(&mut self, x: i32, y: i32, open_menu: bool, click2: Option<(i32, i32)>) {
+        if self.pending.is_none() {
+            self.pending = Some(MenuMacro {
+                x,
+                y,
+                stage: 0,
+                waits: 0,
+                open_menu,
+                click2,
+            });
+        }
+    }
+
+    fn run_macro(&mut self, out: &mut Vec<RfvpEvent>) {
+        // Copy the macro state out before calling &self helpers: holding a &mut borrow of
+        // self.pending across self.key_down()/pointer_move() does not borrow-check.
+        let Some((stage, x, y, waits, open_menu, click2)) = self
+            .pending
+            .as_ref()
+            .map(|m| (m.stage, m.x, m.y, m.waits, m.open_menu, m.click2))
+        else {
+            return;
+        };
+        if waits > 0 {
+            if let Some(m) = self.pending.as_mut() {
+                m.waits = waits - 1;
+            }
+            return;
+        }
+        let mut next_stage = stage + 1;
+        let mut next_waits = 0;
+        let mut done = false;
+        // Second click target for stages 5..=7; only used when a follow-up click is configured.
+        let (x2, y2) = click2.unwrap_or((x, y));
+        match stage {
+            // Open the pause menu; its fade needs a moment before the entries are clickable.
+            0 => {
+                if open_menu {
+                    self.key_down(KeyCode::Escape, out);
+                } else {
+                    self.cursor_x = x;
+                    self.cursor_y = y;
+                    self.pointer_move(out);
+                    next_waits = 3;
+                    next_stage = 2;
+                }
+            }
+            1 => {
+                self.key_up(KeyCode::Escape, out);
+                // The pause menu fades in; clicking before it settles is swallowed by the UI.
+                next_waits = 90;
+                next_stage = 2;
+            }
+            // Park the pointer on the target, then press and release the left button.
+            2 => {
+                self.cursor_x = x;
+                self.cursor_y = y;
+                self.pointer_move(out);
+                next_waits = 3;
+            }
+            3 => {
+                out.push(RfvpEvent::PointerDown {
+                    button: PointerButton::Left,
+                    x: self.cursor_x,
+                    y: self.cursor_y,
+                });
+                next_waits = 3;
+            }
+            4 => {
+                out.push(RfvpEvent::PointerUp {
+                    button: PointerButton::Left,
+                    x: self.cursor_x,
+                    y: self.cursor_y,
+                });
+                if click2.is_some() {
+                    // Let the game's confirmation dialog appear before hitting its OK button.
+                    next_waits = 30;
+                } else {
+                    done = true;
+                }
+            }
+            // Optional follow-up click (game exit confirmation).
+            5 => {
+                self.cursor_x = x2;
+                self.cursor_y = y2;
+                self.pointer_move(out);
+                next_waits = 3;
+            }
+            6 => {
+                out.push(RfvpEvent::PointerDown {
+                    button: PointerButton::Left,
+                    x: self.cursor_x,
+                    y: self.cursor_y,
+                });
+                next_waits = 3;
+            }
+            7 => {
+                out.push(RfvpEvent::PointerUp {
+                    button: PointerButton::Left,
+                    x: self.cursor_x,
+                    y: self.cursor_y,
+                });
+                done = true;
+            }
+            _ => done = true,
+        }
+        if done {
+            self.pending = None;
+        } else if let Some(m) = self.pending.as_mut() {
+            m.stage = next_stage;
+            m.waits = next_waits;
+        }
+    }
+
+    fn move_pointer(&mut self, stick_x: i32, stick_y: i32, out: &mut Vec<RfvpEvent>) {
+        let mut dx = 0;
+        let mut dy = 0;
+        if stick_x.abs() >= STICK_DEADZONE {
+            dx += stick_x / POINTER_DIVISOR;
+        }
+        if stick_y.abs() >= STICK_DEADZONE {
+            dy -= stick_y / POINTER_DIVISOR;
+        }
+        if dx != 0 || dy != 0 {
+            self.cursor_x = (self.cursor_x + dx).clamp(0, SCREEN_WIDTH - 1);
+            self.cursor_y = (self.cursor_y + dy).clamp(0, SCREEN_HEIGHT - 1);
+            self.pointer_move(out);
+        }
+    }
+
+    /// Left stick up scrolls back through the text (mouse wheel up), down goes forward.
+    fn scroll(&mut self, stick_y: i32, out: &mut Vec<RfvpEvent>) {
+        if stick_y.abs() < STICK_DEADZONE {
+            self.wheel_polls = 0;
+            return;
+        }
+        self.wheel_polls = self.wheel_polls.wrapping_add(1);
+        // The first poll fires at once so a short stick tap scrolls one line; holding then
+        // repeats at the regular rate.
+        if self.wheel_polls != 1 && self.wheel_polls % WHEEL_REPEAT_POLLS != 0 {
+            return;
+        }
+        let delta_y = if stick_y > 0 { WHEEL_STEP } else { -WHEEL_STEP };
+        out.push(RfvpEvent::Wheel {
+            delta_x: 0,
+            delta_y,
+        });
+    }
+
+    fn click_buttons(&self, down: u64, up: u64, out: &mut Vec<RfvpEvent>) {
+        let (x, y) = (self.cursor_x, self.cursor_y);
+        for (mask, button) in [(ZR, PointerButton::Left), (ZL, PointerButton::Right)] {
+            if down & mask != 0 {
+                out.push(RfvpEvent::PointerDown { button, x, y });
+            }
+            if up & mask != 0 {
+                out.push(RfvpEvent::PointerUp { button, x, y });
+            }
+        }
+    }
+
+    /// Pointer position for the overlay cursor, and whether it should be drawn at all.
+    pub fn pointer(&self) -> (i32, i32, bool) {
+        (
+            self.cursor_x,
+            self.cursor_y,
+            self.pointer_seen || self.touch_active,
+        )
+    }
+
+    /// Whether the console's own exit confirmation is on screen.
+    pub fn quit_dialog_open(&self) -> bool {
+        self.quit_dialog
+    }
+
+    /// Take the "player confirmed the exit" edge, if there is one.
+    pub fn take_quit_confirmed(&mut self) -> bool {
+        let confirmed = self.quit_confirmed;
+        self.quit_confirmed = false;
+        confirmed
+    }
+
+    /// One line of input state for the on-device trace file.
+    pub fn debug_line(&self) -> (i32, i32, i32, i32, u64, u8) {
+        (
+            self.cursor_x,
+            self.cursor_y,
+            self.pending.as_ref().map_or(-1, |m| m.stage as i32),
+            if self.pointer_seen { 1 } else { 0 },
+            self.previous_buttons,
+            if self.quit_dialog { 1 } else { 0 },
+        )
+    }
+
+    fn update_touch(&mut self, input: &SwitchInput, out: &mut Vec<RfvpEvent>) {
+        if input.touch_count == 0 {
+            if self.touch_active {
+                let (id, x, y) = (self.touch_id, self.touch_x, self.touch_y);
+                out.push(RfvpEvent::TouchUp { id, x, y });
+                out.push(RfvpEvent::PointerUp {
+                    button: PointerButton::Left,
+                    x,
+                    y,
+                });
+                self.touch_active = false;
+            }
+            return;
+        }
+
+        let id = input.touch_id as u64;
+        let x = input.touch_x.clamp(0, SCREEN_WIDTH - 1);
+        let y = input.touch_y.clamp(0, SCREEN_HEIGHT - 1);
+        self.cursor_x = x;
+        self.cursor_y = y;
+        self.pointer_move(out);
+        if !self.touch_active || self.touch_id != id {
+            self.touch_active = true;
+            self.touch_id = id;
+            self.touch_x = x;
+            self.touch_y = y;
+            out.push(RfvpEvent::TouchDown { id, x, y });
+            out.push(RfvpEvent::PointerDown {
+                button: PointerButton::Left,
+                x,
+                y,
+            });
+        } else if self.touch_x != x || self.touch_y != y {
+            self.touch_x = x;
+            self.touch_y = y;
+            out.push(RfvpEvent::TouchMove { id, x, y });
+        }
+    }
+}
