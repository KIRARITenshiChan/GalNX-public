-            for (i = 0; i < pixels; ++i) {
-                dst[i * 4 + 0] = src[i * 4 + 2];
-                dst[i * 4 + 1] = src[i * 4 + 1];
-                dst[i * 4 + 2] = src[i * 4 + 0];
-                dst[i * 4 + 3] = src[i * 4 + 3];
-            }
-            return;
-        case FormatRgb8:
-            for (i = 0; i < pixels; ++i) {
-                dst[i * 4 + 0] = src[i * 3 + 0];
-                dst[i * 4 + 1] = src[i * 3 + 1];
-                dst[i * 4 + 2] = src[i * 3 + 2];
-                dst[i * 4 + 3] = 255;
-            }
-            return;
-        case FormatLuma8:
-            for (i = 0; i < pixels; ++i) {
-                dst[i * 4 + 0] = src[i];
-                dst[i * 4 + 1] = src[i];
-                dst[i * 4 + 2] = src[i];
-                dst[i * 4 + 3] = 255;
-            }
-            return;
-        case FormatLumaA8:
-            for (i = 0; i < pixels; ++i) {
-                dst[i * 4 + 0] = src[i * 2];
-                dst[i * 4 + 1] = src[i * 2];
-                dst[i * 4 + 2] = src[i * 2];
-                dst[i * 4 + 3] = src[i * 2 + 1];
-            }
-            return;
-        case FormatAlpha8:
-            for (i = 0; i < pixels; ++i) {
-                dst[i * 4 + 0] = 255;
-                dst[i * 4 + 1] = 255;
-                dst[i * 4 + 2] = 255;
-                dst[i * 4 + 3] = src[i];
-            }
-            return;
-        default:
-            memcpy(dst, src, (size_t) pixels * 4);
-            return;
-    }
-}
