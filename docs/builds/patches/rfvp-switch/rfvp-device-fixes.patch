+/* SDL2 (OpenGL ES2) video backend for the rfvp Switch port.
+ *
+ * The engine (Rust) renders game frames as 2D quads and solid rectangles through this shim.
+ * The previous backend was a CPU soft rasterizer that alone cost ~38 ms of a 39 ms frame;
+ * SDL2 hands the same work to the Tegra GPU.
+ *
+ * Coordinates handed in by the engine are virtual (script) coordinates; this shim scales and
+ * letterboxes them onto the 1280x720 display, mirroring the old soft rasterizer mapping.
+ */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <SDL.h>
+
+#define OUT_WIDTH 1280
+#define OUT_HEIGHT 720
+
+/* Engine PixelFormat codes (crates/rfvp/src/host_api/render.rs). */
+enum {
+    FormatRgba8 = 0,
+    FormatBgra8 = 1,
+    FormatRgb8 = 2,
+    FormatLuma8 = 3,
+    FormatLumaA8 = 4,
+    FormatAlpha8 = 5,
+};
+
+/* Engine BlendMode codes. */
+enum {
+    BlendOpaque = 0,
+    BlendAlpha = 1,
+    BlendAdd = 2,
+    BlendMultiply = 3,
+    BlendScreen = 4,
+};
+
+enum { MaxTextures = 4096 };
+
+typedef struct {
+    int id;
+    SDL_Texture* texture;
+    int width;
+    int height;
+} TextureEntry;
+
+static SDL_Window* window;
+static SDL_Renderer* renderer;
+static TextureEntry textures[MaxTextures];
+static int texture_count;
+static int ready;
+static int virtual_width = 1920;
+static int virtual_height = 1080;
+static float map_scale = 1.0f;
+static float map_offset_x;
+static float map_offset_y;
+
+static int format_bytes(int format) {
+    switch (format) {
+        case FormatRgba8:
+        case FormatBgra8: return 4;
+        case FormatRgb8: return 3;
+        case FormatLuma8:
+        case FormatAlpha8: return 1;
+        case FormatLumaA8: return 2;
+        default: return 4;
+    }
+}
+
+/* Convert pixels of the engine format to RGBA bytes (R, G, B, A). */
+static void convert_to_rgba(const uint8_t* src, int format, int pixels, uint8_t* dst) {
+    int i;
+    switch (format) {
+        case FormatRgba8:
+            memcpy(dst, src, (size_t) pixels * 4);
+            return;
+        case FormatBgra8:
+            for (i = 0; i < pixels; ++i) {
+                dst[i * 4 + 0] = src[i * 4 + 2];
+                dst[i * 4 + 1] = src[i * 4 + 1];
+                dst[i * 4 + 2] = src[i * 4 + 0];
+                dst[i * 4 + 3] = src[i * 4 + 3];
+            }
+            return;
+        case FormatRgb8:
+            for (i = 0; i < pixels; ++i) {
+                dst[i * 4 + 0] = src[i * 3 + 0];
+                dst[i * 4 + 1] = src[i * 3 + 1];
+                dst[i * 4 + 2] = src[i * 3 + 2];
+                dst[i * 4 + 3] = 255;
+            }
+            return;
+        case FormatLuma8:
+            for (i = 0; i < pixels; ++i) {
+                dst[i * 4 + 0] = src[i];
+                dst[i * 4 + 1] = src[i];
+                dst[i * 4 + 2] = src[i];
+                dst[i * 4 + 3] = 255;
+            }
+            return;
+        case FormatLumaA8:
+            for (i = 0; i < pixels; ++i) {
+                dst[i * 4 + 0] = src[i * 2];
+                dst[i * 4 + 1] = src[i * 2];
+                dst[i * 4 + 2] = src[i * 2];
+                dst[i * 4 + 3] = src[i * 2 + 1];
+            }
+            return;
+        case FormatAlpha8:
+            for (i = 0; i < pixels; ++i) {
+                dst[i * 4 + 0] = 255;
+                dst[i * 4 + 1] = 255;
+                dst[i * 4 + 2] = 255;
+                dst[i * 4 + 3] = src[i];
+            }
+            return;
+        default:
+            memcpy(dst, src, (size_t) pixels * 4);
+            return;
+    }
+}
+
+static void galnx_log(const char* fmt, ...) {
+    extern void rfvp_switch_log(const char* message, unsigned long length);
+    char line[320];
+    va_list ap;
+    int len;
+    va_start(ap, fmt);
+    len = vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    if (len > 0) rfvp_switch_log(line, (unsigned long) len);
+}
+
+static TextureEntry* find_texture(unsigned id) {
+    int i;
+    for (i = 0; i < texture_count; ++i) {
+        if (textures[i].id == (int) id) return &textures[i];
+    }
+    return NULL;
+}
+
+static void update_mapping(int vw, int vh) {
+    float sx, sy;
+    if (vw <= 0 || vh <= 0) return;
+    virtual_width = vw;
+    virtual_height = vh;
+    sx = (float) OUT_WIDTH / (float) vw;
+    sy = (float) OUT_HEIGHT / (float) vh;
+    map_scale = sx < sy ? sx : sy;
+    map_offset_x = ((float) OUT_WIDTH - (float) vw * map_scale) * 0.5f;
+    map_offset_y = ((float) OUT_HEIGHT - (float) vh * map_scale) * 0.5f;
+}
+
+static void base_clip(SDL_Rect* out) {
+    out->x = (int) (map_offset_x + 0.5f);
+    out->y = (int) (map_offset_y + 0.5f);
+    out->w = (int) ((float) virtual_width * map_scale + 0.5f);
+    out->h = (int) ((float) virtual_height * map_scale + 0.5f);
+}
+
+static SDL_BlendMode blend_mode(int blend) {
+    switch (blend) {
+        case BlendOpaque: return SDL_BLENDMODE_NONE;
+        case BlendAdd: return SDL_BLENDMODE_ADD;
+        case BlendMultiply:
+            return SDL_ComposeCustomBlendMode(SDL_BLENDFACTOR_DST_COLOR, SDL_BLENDFACTOR_ZERO,
+                                              SDL_BLENDOPERATION_ADD, SDL_BLENDFACTOR_ZERO,
+                                              SDL_BLENDFACTOR_ONE, SDL_BLENDOPERATION_ADD);
+        case BlendScreen:
+            return SDL_ComposeCustomBlendMode(SDL_BLENDFACTOR_ONE,
+                                              SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR,
+                                              SDL_BLENDOPERATION_ADD, SDL_BLENDFACTOR_ONE,
+                                              SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
+                                              SDL_BLENDOPERATION_ADD);
+        case BlendAlpha:
+        default: return SDL_BLENDMODE_BLEND;
+    }
+}
+
+static void apply_clip(int scissor_valid, int sx, int sy, int sw, int sh) {
+    SDL_Rect clip;
+    base_clip(&clip);
+    if (scissor_valid) {
+        SDL_Rect extra;
+        int x0, y0, x1, y1;
+        extra.x = (int) (map_offset_x + (float) sx * map_scale + 0.5f);
+        extra.y = (int) (map_offset_y + (float) sy * map_scale + 0.5f);
+        extra.w = (int) ((float) sw * map_scale + 0.5f);
+        extra.h = (int) ((float) sh * map_scale + 0.5f);
+        x0 = clip.x > extra.x ? clip.x : extra.x;
+        y0 = clip.y > extra.y ? clip.y : extra.y;
+        x1 = (clip.x + clip.w) < (extra.x + extra.w) ? (clip.x + clip.w) : (extra.x + extra.w);
+        y1 = (clip.y + clip.h) < (extra.y + extra.h) ? (clip.y + clip.h) : (extra.y + extra.h);
+        clip.x = x0;
+        clip.y = y0;
+        clip.w = x1 - x0;
+        clip.h = y1 - y0;
+        if (clip.w < 0) clip.w = 0;
+        if (clip.h < 0) clip.h = 0;
+    }
+    SDL_RenderSetClipRect(renderer, &clip);
+}
+
+int galnx_sdl_video_init(void) {
+    SDL_RendererInfo info;
+    if (ready) return 0;
+    if (SDL_Init(SDL_INIT_VIDEO) != 0) return -1;
+    window = SDL_CreateWindow("rfvp", 0, 0, OUT_WIDTH, OUT_HEIGHT, SDL_WINDOW_FULLSCREEN);
+    if (window == NULL) return -2;
+    renderer = SDL_CreateRenderer(window, 0, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
+    if (renderer == NULL) return -3;
+    if (SDL_GetRendererInfo(renderer, &info) == 0 && info.name != NULL) {
+        galnx_log("rfvp: sdl video renderer: %s", info.name);
+    }
+    ready = 1;
+    return 0;
+}
+
+void galnx_sdl_video_shutdown(void) {
+    int i;
+    if (!ready) return;
+    for (i = 0; i < texture_count; ++i) {
+        if (textures[i].texture != NULL) SDL_DestroyTexture(textures[i].texture);
+    }
+    texture_count = 0;
+    if (renderer != NULL) SDL_DestroyRenderer(renderer);
+    if (window != NULL) SDL_DestroyWindow(window);
+    renderer = NULL;
+    window = NULL;
+    SDL_Quit();
+    ready = 0;
+}
+
+/* Scratch buffer for format conversion; grown on demand so steady-state frames do not malloc. */
+static uint8_t* scratch;
+static size_t scratch_bytes;
+
+static uint8_t* scratch_reserve(size_t bytes) {
+    uint8_t* grown;
+    if (bytes <= scratch_bytes) return scratch;
+    grown = (uint8_t*) realloc(scratch, bytes);
+    if (grown == NULL) return NULL;
+    scratch = grown;
+    scratch_bytes = bytes;
+    return scratch;
+}
+
+int galnx_sdl_texture_create(unsigned id, int width, int height, int format,
+                             const unsigned char* pixels, long length) {
+    TextureEntry* entry;
+    SDL_Texture* texture;
+    int reused = 0;
+    int bpp = format_bytes(format);
+    if (!ready || width <= 0 || height <= 0) return -1;
+    if (pixels != NULL && length < (long) width * height * bpp) pixels = NULL;
+    entry = find_texture(id);
+    if (entry == NULL && texture_count >= MaxTextures) return -2;
+    /* The engine recreates a graph texture every time its content changes, with the same id and
+     * size. Reusing the SDL texture keeps the GL object alive instead of a destroy/create pair
+     * per upload, which is the hot path while text and animations redraw. */
+    if (entry != NULL && entry->texture != NULL && entry->width == width &&
+        entry->height == height) {
+        texture = entry->texture;
+        reused = 1;
+    } else {
+        texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888,
+                                    SDL_TEXTUREACCESS_STREAMING, width, height);
+        if (texture == NULL) return -4;
+        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_BLEND);
+        SDL_SetTextureScaleMode(texture, SDL_ScaleModeLinear);
+    }
+    if (pixels != NULL && format == FormatRgba8) {
+        if (SDL_UpdateTexture(texture, NULL, pixels, width * 4) != 0) {
+            if (!reused) SDL_DestroyTexture(texture);
+            return -6;
+        }
+    } else {
+        uint8_t* rgba = scratch_reserve((size_t) width * height * 4);
+        if (rgba == NULL) {
+            if (!reused) SDL_DestroyTexture(texture);
+            return -5;
+        }
+        if (pixels != NULL) {
+            convert_to_rgba(pixels, format, width * height, rgba);
+        } else {
+            /* No content yet: a fresh texture must start transparent, as the old code did. */
+            memset(rgba, 0, (size_t) width * height * 4);
+        }
+        if (SDL_UpdateTexture(texture, NULL, rgba, width * 4) != 0) {
+            if (!reused) SDL_DestroyTexture(texture);
+            return -6;
+        }
+    }
+    if (entry == NULL) {
+        entry = &textures[texture_count++];
+    } else if (entry->texture != texture) {
+        SDL_DestroyTexture(entry->texture);
+    }
+    entry->id = (int) id;
+    entry->texture = texture;
+    entry->width = width;
+    entry->height = height;
+    return 0;
+}
+
+int galnx_sdl_texture_update(unsigned id, int x, int y, int width, int height, int format,
+                             const unsigned char* pixels, long length) {
+    TextureEntry* entry = find_texture(id);
+    SDL_Rect rect;
+    int bpp = format_bytes(format);
+    if (entry == NULL || pixels == NULL || width <= 0 || height <= 0) return -1;
+    if (length < (long) width * height * bpp) return -2;
+    rect.x = x;
+    rect.y = y;
+    rect.w = width;
+    rect.h = height;
+    if (format == FormatRgba8) {
+        SDL_UpdateTexture(entry->texture, &rect, pixels, width * 4);
+        return 0;
+    }
+    {
+        uint8_t* rgba = scratch_reserve((size_t) width * height * 4);
+        if (rgba == NULL) return -3;
+        convert_to_rgba(pixels, format, width * height, rgba);
+        SDL_UpdateTexture(entry->texture, &rect, rgba, width * 4);
+    }
+    return 0;
+}
+
+void galnx_sdl_texture_destroy(unsigned id) {
+    int i;
+    for (i = 0; i < texture_count; ++i) {
+        if (textures[i].id == (int) id) {
+            SDL_DestroyTexture(textures[i].texture);
+            textures[i] = textures[texture_count - 1];
+            texture_count--;
+            return;
+        }
+    }
+}
+
+int galnx_sdl_begin(int vw, int vh, int clear_enabled, unsigned clear_rgba) {
+    SDL_Rect clip;
+    if (!ready) return -1;
+    update_mapping(vw, vh);
+    SDL_RenderSetClipRect(renderer, NULL);
+    if (clear_enabled) {
+        SDL_SetRenderDrawColor(renderer, (uint8_t) (clear_rgba & 0xff),
+                               (uint8_t) ((clear_rgba >> 8) & 0xff),
+                               (uint8_t) ((clear_rgba >> 16) & 0xff),
+                               (uint8_t) ((clear_rgba >> 24) & 0xff));
+        SDL_RenderClear(renderer);
+    }
+    base_clip(&clip);
+    SDL_RenderSetClipRect(renderer, &clip);
+    return 0;
+}
+
+int galnx_sdl_draw_quad(unsigned id, const float* xy, const float* uv, const unsigned* colors,
+                        int blend, int filter, int scissor_valid, int sx, int sy, int sw,
+                        int sh) {
+    TextureEntry* entry = find_texture(id);
+    SDL_Vertex vertices[4];
+    int indices[6];
+    int i;
+    if (!ready) return -1;
+    if (entry == NULL) return -1;
+    if (xy == NULL || uv == NULL || colors == NULL) return -1;
+    apply_clip(scissor_valid, sx, sy, sw, sh);
+    SDL_SetTextureScaleMode(entry->texture,
+                            filter == 0 ? SDL_ScaleModeNearest : SDL_ScaleModeLinear);
+    SDL_SetTextureBlendMode(entry->texture, blend_mode(blend));
+    for (i = 0; i < 4; ++i) {
+        unsigned c = colors[i];
+        vertices[i].position.x = map_offset_x + xy[i * 2 + 0] * map_scale;
+        vertices[i].position.y = map_offset_y + xy[i * 2 + 1] * map_scale;
+        vertices[i].tex_coord.x = uv[i * 2 + 0];
+        vertices[i].tex_coord.y = uv[i * 2 + 1];
+        vertices[i].color.r = (uint8_t) (c & 0xff);
+        vertices[i].color.g = (uint8_t) ((c >> 8) & 0xff);
+        vertices[i].color.b = (uint8_t) ((c >> 16) & 0xff);
+        vertices[i].color.a = (uint8_t) ((c >> 24) & 0xff);
+    }
+    indices[0] = 0;
+    indices[1] = 1;
+    indices[2] = 2;
+    indices[3] = 2;
+    indices[4] = 1;
+    indices[5] = 3;
+    SDL_RenderGeometry(renderer, entry->texture, vertices, 4, indices, 6);
+    return 0;
+}
+
+int galnx_sdl_draw_solid(int x, int y, int width, int height, unsigned rgba, int blend,
+                         int scissor_valid, int sx, int sy, int sw, int sh) {
+    SDL_Rect rect;
+    if (!ready) return -1;
+    apply_clip(scissor_valid, sx, sy, sw, sh);
+    rect.x = (int) (map_offset_x + (float) x * map_scale + 0.5f);
+    rect.y = (int) (map_offset_y + (float) y * map_scale + 0.5f);
+    rect.w = (int) ((float) width * map_scale + 0.5f);
+    rect.h = (int) ((float) height * map_scale + 0.5f);
+    SDL_SetRenderDrawBlendMode(renderer, blend_mode(blend));
+    SDL_SetRenderDrawColor(renderer, (uint8_t) (rgba & 0xff), (uint8_t) ((rgba >> 8) & 0xff),
+                           (uint8_t) ((rgba >> 16) & 0xff), (uint8_t) ((rgba >> 24) & 0xff));
+    SDL_RenderFillRect(renderer, &rect);
+    return 0;
+}
+
+
+/* ---- Console overlay -------------------------------------------------------------------------
+ * The GLES2 path has no vector cursor of its own (the engine only parks the OS pointer, and a
+ * console has none), and the game's exit UI is only reachable from some screens. So the console
+ * draws both: a small pointer so the player can see where the right stick is aiming, and its own
+ * confirmation so Minus can always leave the game. Everything here is drawn in game coordinates
+ * and mapped like the engine's own quads. */
+
+static int overlay_cursor_visible;
+static int overlay_cursor_x = 640;
+static int overlay_cursor_y = 360;
+static int overlay_dialog_open;
+
+void galnx_sdl_set_overlay(int cursor_visible, int x, int y, int dialog) {
+    overlay_cursor_visible = cursor_visible;
+    overlay_cursor_x = x;
+    overlay_cursor_y = y;
+    overlay_dialog_open = dialog;
+}
+
+static void overlay_fill(float x, float y, float w, float h, unsigned rgba) {
+    SDL_Vertex v[4];
+    int idx[6] = { 0, 1, 2, 2, 1, 3 };
+    float sx = map_offset_x + x * map_scale;
+    float sy = map_offset_y + y * map_scale;
+    float sw = w * map_scale;
+    float sh = h * map_scale;
+    SDL_Color c;
+    int i;
+    if (!ready) return;
+    c.r = (uint8_t) (rgba & 0xff);
+    c.g = (uint8_t) ((rgba >> 8) & 0xff);
+    c.b = (uint8_t) ((rgba >> 16) & 0xff);
+    c.a = (uint8_t) ((rgba >> 24) & 0xff);
+    for (i = 0; i < 4; ++i) {
+        v[i].position.x = sx + ((i == 1 || i == 3) ? sw : 0.0f);
+        v[i].position.y = sy + ((i >= 2) ? sh : 0.0f);
+        v[i].tex_coord.x = 0.0f;
+        v[i].tex_coord.y = 0.0f;
+        v[i].color = c;
+    }
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    SDL_RenderGeometry(renderer, NULL, v, 4, idx, 6);
+}
+
+/* The pointer is already in window pixels (the same space as the engine's in_screen pointer
+ * events), so this one is deliberately not mapped. */
+static void overlay_diamond(float cx, float cy, float r, unsigned rgba) {
+    SDL_Vertex v[4];
+    int idx[6] = { 0, 1, 2, 2, 1, 3 };
+    static const float dx[4] = { 0.0f, 1.0f, -1.0f, 0.0f };
+    static const float dy[4] = { -1.0f, 0.0f, 0.0f, 1.0f };
+    SDL_Color c;
+    int i;
+    if (!ready) return;
+    c.r = (uint8_t) (rgba & 0xff);
+    c.g = (uint8_t) ((rgba >> 8) & 0xff);
+    c.b = (uint8_t) ((rgba >> 16) & 0xff);
+    c.a = (uint8_t) ((rgba >> 24) & 0xff);
+    for (i = 0; i < 4; ++i) {
+        v[i].position.x = cx + dx[i] * r;
+        v[i].position.y = cy + dy[i] * r;
+        v[i].tex_coord.x = 0.0f;
+        v[i].tex_coord.y = 0.0f;
+        v[i].color = c;
+    }
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    SDL_RenderGeometry(renderer, NULL, v, 4, idx, 6);
+}
+
+/* 5x7 glyphs for the few letters the overlay needs, one byte per row, bit 4 = leftmost. */
+typedef struct {
+    char ch;
+    uint8_t rows[7];
+} OverlayGlyph;
+
+static const OverlayGlyph overlay_font[] = {
+    { 'A', { 0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 } },
+    { 'B', { 0x1e, 0x11, 0x11, 0x1e, 0x11, 0x11, 0x1e } },
+    { 'E', { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x1f } },
+    { 'G', { 0x0e, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0f } },
+    { 'I', { 0x1f, 0x04, 0x04, 0x04, 0x04, 0x04, 0x1f } },
+    { 'M', { 0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11 } },
+    { 'N', { 0x11, 0x19, 0x15, 0x13, 0x11, 0x11, 0x11 } },
+    { 'O', { 0x0e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+    { 'Q', { 0x0e, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0d } },
+    { 'S', { 0x0f, 0x10, 0x10, 0x0e, 0x01, 0x01, 0x1e } },
+    { 'T', { 0x1f, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04 } },
+    { 'U', { 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+    { 'Y', { 0x11, 0x11, 0x0a, 0x04, 0x04, 0x04, 0x04 } },
+    { '?', { 0x0e, 0x11, 0x01, 0x02, 0x04, 0x00, 0x04 } },
+    { '=', { 0x00, 0x00, 0x1f, 0x00, 0x1f, 0x00, 0x00 } },
+};
+
+static void overlay_text(const char* text, float x, float y, float scale, unsigned rgba) {
+    size_t n = strlen(text);
+    size_t i;
+    for (i = 0; i < n; ++i) {
+        char ch = text[i];
+        const OverlayGlyph* glyph = NULL;
+        size_t g;
+        if (ch == ' ') {
+            x += 6.0f * scale;
+            continue;
+        }
+        for (g = 0; g < sizeof(overlay_font) / sizeof(overlay_font[0]); ++g) {
+            if (overlay_font[g].ch == ch) {
+                glyph = &overlay_font[g];
+                break;
+            }
+        }
+        if (glyph != NULL) {
+            int row, col;
+            for (row = 0; row < 7; ++row) {
+                for (col = 0; col < 5; ++col) {
+                    if ((glyph->rows[row] >> (4 - col)) & 1) {
+                        overlay_fill(x + (float) col * scale, y + (float) row * scale, scale,
+                                     scale, rgba);
+                    }
+                }
+            }
+        }
+        x += 6.0f * scale;
+    }
+}
+
+static float overlay_text_width(const char* text, float scale) {
+    return (float) strlen(text) * 6.0f * scale;
+}
+
+static void overlay_draw(void) {
+    if (!ready) return;
+    SDL_RenderSetClipRect(renderer, NULL);
+
+    if (overlay_dialog_open) {
+        /* The 800x280 panel is in engine virtual coordinates, centred on the virtual frame. */
+        const float pw = 800.0f;
+        const float ph = 280.0f;
+        const float px = ((float) virtual_width - pw) * 0.5f;
+        const float py = ((float) virtual_height - ph) * 0.5f;
+        const char* title = "QUIT GAME?";
+        const char* hint = "A = YES    B = NO";
+        overlay_fill(px - 6.0f, py - 6.0f, pw + 12.0f, ph + 12.0f, 0xff8a5f3a);
+        overlay_fill(px, py, pw, ph, 0xd8261a12);
+        overlay_text(title, px + (pw - overlay_text_width(title, 8.0f)) * 0.5f, py + 56.0f, 8.0f,
+                     0xffffffff);
+        overlay_text(hint, px + (pw - overlay_text_width(hint, 5.0f)) * 0.5f, py + 176.0f, 5.0f,
+                     0xffffd89f);
+    }
+
+    if (overlay_cursor_visible) {
+        /* Pointer events carry 1280x720 screen coordinates; the overlay draws in window pixels. */
+        const float kx = (float) virtual_width / 1280.0f;
+        const float ky = (float) virtual_height / 720.0f;
+        const float cx = map_offset_x + (float) overlay_cursor_x * kx * map_scale;
+        const float cy = map_offset_y + (float) overlay_cursor_y * ky * map_scale;
+        const float r = 9.0f * map_scale;
+        overlay_diamond(cx, cy, r, 0xc0000000);
+        overlay_diamond(cx, cy, r * 0.72f, 0xffffffff);
+    }
+}
+
+void galnx_sdl_present(void) {
+    if (!ready) return;
+    overlay_draw();
+    SDL_RenderSetClipRect(renderer, NULL);
+    SDL_RenderPresent(renderer);
+}
+
+/* Copy the render target (the frame last presented: the renderer swaps buffers, so the new back
+ * buffer holds the previous frame) into out as RGBA, box-filtered to width x height. */
+/* Pump SDL's events (the Switch video driver ticks the applet loop from here) and report
+ * whether the user asked to leave. */
+int galnx_sdl_pump_events(void) {
+    SDL_Event event;
+    if (!ready) return 0;
+    while (SDL_PollEvent(&event)) {
+        if (event.type == SDL_QUIT) return 1;
+    }
+    return 0;
+}
+
+int galnx_sdl_read_pixels_scaled(int width, int height, unsigned char* out) {
+    unsigned char* full;
+    uint32_t* buffer;
+    int x, y;
+    if (!ready || out == NULL || width <= 0 || height <= 0) return -1;
+    full = (unsigned char*) malloc((size_t) OUT_WIDTH * OUT_HEIGHT * 4);
+    if (full == NULL) return -2;
+    if (SDL_RenderReadPixels(renderer, NULL, SDL_PIXELFORMAT_ABGR8888, full,
+                             OUT_WIDTH * 4) != 0) {
+        free(full);
+        return -3;
+    }
+    buffer = (uint32_t*) full;
+    for (y = 0; y < height; ++y) {
+        int sy0 = (int) ((long) y * OUT_HEIGHT / height);
+        int sy1 = (int) ((long) (y + 1) * OUT_HEIGHT / height);
+        if (sy1 <= sy0) sy1 = sy0 + 1;
+        for (x = 0; x < width; ++x) {
+            int sx0 = (int) ((long) x * OUT_WIDTH / width);
+            int sx1 = (int) ((long) (x + 1) * OUT_WIDTH / width);
+            unsigned rs = 0, gs = 0, bs = 0, as = 0, n = 0;
+            int px, py;
+            if (sx1 <= sx0) sx1 = sx0 + 1;
+            for (py = sy0; py < sy1; ++py) {
+                for (px = sx0; px < sx1; ++px) {
+                    uint32_t value = buffer[py * OUT_WIDTH + px];
+                    rs += value & 0xff;
+                    gs += (value >> 8) & 0xff;
+                    bs += (value >> 16) & 0xff;
+                    as += (value >> 24) & 0xff;
+                    n++;
+                }
+            }
+            if (n == 0) n = 1;
+            out[(y * width + x) * 4 + 0] = (unsigned char) (rs / n);
+            out[(y * width + x) * 4 + 1] = (unsigned char) (gs / n);
+            out[(y * width + x) * 4 + 2] = (unsigned char) (bs / n);
+            out[(y * width + x) * 4 + 3] = (unsigned char) (as / n);
+        }
+    }
+    free(full);
+    return 0;
+}
+
+int galnx_sdl_write_screen_bmp(const char* path) {
+    unsigned char* pixels;
+    FILE* file;
+    uint8_t header[54];
+    int y;
+    if (!ready || path == NULL) return -1;
+    pixels = (unsigned char*) malloc((size_t) OUT_WIDTH * OUT_HEIGHT * 4);
+    if (pixels == NULL) return -2;
+    if (SDL_RenderReadPixels(renderer, NULL, SDL_PIXELFORMAT_ABGR8888, pixels,
+                             OUT_WIDTH * 4) != 0) {
+        free(pixels);
+        return -3;
+    }
+    file = fopen(path, "wb");
+    if (file == NULL) {
+        free(pixels);
+        return -4;
+    }
+    memset(header, 0, sizeof(header));
+    header[0] = 'B';
+    header[1] = 'M';
+    {
+        uint32_t size = 54u + (uint32_t) OUT_WIDTH * (uint32_t) OUT_HEIGHT * 4u;
+        header[2] = (uint8_t) (size & 0xff);
+        header[3] = (uint8_t) ((size >> 8) & 0xff);
+        header[4] = (uint8_t) ((size >> 16) & 0xff);
+        header[5] = (uint8_t) ((size >> 24) & 0xff);
+    }
+    header[10] = 54;
+    header[14] = 40;
+    header[18] = (uint8_t) (OUT_WIDTH & 0xff);
+    header[19] = (uint8_t) ((OUT_WIDTH >> 8) & 0xff);
+    header[22] = (uint8_t) (OUT_HEIGHT & 0xff);
+    header[23] = (uint8_t) ((OUT_HEIGHT >> 8) & 0xff);
+    header[26] = 1;
+    header[28] = 32;
+    fwrite(header, 1, sizeof(header), file);
+    for (y = OUT_HEIGHT - 1; y >= 0; --y) {
+        const unsigned char* row = pixels + (size_t) y * OUT_WIDTH * 4;
+        int x;
+        for (x = 0; x < OUT_WIDTH; ++x) {
+            unsigned char bgr[4];
+            bgr[0] = row[x * 4 + 2];
+            bgr[1] = row[x * 4 + 1];
+            bgr[2] = row[x * 4 + 0];
+            bgr[3] = 255;
+            fwrite(bgr, 1, 4, file);
+        }
+    }
+    fclose(file);
+    free(pixels);
+    return 0;
+}
