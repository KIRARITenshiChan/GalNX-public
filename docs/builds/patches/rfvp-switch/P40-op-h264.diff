diff --git a/crates/rfvp/src/subsystem/resources/videoplayer/horizon_h264.rs b/p40/rfvp/crates/rfvp/src/subsystem/resources/videoplayer/horizon_h264.rs
new file mode 100644
index 0000000..6a0017f
--- /dev/null
+++ b/crates/rfvp/src/subsystem/resources/videoplayer/horizon_h264.rs
@@ -0,0 +1,408 @@
+//! GalNX P40: NVDEC (nvtegra) H.264 movie backend for the Switch port.
+//!
+//! The shipped OP is WMV2 1280x720@30. WMV2 has no hardware decoder on Tegra X1
+//! and the A57 needs ~25 ms/frame for software decode, so the payload also ships
+//! the same OP re-encoded to H.264 (movie/01_h264.mp4). probe9 measured NVDEC at
+//! 297.8 fps decode + 3.79 ms/frame transfer at 1080p, so decoding is no longer
+//! the bottleneck; the remaining cost is the NV12->RGBA conversion, which the
+//! NEON kernel in rfvp_movie_color.c does in ~1-2 ms for 720p (the scalar path
+//! in the WMV backend took 43.54 ms for 1080p).
+//!
+//! The asset is opened through the file system (FFmpeg's file protocol), not
+//! through the VFS: a 100+ MiB movie must not be copied into the engine heap.
+//! When the asset is missing, or FFmpeg cannot open it, `try_open` returns
+//! `None` and `horizon::open` falls back to the WMV2 software path.
+
+use alloc::boxed::Box;
+use alloc::collections::VecDeque;
+use alloc::string::String;
+use alloc::vec::Vec;
+use core::ffi::{c_char, c_int};
+use core::ptr;
+
+use anyhow::{anyhow, Result};
+
+use crate::perf;
+use crate::platform_time::Instant;
+
+use super::{load_movie_audio, MovieAudio, MovieFrame, MovieRequest, MovieSource};
+
+/// One decoder call per engine tick at most; the stash is only refilled when it
+/// is empty, which paces the decode to the presentation rate.
+const MAX_DECODE_PER_TICK: usize = 1;
+
+const DECODE_LOG_EVERY: u32 = 30;
+
+extern "C" {
+    fn galnx_movie_open(path: *const c_char, allow_sw: c_int) -> c_int;
+    fn galnx_movie_next() -> c_int;
+    fn galnx_movie_close();
+    fn galnx_movie_plane_y() -> *const u8;
+    fn galnx_movie_plane_u() -> *const u8;
+    fn galnx_movie_plane_v() -> *const u8;
+    fn galnx_movie_planar() -> c_int;
+    fn galnx_movie_width() -> c_int;
+    fn galnx_movie_height() -> c_int;
+    fn galnx_movie_y_stride() -> c_int;
+    fn galnx_movie_uv_stride() -> c_int;
+    fn galnx_movie_pts_ms() -> f64;
+    fn galnx_movie_is_hw() -> c_int;
+    fn galnx_movie_error() -> *const c_char;
+
+    fn galnx_nv12_to_rgba(
+        y: *const u8,
+        uv: *const u8,
+        width: c_int,
+        height: c_int,
+        y_stride: c_int,
+        uv_stride: c_int,
+        out_rgba: *mut u8,
+    );
+    fn galnx_yuv420p_to_rgba(
+        y: *const u8,
+        u: *const u8,
+        v: *const u8,
+        width: c_int,
+        height: c_int,
+        y_stride: c_int,
+        u_stride: c_int,
+        v_stride: c_int,
+        out_rgba: *mut u8,
+    );
+}
+
+fn c_error() -> String {
+    let message = unsafe {
+        let raw = galnx_movie_error();
+        if raw.is_null() {
+            String::from("unknown error")
+        } else {
+            let mut len = 0usize;
+            while unsafe { ptr::read(raw.add(len)) } != 0 && len < 255 {
+                len += 1;
+            }
+            let bytes = unsafe { core::slice::from_raw_parts(raw, len) };
+            String::from_utf8_lossy(bytes).into_owned()
+        }
+    };
+    message
+}
+
+/// movie/01.wmv -> movie/01_h264.mp4
+fn h264_sibling(name: &str) -> Option<String> {
+    let dot = name.rfind('.')?;
+    let slash = name.rfind('/').map(|index| index + 1).unwrap_or(0);
+    if dot < slash {
+        return None;
+    }
+    let mut out = String::with_capacity(name.len() + 10);
+    out.push_str(&name[..dot]);
+    out.push_str("_h264.mp4");
+    Some(out)
+}
+
+fn c_path(name: &str) -> Option<Vec<u8>> {
+    if name.as_bytes().contains(&0) || name.len() > 900 {
+        return None;
+    }
+    let mut bytes = Vec::with_capacity(name.len() + 1);
+    bytes.extend_from_slice(name.as_bytes());
+    bytes.push(0);
+    Some(bytes)
+}
+
+struct DecodedFrame {
+    pts_ms: u32,
+    rgba: Vec<u8>,
+    width: u32,
+    height: u32,
+}
+
+struct H264Playback {
+    /// Asset name in the game's files (movie/01_h264.mp4), for logs only.
+    asset: String,
+    stash: VecDeque<DecodedFrame>,
+    started_at: Option<Instant>,
+    base_pts_ms: Option<u32>,
+    last_presented_pts_ms: u32,
+    eof: bool,
+    decoded_frames: u32,
+    presented_frames: u32,
+    hw_frames: u32,
+    last_decode_us: u32,
+    last_convert_us: u32,
+    /// One recycled RGBA buffer, like the WMV backend's spare_buffer.
+    spare_buffer: Option<Vec<u8>>,
+    audio: Option<MovieAudio>,
+    closed: bool,
+}
+
+impl H264Playback {
+    fn new(asset: String, audio: Option<MovieAudio>) -> Self {
+        Self {
+            asset,
+            stash: VecDeque::new(),
+            started_at: None,
+            base_pts_ms: None,
+            last_presented_pts_ms: u32::MAX,
+            eof: false,
+            decoded_frames: 0,
+            presented_frames: 0,
+            hw_frames: 0,
+            last_decode_us: 0,
+            last_convert_us: 0,
+            spare_buffer: None,
+            audio,
+            closed: false,
+        }
+    }
+
+    fn maybe_start_audio(&mut self) {
+        if let Some(audio) = self.audio.as_mut() {
+            audio.start();
+        }
+    }
+
+    fn stop_audio(&mut self) {
+        if let Some(audio) = self.audio.as_mut() {
+            audio.stop();
+        }
+    }
+
+    fn close_decoder(&mut self) {
+        if !self.closed {
+            self.closed = true;
+            unsafe { galnx_movie_close() };
+        }
+    }
+
+    fn decode_one(&mut self) -> Result<bool> {
+        if self.eof {
+            return Ok(false);
+        }
+        let decode_t0 = perf::start();
+        let rc = unsafe { galnx_movie_next() };
+        if rc == 0 {
+            self.eof = true;
+            log::info!(
+                "movie h264: end of stream after {} frames ({} hardware)",
+                self.decoded_frames,
+                self.hw_frames
+            );
+            return Ok(false);
+        }
+        if rc < 0 {
+            return Err(anyhow!("h264 decode failed: {}", c_error()));
+        }
+        self.last_decode_us = perf::start()
+            .saturating_sub(decode_t0)
+            .min(u32::MAX as u64) as u32;
+
+        let (width, height, y_stride, uv_stride, planar, pts_ms, hw) = unsafe {
+            (
+                galnx_movie_width(),
+                galnx_movie_height(),
+                galnx_movie_y_stride(),
+                galnx_movie_uv_stride(),
+                galnx_movie_planar(),
+                galnx_movie_pts_ms(),
+                galnx_movie_is_hw(),
+            )
+        };
+        if width <= 0 || height <= 0 {
+            return Ok(false);
+        }
+        let width = width as u32;
+        let height = height as u32;
+        let needed = width as usize * height as usize * 4;
+        let mut rgba = self.spare_buffer.take().unwrap_or_default();
+        if rgba.len() != needed {
+            rgba.clear();
+            rgba.resize(needed, 255);
+        }
+
+        let convert_t0 = perf::start();
+        unsafe {
+            let y = galnx_movie_plane_y();
+            let u = galnx_movie_plane_u();
+            let v = galnx_movie_plane_v();
+            if y.is_null() || u.is_null() || v.is_null() {
+                self.spare_buffer = Some(rgba);
+                return Ok(false);
+            }
+            if planar != 0 {
+                galnx_yuv420p_to_rgba(
+                    y,
+                    u,
+                    v,
+                    width as c_int,
+                    height as c_int,
+                    y_stride,
+                    uv_stride,
+                    uv_stride,
+                    rgba.as_mut_ptr(),
+                );
+            } else {
+                galnx_nv12_to_rgba(
+                    y,
+                    u,
+                    width as c_int,
+                    height as c_int,
+                    y_stride,
+                    uv_stride,
+                    rgba.as_mut_ptr(),
+                );
+            }
+        }
+        self.last_convert_us = perf::start()
+            .saturating_sub(convert_t0)
+            .min(u32::MAX as u64) as u32;
+
+        self.decoded_frames = self.decoded_frames.saturating_add(1);
+        if hw != 0 {
+            self.hw_frames = self.hw_frames.saturating_add(1);
+        }
+        if self.decoded_frames <= 5 || self.decoded_frames % DECODE_LOG_EVERY == 0 {
+            log::info!(
+                "movie h264: decoded frame={} pts={} ms {}x{} hw={} decode_us={} convert_us={}",
+                self.decoded_frames,
+                pts_ms as u32,
+                width,
+                height,
+                hw,
+                self.last_decode_us,
+                self.last_convert_us
+            );
+        }
+        self.stash.push_back(DecodedFrame {
+            pts_ms: if pts_ms > 0.0 { pts_ms as u32 } else { 0 },
+            rgba,
+            width,
+            height,
+        });
+        Ok(true)
+    }
+
+    fn next_due_frame(&mut self) -> Result<Option<DecodedFrame>> {
+        for _ in 0..MAX_DECODE_PER_TICK {
+            if !self.stash.is_empty() || self.eof {
+                break;
+            }
+            self.decode_one()?;
+        }
+
+        if self.started_at.is_none() {
+            if let Some(front) = self.stash.front() {
+                self.started_at = Some(Instant::now());
+                self.base_pts_ms = Some(front.pts_ms);
+            } else {
+                return Ok(None);
+            }
+        }
+
+        let started_at = match self.started_at {
+            Some(started_at) => started_at,
+            None => return Ok(None),
+        };
+        let elapsed_ms = started_at.elapsed().as_millis() as u32;
+        let target_pts_ms = self.base_pts_ms.unwrap_or(0).saturating_add(elapsed_ms);
+        let mut latest_due = None;
+        while let Some(front) = self.stash.front() {
+            if front.pts_ms <= target_pts_ms {
+                latest_due = self.stash.pop_front();
+            } else {
+                break;
+            }
+        }
+        if latest_due.is_some() {
+            self.presented_frames = self.presented_frames.saturating_add(1);
+        }
+        Ok(latest_due)
+    }
+
+    fn finished(&mut self) -> Result<bool> {
+        let done = self.eof && self.stash.is_empty();
+        if done {
+            log::info!(
+                "movie h264: finished flag set (eof={} stash={} decoded={} hw={})",
+                self.eof,
+                self.stash.len(),
+                self.decoded_frames,
+                self.hw_frames
+            );
+        }
+        Ok(done)
+    }
+}
+
+impl MovieSource for H264Playback {
+    fn next_frame(&mut self) -> Result<Option<MovieFrame>> {
+        // GalNX P40 diagnostics: these three lines are what makes a stalled
+        // movie distinguishable from an ended one in debug_report.txt.
+        let frame = match self.next_due_frame() {
+            Ok(Some(frame)) => frame,
+            Ok(None) => return Ok(None),
+            Err(err) => {
+                log::warn!("movie h264: next_due_frame failed: {err}");
+                return Err(err);
+            }
+        };
+        if frame.pts_ms == self.last_presented_pts_ms {
+            log::info!(
+                "movie h264: dropping frame with duplicate pts={} ms (last={})",
+                frame.pts_ms,
+                self.last_presented_pts_ms
+            );
+            return Ok(None);
+        }
+        self.last_presented_pts_ms = frame.pts_ms;
+        self.maybe_start_audio();
+        Ok(Some(MovieFrame {
+            rgba: frame.rgba,
+            width: frame.width,
+            height: frame.height,
+        }))
+    }
+
+    fn is_finished(&mut self) -> Result<bool> {
+        self.finished()
+    }
+
+    fn recycle_buffer(&mut self, buffer: Vec<u8>) {
+        if self.spare_buffer.is_none() {
+            self.spare_buffer = Some(buffer);
+        }
+    }
+
+    fn stop(mut self: Box<Self>) {
+        self.stop_audio();
+        self.close_decoder();
+    }
+}
+
+impl Drop for H264Playback {
+    fn drop(&mut self) {
+        self.stop_audio();
+        self.close_decoder();
+    }
+}
+
+/// Try to open the H.264 sibling asset. `None` means "no hardware movie
+/// available"; the caller keeps using the WMV2 software path.
+pub(super) fn try_open(request: &MovieRequest<'_>) -> Option<Box<dyn MovieSource>> {
+    let asset = h264_sibling(request.name)?;
+    let path = c_path(asset.as_str())?;
+    let rc = unsafe { galnx_movie_open(path.as_ptr() as *const c_char, 1) };
+    if rc < 0 {
+        log::warn!(
+            "movie h264: cannot open {} ({}); using the WMV2 backend",
+            asset,
+            c_error()
+        );
+        unsafe { galnx_movie_close() };
+        return None;
+    }
+    log::info!("Movie: opened (Switch NVDEC H.264) asset={asset}");
+    let audio = load_movie_audio(request);
+    Some(Box::new(H264Playback::new(asset, audio)))
+}
