@@ -0,0 +1,43 @@
+#ifndef GALNX_RFVP_MOVIE_H264_H
+#define GALNX_RFVP_MOVIE_H264_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* GalNX P40: FFmpeg/nvtegra H.264 movie decoder (see rfvp_movie_h264.c). */
+
+int galnx_movie_init(const char *game_root);
+void galnx_movie_set_root(const char *root);
+int galnx_movie_open(const char *rel_path, int allow_sw);
+/* 1 = a frame is ready, 0 = end of stream, <0 = error. */
+int galnx_movie_next(void);
+void galnx_movie_close(void);
+
+const uint8_t *galnx_movie_plane_y(void);
+const uint8_t *galnx_movie_plane_u(void);
+const uint8_t *galnx_movie_plane_v(void);
+int galnx_movie_planar(void);
+int galnx_movie_width(void);
+int galnx_movie_height(void);
+int galnx_movie_y_stride(void);
+int galnx_movie_uv_stride(void);
+double galnx_movie_pts_ms(void);
+int galnx_movie_is_hw(void);
+int galnx_movie_frame_index(void);
+const char *galnx_movie_error(void);
+
+/* BT.709 limited-range YUV -> packed R,G,B,A. */
+void galnx_nv12_to_rgba(const uint8_t *y, const uint8_t *uv, int width, int height,
+                        int y_stride, int uv_stride, uint8_t *out_rgba);
+void galnx_yuv420p_to_rgba(const uint8_t *y, const uint8_t *u, const uint8_t *v,
+                           int width, int height, int y_stride, int u_stride,
+                           int v_stride, uint8_t *out_rgba);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GALNX_RFVP_MOVIE_H264_H */
diff --git a/platform/switch/runtime/rfvp_movie_color.c b/p40/rfvp/platform/switch/runtime/rfvp_movie_color.c
new file mode 100644
index 0000000..cc99925
--- /dev/null
+++ b/platform/switch/runtime/rfvp_movie_color.c
@@ -0,0 +1,184 @@
+/*
+ * GalNX P40: BT.709 limited-range YUV 4:2:0 -> packed RGBA conversion.
+ *
+ * probe9 measured the scalar NV12->RGBA path at 43.54 ms/frame for 1080p, which
+ * was 89% of the whole movie frame time and the only reason the OP still played
+ * in slow motion after NVDEC decode itself was proven to run at 297.8 fps.
+ * The kernels below are fixed-point (16.8) BT.709 and use NEON on 16 pixels per
+ * iteration; the tail falls back to the scalar code.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "rfvp_movie_h264.h"
+
+static inline int clip8(int v)
+{
+    if (v < 0) {
+        return 0;
+    }
+    if (v > 255) {
+        return 255;
+    }
+    return v;
+}
+
+static inline int matrix_r(int c, int v) { return (c + 458 * v) >> 8; }
+static inline int matrix_g(int c, int u, int v) { return (c - 55 * u - 136 * v) >> 8; }
+static inline int matrix_b(int c, int u) { return (c + 540 * u) >> 8; }
+
+#if defined(__ARM_NEON)
+#include <arm_neon.h>
+
+static inline void store8(int16x8_t yv, int16x8_t uv, int16x8_t vv, uint8_t *dst)
+{
+    const int16x8_t c16 = vdupq_n_s16(16);
+    const int16x8_t c128 = vdupq_n_s16(128);
+
+    int16x8_t yd = vsubq_s16(yv, c16);
+    int16x8_t ud = vsubq_s16(uv, c128);
+    int16x8_t vd = vsubq_s16(vv, c128);
+
+    int16x4_t yl = vget_low_s16(yd);
+    int16x4_t yh = vget_high_s16(yd);
+    int16x4_t ul = vget_low_s16(ud);
+    int16x4_t uh = vget_high_s16(ud);
+    int16x4_t vl = vget_low_s16(vd);
+    int16x4_t vh = vget_high_s16(vd);
+
+    int32x4_t cyl = vmull_n_s16(yl, 298);
+    int32x4_t cyh = vmull_n_s16(yh, 298);
+
+    int32x4_t rl = vshrq_n_s32(vmlal_n_s16(cyl, vl, 458), 8);
+    int32x4_t rh = vshrq_n_s32(vmlal_n_s16(cyh, vh, 458), 8);
+    int32x4_t gl = vshrq_n_s32(vsubq_s32(vsubq_s32(cyl, vmull_n_s16(ul, 55)),
+                                         vmull_n_s16(vl, 136)), 8);
+    int32x4_t gh = vshrq_n_s32(vsubq_s32(vsubq_s32(cyh, vmull_n_s16(uh, 55)),
+                                         vmull_n_s16(vh, 136)), 8);
+    int32x4_t bl = vshrq_n_s32(vmlal_n_s16(cyl, ul, 540), 8);
+    int32x4_t bh = vshrq_n_s32(vmlal_n_s16(cyh, uh, 540), 8);
+
+    uint8x8_t r8 = vqmovun_s16(vcombine_s16(vqmovn_s32(rl), vqmovn_s32(rh)));
+    uint8x8_t g8 = vqmovun_s16(vcombine_s16(vqmovn_s32(gl), vqmovn_s32(gh)));
+    uint8x8_t b8 = vqmovun_s16(vcombine_s16(vqmovn_s32(bl), vqmovn_s32(bh)));
+
+    uint8x8x4_t px;
+    px.val[0] = r8;
+    px.val[1] = g8;
+    px.val[2] = b8;
+    px.val[3] = vdup_n_u8(255);
+    vst4_u8(dst, px);
+}
+
+/* Deinterleave 8 NV12 chroma bytes into duplicated 8-lane U and V vectors. */
+static inline void chroma_dup(uint8x8_t both, int16x8_t *u, int16x8_t *v)
+{
+    int16x8_t x = vreinterpretq_s16_u16(vmovl_u8(both));
+    int16x8_t even = vuzp1q_s16(x, x); /* u0,u1,u2,u3,u0,u1,u2,u3 */
+    int16x8_t odd = vuzp2q_s16(x, x);  /* v0,v1,v2,v3,v0,v1,v2,v3 */
+    *u = vzip1q_s16(even, even);       /* u0,u0,u1,u1,u2,u2,u3,u3 */
+    *v = vzip1q_s16(odd, odd);
+}
+
+static void nv12_row_neon(const uint8_t *yr, const uint8_t *uvr, int width, uint8_t *dst)
+{
+    int i = 0;
+    for (; i + 15 < width; i += 16) {
+        uint8x16_t yb = vld1q_u8(yr + i);
+        int16x8_t u0;
+        int16x8_t v0;
+        int16x8_t u1;
+        int16x8_t v1;
+        chroma_dup(vld1_u8(uvr + (i >> 1)), &u0, &v0);
+        chroma_dup(vld1_u8(uvr + (i >> 1) + 4), &u1, &v1);
+        store8(vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(yb))), u0, v0, dst + i * 4);
+        store8(vreinterpretq_s16_u16(vmovl_u8(vget_high_u8(yb))), u1, v1, dst + i * 4 + 32);
+    }
+    for (; i < width; i++) {
+        int c = 298 * ((int)yr[i] - 16);
+        int u = (int)uvr[(i >> 1) * 2] - 128;
+        int v = (int)uvr[(i >> 1) * 2 + 1] - 128;
+        dst[i * 4 + 0] = (uint8_t)clip8(matrix_r(c, v));
+        dst[i * 4 + 1] = (uint8_t)clip8(matrix_g(c, u, v));
+        dst[i * 4 + 2] = (uint8_t)clip8(matrix_b(c, u));
+        dst[i * 4 + 3] = 255;
+    }
+}
+
+static void planar_row_neon(const uint8_t *yr, const uint8_t *ur, const uint8_t *vr,
+                            int width, uint8_t *dst)
+{
+    int i = 0;
+    for (; i + 15 < width; i += 16) {
+        uint8x16_t yb = vld1q_u8(yr + i);
+        int16x8_t u = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(ur + (i >> 1))));
+        int16x8_t v = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(vr + (i >> 1))));
+        int16x8_t u2 = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(ur + (i >> 1) + 4)));
+        int16x8_t v2 = vreinterpretq_s16_u16(vmovl_u8(vld1_u8(vr + (i >> 1) + 4)));
+        u = vzip1q_s16(u, u);
+        v = vzip1q_s16(v, v);
+        u2 = vzip1q_s16(u2, u2);
+        v2 = vzip1q_s16(v2, v2);
+        store8(vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(yb))), u, v, dst + i * 4);
+        store8(vreinterpretq_s16_u16(vmovl_u8(vget_high_u8(yb))), u2, v2, dst + i * 4 + 32);
+    }
+    for (; i < width; i++) {
+        int c = 298 * ((int)yr[i] - 16);
+        int u = (int)ur[i >> 1] - 128;
+        int v = (int)vr[i >> 1] - 128;
+        dst[i * 4 + 0] = (uint8_t)clip8(matrix_r(c, v));
+        dst[i * 4 + 1] = (uint8_t)clip8(matrix_g(c, u, v));
+        dst[i * 4 + 2] = (uint8_t)clip8(matrix_b(c, u));
+        dst[i * 4 + 3] = 255;
+    }
+}
+#endif /* __ARM_NEON */
+
+void galnx_nv12_to_rgba(const uint8_t *y, const uint8_t *uv, int width, int height,
+                        int y_stride, int uv_stride, uint8_t *out_rgba)
+{
+    for (int j = 0; j < height; j++) {
