new file mode 100644
index 0000000..5e21083
--- /dev/null
+++ b/platform/switch/runtime/rfvp_movie_h264.c
@@ -0,0 +1,416 @@
+/*
+ * GalNX P40: FFmpeg + nvtegra H.264 decoder for the rfvp Switch movie player.
+ *
+ * The OP shipped with IROSEKA is WMV2 1280x720@30, and WMV2 has no hardware
+ * decoder on Tegra X1 (nvtegra covers VC-1/WMV3/H.264 only), while software WMV2
+ * decode on the A57 needs ~25 ms/frame. The OP is therefore re-encoded to H.264
+ * and decoded with NVDEC (nvtegra), which probe9 measured at 297.8 fps decode
+ * and 3.79 ms/frame for the tiled->linear transfer at 1080p.
+ *
+ * This module only decodes and hands NV12 planes back to Rust; the colour
+ * conversion and the frame pacing live in horizon_h264.rs / rfvp_movie_color.c.
+ *
+ * The build statically links the nvtegra FFmpeg fork built by
+ * /e/galnx-build/nvdec/build-ffmpeg-nvtegra-msys.sh (see docs/builds/044).
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/error.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/imgutils.h>
+#include <libavutil/pixfmt.h>
+
+#include "rfvp_movie_h264.h"
+
+/* Root of the game data ("sdmc:/switch/rfvp/game" or "romfs:/game"). Set once
+ * by main.c right after the root is selected and before rfvp_switch_start(). */
+static char g_root[512] = "sdmc:/switch/rfvp/game";
+
+typedef struct MovieCtx {
+    AVFormatContext *fmt;
+    AVCodecContext *dec;
+    AVBufferRef *hw_device;
+    AVFrame *frame;    /* decoded frame, hardware or software */
+    AVFrame *sw_frame; /* NV12/planar target for hardware frames */
+    AVPacket *pkt;
+    int video_stream;
+    int eof;
+    int draining;
+    int allow_sw;
+    int used_hw;   /* whether the frame returned by the last next() came from NVDEC */
+    int requested; /* 1 after a successful open */
+    int width;
+    int height;
+    int y_stride;
+    int uv_stride;
+    int planar; /* 1 = YUV420P (U and V separate), 0 = NV12 (interleaved) */
+    const uint8_t *plane_y;
+    const uint8_t *plane_u;
+    const uint8_t *plane_v;
+    double pts_ms;
+    int64_t frame_index;
+    char path[1024];
+    char error[256];
+} MovieCtx;
+
+static MovieCtx *g_ctx = NULL;
+
+/* Kept across galnx_movie_close() so a failed open can still be reported:
+ * the open path closes the context before the caller asks for the message. */
+static char g_last_error[256] = { 0 };
+
+/* Shadow-test switch: Citron's HLE nvtegra accepts the device and the first
+ * frame but then fails every subsequent send_packet, so the emulator cannot
+ * exercise the hardware path. When this file exists we skip NVDEC entirely and
+ * decode with the CPU, which keeps the rest of the pipeline (NEON NV12->RGBA,
+ * pacing, audio) testable on the emulator. Never present on a real device. */
+static int g_force_soft = 0;
+
+static const char *ForceSoftMarker = "sdmc:/switch/rfvp/h264_sw.txt";
+
+/* ------------------------------------------------------------------ */
+/* helpers                                                            */
+/* ------------------------------------------------------------------ */
+
+static void set_error(const char *what, int err)
+{
+    char buf[160] = { 0 };
+    if (err != 0) {
+        av_strerror(err, buf, sizeof(buf));
+    }
+    snprintf(g_last_error, sizeof(g_last_error), "%s: %s (%d)", what, buf, err);
+    if (g_ctx != NULL) {
+        snprintf(g_ctx->error, sizeof(g_ctx->error), "%s", g_last_error);
+    }
+}
+
+void galnx_movie_set_root(const char *root)
+{
+    if (root == NULL) {
+        return;
+    }
+    snprintf(g_root, sizeof(g_root), "%s", root);
+    size_t len = strlen(g_root);
+    while (len > 1 && (g_root[len - 1] == '/' || g_root[len - 1] == '\\')) {
+        g_root[--len] = '\0';
+    }
+}
+
+const char *galnx_movie_error(void)
+{
+    if (g_ctx != NULL) {
+        return g_ctx->error;
+    }
+    return g_last_error[0] != '\0' ? g_last_error : "no movie context";
+}
+
+static enum AVPixelFormat movie_get_format(AVCodecContext *ctx, const enum AVPixelFormat *pix_fmts)
+{
+    (void)ctx;
+    const enum AVPixelFormat *p;
+    if (!g_force_soft) {
+        for (p = pix_fmts; *p != AV_PIX_FMT_NONE; p++) {
+            if (*p == AV_PIX_FMT_NVTEGRA) {
+                return *p;
+            }
+        }
+    }
+    for (p = pix_fmts; *p != AV_PIX_FMT_NONE; p++) {
+        if (*p == AV_PIX_FMT_NV12 || *p == AV_PIX_FMT_YUV420P) {
+            return *p;
+        }
+    }
+    return pix_fmts[0];
+}
+
+static void movie_reset_frame_state(MovieCtx *c)
+{
+    c->plane_y = NULL;
+    c->plane_u = NULL;
+    c->plane_v = NULL;
+    c->width = 0;
+    c->height = 0;
+    c->y_stride = 0;
+    c->uv_stride = 0;
+    c->planar = 0;
+    c->pts_ms = 0.0;
+}
+
+static void movie_close_internal(MovieCtx *c)
+{
+    movie_reset_frame_state(c);
+    if (c->pkt != NULL) {
+        av_packet_free(&c->pkt);
+    }
+    if (c->frame != NULL) {
+        av_frame_free(&c->frame);
+    }
+    if (c->sw_frame != NULL) {
+        av_frame_free(&c->sw_frame);
+    }
+    if (c->dec != NULL) {
+        avcodec_free_context(&c->dec);
+    }
+    if (c->fmt != NULL) {
+        avformat_close_input(&c->fmt);
+    }
+    if (c->hw_device != NULL) {
+        av_buffer_unref(&c->hw_device);
+    }
+    c->video_stream = -1;
+    c->eof = 0;
+    c->draining = 0;
+    c->requested = 0;
+    c->used_hw = 0;
+    c->frame_index = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* public API                                                         */
+/* ------------------------------------------------------------------ */
+
+void galnx_movie_close(void)
+{
+    if (g_ctx == NULL) {
+        return;
+    }
+    movie_close_internal(g_ctx);
+    free(g_ctx);
+    g_ctx = NULL;
+}
+
+int galnx_movie_init(const char *game_root)
+{
+    galnx_movie_set_root(game_root);
+    av_log_set_level(AV_LOG_ERROR);
+    FILE *marker = fopen(ForceSoftMarker, "rb");
+    if (marker != NULL) {
+        fclose(marker);
+        g_force_soft = 1;
+    }
+    av_log(NULL, AV_LOG_INFO, "[galnx] movie h264: software decode %s (%s %s)\n",
+           g_force_soft ? "forced" : "allowed",
+           g_force_soft ? "marker present:" : "no marker:",
+           ForceSoftMarker);
+    return 0;
+}
+
+int galnx_movie_open(const char *rel_path, int allow_sw)
+{
+    galnx_movie_close();
+
+    MovieCtx *c = (MovieCtx *)calloc(1, sizeof(MovieCtx));
+    if (c == NULL) {
+        return -1;
+    }
+    g_ctx = c;
+    c->video_stream = -1;
+    c->allow_sw = allow_sw ? 1 : 0;
+
+    size_t len = strlen(g_root);
+    char sep = (len > 0 && g_root[len - 1] == '/') ? '\0' : '/';
+    if (sep == '\0') {
+        snprintf(c->path, sizeof(c->path), "%s%s", g_root, rel_path);
+    } else {
+        snprintf(c->path, sizeof(c->path), "%s/%s", g_root, rel_path);
+    }
+
+    /* The horizon FFmpeg build only has the "file" protocol compiled in, and it
+     * would otherwise parse "sdmc:/..." as an unknown protocol named "sdmc".
+     * Prefix "file:" so the libnx devoptab path reaches libc open(). */
+    char url[sizeof(c->path) + 8];
+    const char *open_path = c->path;
+    if (strncmp(c->path, "file:", 5) != 0) {
+        snprintf(url, sizeof(url), "file:%s", c->path);
+        open_path = url;
+    }
+
+    int ret = avformat_open_input(&c->fmt, open_path, NULL, NULL);
+    if (ret < 0) {
+        set_error("avformat_open_input", ret);
+        galnx_movie_close();
+        return ret;
+    }
+    ret = avformat_find_stream_info(c->fmt, NULL);
+    if (ret < 0) {
+        set_error("avformat_find_stream_info", ret);
+        galnx_movie_close();
+        return ret;
+    }
+
+    const AVCodec *codec = NULL;
+    c->video_stream = av_find_best_stream(c->fmt, AVMEDIA_TYPE_VIDEO, -1, -1, &codec, 0);
+    if (c->video_stream < 0 || codec == NULL) {
+        set_error("av_find_best_stream", c->video_stream < 0 ? c->video_stream : -1);
+        galnx_movie_close();
+        return -2;
+    }
+
+    c->dec = avcodec_alloc_context3(codec);
+    if (c->dec == NULL) {
+        set_error("avcodec_alloc_context3", AVERROR(ENOMEM));
+        galnx_movie_close();
+        return AVERROR(ENOMEM);
+    }
+    ret = avcodec_parameters_to_context(c->dec, c->fmt->streams[c->video_stream]->codecpar);
+    if (ret < 0) {
+        set_error("avcodec_parameters_to_context", ret);
+        galnx_movie_close();
+        return ret;
+    }
+    c->dec->pkt_timebase = c->fmt->streams[c->video_stream]->time_base;
+    c->dec->get_format = movie_get_format;
+    c->dec->thread_count = 1;
+
+    int hw_ok = 0;
+    ret = g_force_soft ? AVERROR(ENOSYS)
+                       : av_hwdevice_ctx_create(&c->hw_device, AV_HWDEVICE_TYPE_NVTEGRA, NULL, NULL, 0);
+    if (ret >= 0) {
+        c->dec->hw_device_ctx = av_buffer_ref(c->hw_device);
+        hw_ok = c->dec->hw_device_ctx != NULL;
+    } else {
+        av_log(NULL, AV_LOG_WARNING, "[galnx] nvtegra device unavailable (%d); H.264 software decode\n", ret);
+        if (c->hw_device != NULL) {
+            av_buffer_unref(&c->hw_device);
+            c->hw_device = NULL;
+        }
+    }
+
+    ret = avcodec_open2(c->dec, codec, NULL);
+    if (ret < 0) {
+        set_error("avcodec_open2", ret);
+        galnx_movie_close();
+        return ret;
+    }
+
+    c->frame = av_frame_alloc();
+    c->sw_frame = av_frame_alloc();
+    c->pkt = av_packet_alloc();
+    if (c->frame == NULL || c->sw_frame == NULL || c->pkt == NULL) {
+        set_error("av_frame_alloc", AVERROR(ENOMEM));
+        galnx_movie_close();
+        return AVERROR(ENOMEM);
+    }
+
+    c->requested = 1;
+    av_log(NULL, AV_LOG_INFO,
+           "[galnx] movie opened: %s codec=%s hw_requested=%d hwdev=%d %dx%d\n",
+           c->path, codec->name, allow_sw ? 1 : 0, hw_ok,
+           c->dec->width, c->dec->height);
+    return 0;
+}
+
+int galnx_movie_next(void)
+{
+    MovieCtx *c = g_ctx;
+    if (c == NULL || !c->requested) {
+        return -1;
+    }
+
+    movie_reset_frame_state(c);
+
+    for (;;) {
+        int ret = avcodec_receive_frame(c->dec, c->frame);
+        if (ret == 0) {
+            break;
+        }
+        if (ret == AVERROR_EOF) {
+            c->eof = 1;
+            return 0;
+        }
+        if (ret != AVERROR(EAGAIN)) {
+            set_error("avcodec_receive_frame", ret);
+            return -1;
+        }
+
+        if (c->draining) {
+            c->eof = 1;
+            return 0;
+        }
+
+        ret = av_read_frame(c->fmt, c->pkt);
+        if (ret == AVERROR_EOF) {
+            avcodec_send_packet(c->dec, NULL);
+            c->draining = 1;
+            continue;
+        }
+        if (ret < 0) {
+            set_error("av_read_frame", ret);
+            return -1;
+        }
+        if (c->pkt->stream_index == c->video_stream) {
+            ret = avcodec_send_packet(c->dec, c->pkt);
+            av_packet_unref(c->pkt);
+            if (ret < 0 && ret != AVERROR(EAGAIN)) {
+                set_error("avcodec_send_packet", ret);
+                return -1;
+            }
+        } else {
+            av_packet_unref(c->pkt);
+        }
+    }
+
+    AVFrame *src = c->frame;
+    if (c->frame->format == AV_PIX_FMT_NVTEGRA) {
+        int ret = av_hwframe_transfer_data(c->sw_frame, c->frame, 0);
+        if (ret < 0) {
+            set_error("av_hwframe_transfer_data", ret);
+            return -1;
+        }
+        src = c->sw_frame;
+        c->used_hw = 1;
+    } else {
+        c->used_hw = 0;
+    }
+
+    c->width = src->width;
+    c->height = src->height;
+    c->y_stride = src->linesize[0];
+    if (src->format == AV_PIX_FMT_NV12) {
+        c->planar = 0;
+        c->plane_y = src->data[0];
+        c->plane_u = src->data[1];
+        c->plane_v = src->data[1] != NULL ? src->data[1] + 1 : NULL;
+        c->uv_stride = src->linesize[1];
+    } else if (src->format == AV_PIX_FMT_YUV420P) {
+        c->planar = 1;
+        c->plane_y = src->data[0];
+        c->plane_u = src->data[1];
+        c->plane_v = src->data[2];
+        c->uv_stride = src->linesize[1];
+    } else {
+        c->error[0] = '\0';
+        snprintf(c->error, sizeof(c->error), "unsupported pixel format %d", src->format);
+        return -2;
+    }
+
+    int64_t ts = src->best_effort_timestamp;
+    if (ts == AV_NOPTS_VALUE) {
+        ts = src->pts;
+    }
+    if (ts != AV_NOPTS_VALUE) {
+        c->pts_ms = (double)ts * av_q2d(c->fmt->streams[c->video_stream]->time_base) * 1000.0;
+    } else {
+        c->pts_ms = (double)(c->frame_index * 1000 / 30);
+    }
+    c->frame_index++;
+    return 1;
+}
+
+const uint8_t *galnx_movie_plane_y(void) { return g_ctx != NULL ? g_ctx->plane_y : NULL; }
+const uint8_t *galnx_movie_plane_u(void) { return g_ctx != NULL ? g_ctx->plane_u : NULL; }
+const uint8_t *galnx_movie_plane_v(void) { return g_ctx != NULL ? g_ctx->plane_v : NULL; }
+int galnx_movie_planar(void) { return g_ctx != NULL ? g_ctx->planar : 0; }
+int galnx_movie_width(void) { return g_ctx != NULL ? g_ctx->width : 0; }
+int galnx_movie_height(void) { return g_ctx != NULL ? g_ctx->height : 0; }
+int galnx_movie_y_stride(void) { return g_ctx != NULL ? g_ctx->y_stride : 0; }
+int galnx_movie_uv_stride(void) { return g_ctx != NULL ? g_ctx->uv_stride : 0; }
+double galnx_movie_pts_ms(void) { return g_ctx != NULL ? g_ctx->pts_ms : 0.0; }
+int galnx_movie_is_hw(void) { return g_ctx != NULL ? g_ctx->used_hw : 0; }
+int galnx_movie_frame_index(void) { return g_ctx != NULL ? (int)g_ctx->frame_index : 0; }
diff --git a/platform/switch/runtime/rfvp_movie_h264.h b/p40/rfvp/platform/switch/runtime/rfvp_movie_h264.h
new file mode 100644
index 0000000..26052c7
