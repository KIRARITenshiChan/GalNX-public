+/// Warm the next Album differential picture of a CG (GalNX P26).
+///
+/// The album steps through one slot letter by letter (`graph_vis2/MIO_e01b`,
+/// `graph_vis2/MIO_e01c`, ...). Each one is a full 4K picture of 8 MB, so the frame that first
+/// shows it used to wait ~1.6 s: ~1.1 s to read the file from the SD card plus ~0.3 s to inflate
+/// it. While the current picture is decoded synchronously, decode the next one on the worker
+/// thread, so the next key press finds the texture already in the cache. A candidate that is not
+/// in the pack costs nothing but one index lookup, and a prefetch never changes what
+/// `graph_load` returns.
+///
+/// P26: only one picture ahead. A 4K differential occupies 3840x2160x4 = 33,177,600 bytes of the
+/// 256 MiB texture budget (measured on Citron); a two-entry lookahead plus the current picture
+/// would put ~99 MB into the budget on top of the menu textures and hasten LRU evictions.
+#[cfg(all(not(feature = "old_school"), feature = "switch-async"))]
+fn prefetch_vis_sequence(game_data: &mut GameData, path: &str) {
+    use crate::subsystem::resources::{async_decode, resource_cache};
+    let bytes = path.as_bytes();
+    let Some(&last) = bytes.last() else {
+        return;
+    };
+    if !last.is_ascii_alphabetic() || last == b'z' || last == b'Z' {
+        return;
+    }
+    let candidate = format!("{}{}", &path[..path.len() - 1], (last + 1) as char);
+    if resource_cache::get_texture(&candidate).is_some() {
+        log::info!("[probe] vis sibling cached cand={candidate:?}");
+        return;
+    }
+    if let Some((source, offset, size)) = game_data.vfs.pack_location(&candidate) {
+        let submitted = async_decode::submit_prefetch_graph(&candidate, source, offset, size);
+        log::info!("[probe] vis sibling cand={candidate:?} bytes={size} submitted={submitted}");
+    }
 }
 
