+//! Worker-thread entry point for background decoding (GalNX P18).
+
+use core::ffi::c_int;
+
+/// Decodes one queued picture. The frame thread queues large textures in
+/// rfvp::subsystem::resources::async_decode; this runs on the thread main.c starts.
+#[no_mangle]
+pub extern "C" fn rfvp_switch_decode_step() -> c_int {
+    if rfvp::subsystem::resources::async_decode::run_next_job() {
+        1
+    } else {
+        0
+    }
+}
