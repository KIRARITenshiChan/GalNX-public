+fn prefetch_sibling(game_data: &mut GameData, candidate: &str) {
+    use crate::subsystem::resources::{async_decode, resource_cache};
+    if resource_cache::get_texture(candidate).is_some() {
+        log::info!("[probe] sibling cached cand={candidate:?}");
+        return;
+    }
+    match game_data.vfs.pack_location(candidate) {
+        Some((source, offset, size)) => {
+            let submitted = async_decode::submit_prefetch_graph(candidate, source, offset, size);
+            log::info!("[probe] sibling cand={candidate:?} bytes={size} submitted={submitted}");
+        }
+        None => log::info!("[probe] sibling cand={candidate:?} pack_location=None"),
+    }
+}
+
+/// Decode, on the worker thread, the file a scene loads right after this one.
+///
+/// A CG is a pair of backgrounds ("BG062_000" and "BG062_000b") and a character sheet is
+/// followed by its parts differential sheet, so warming those while the frame thread decodes
+/// the current picture turns a burst of 100 ms decodes into one (GalNX P18).
+#[cfg(all(not(feature = "old_school"), feature = "switch-async"))]
+fn prefetch_graph_siblings(game_data: &mut GameData, path: &str) {
+    let lower = path.to_ascii_lowercase();
+    if lower.starts_with("graph_bg/") {
+        if let Some(base) = path.strip_suffix('b') {
+            prefetch_sibling(game_data, base);
+        } else {
+            prefetch_sibling(game_data, &format!("{path}b"));
+        }
+    }
+    if lower.starts_with("graph_bs/") && !path.ends_with("_昞忣") {
+        prefetch_sibling(game_data, &format!("{path}_昞忣"));
+    }
+}
