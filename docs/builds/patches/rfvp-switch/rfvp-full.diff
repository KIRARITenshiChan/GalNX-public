+/// A colour as the shim packs it: R in the low byte, then G, B and A.
+fn pack_color(color: ColorRgba) -> c_uint {
+    let channel = |value: f32| -> c_uint {
+        let scaled = value * 255.0;
+        let rounded = if scaled <= 0.0 {
+            0.0
+        } else if scaled >= 255.0 {
+            255.0
+        } else {
+            scaled + 0.5
+        };
+        rounded as c_uint
+    };
+    channel(color.r) | (channel(color.g) << 8) | (channel(color.b) << 16) | (channel(color.a) << 24)
+}
