+        let in_flight = async_decode::pending_count();
+        let finished = async_decode::take_done();
+        if !finished.is_empty() || in_flight > 0 {
+            log::info!("[async] tick seen={} pending={in_flight}", finished.len());
+        }
+        if finished.is_empty() {
