+
+/// Decode every texture under `folders` whose name starts with one of `prefixes` and cache it.
+///
+/// Returns `(decoded, skipped, decoded_bytes, elapsed_us)`. The boot path calls this for the UI
+/// atlases: opening the pause/save/backlog panel re-executes `GraphLoad` for the whole menu, and a
+/// cold decode inside that frame was a 150-400 ms hitch on the Switch. Pre-decoding during boot
+/// moves that work to the loading screen, where nothing is being drawn yet.
+#[cfg(not(feature = "psx"))]
+pub fn prefetch_graph_textures(
+    vfs: &super::vfs::Vfs,
+    folders: &[&str],
+    prefixes: &[&str],
+    max_entry_bytes: u64,
+    budget_bytes: usize,
+) -> (usize, usize, usize, u64) {
+    let started = crate::perf::start();
+    let paths = vfs.list_by_prefix(folders, prefixes, max_entry_bytes);
+    let mut decoded = 0usize;
+    let mut skipped = 0usize;
+    let mut bytes = 0usize;
+    for path in paths {
+        if bytes >= budget_bytes {
+            break;
+        }
+        if get_texture(&path).is_some() {
+            skipped += 1;
+            continue;
+        }
+        // Reading through the VFS keeps the raw bytes cached too, so a later re-decode is cheap.
+        let Ok(buff) = vfs.read_file(&path) else {
+            skipped += 1;
+            continue;
+        };
+        match super::graph_buff::GraphBuff::decode_texture_image(&path, &buff) {
+            Ok(texture) => {
+                let size = texture.width as usize * texture.height as usize * 4;
+                bytes += size;
+                put_texture(&path, texture, size);
+                decoded += 1;
+            }
+            Err(err) => {
+                skipped += 1;
+                if crate::perf::enabled() {
+                    crate::perf::event(format_args!("[cache] prefetch skip path={path:?}: {err:?}"));
+                }
+            }
+        }
+    }
+    let us = crate::perf::start().saturating_sub(started);
+    (decoded, skipped, bytes, us)
+}
