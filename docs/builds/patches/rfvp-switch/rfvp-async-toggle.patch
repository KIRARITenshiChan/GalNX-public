+/// GalNX P19: runtime switch for the decode worker. The runtime only creates the thread when the
+/// user asks for it (sdmc:/switch/rfvp/async.txt), and it disables async when creation fails.
+/// With it off every submit reports "not queued" and the engine decodes synchronously, which is
+/// the v1.0.5 behaviour that boots on every console.
+#[cfg(feature = "switch-async")]
+fn async_enabled() -> bool {
+    #[cfg(feature = "no_std")]
+    {
+        unsafe { rfvp_switch_async_enabled() != 0 }
+    }
+    #[cfg(not(feature = "no_std"))]
+    {
+        true
+    }
+}
+
+#[cfg(all(feature = "switch-async", feature = "no_std"))]
+extern "C" {
+    /// platform/switch/runtime/main.c: 1 when the worker exists and the user enabled async.
+    fn rfvp_switch_async_enabled() -> core::ffi::c_int;
+}
+
+#[cfg(not(feature = "switch-async"))]
+fn async_enabled() -> bool {
+    false
+}
