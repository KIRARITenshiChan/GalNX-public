 /* Decodes one queued picture (platform/switch/host/src/decode.rs); 1 while work remains. */
 extern int rfvp_switch_decode_step(void);
+
+/* GalNX P19: the decode worker runs only when the user enables it (sdmc:/switch/rfvp/async.txt
+ * holds "on") and only when libnx actually created the thread. v1.0.6 ran it unconditionally and
+ * some consoles stayed black before the first frame; the default is the v1.0.5 synchronous path. */
+int g_rfvp_async_enabled = 0;
+static Result g_rfvp_async_create_rc = 0;
+static Result g_rfvp_async_start_rc = 0;
+static volatile unsigned g_rfvp_async_heartbeat = 0;
+
+int rfvp_switch_async_enabled(void) {
+    return g_rfvp_async_enabled;
+}
+
+static int read_async_enabled(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/async.txt", "r");
+    if (file == NULL) return 0;
+    char line[64];
+    int enabled = 0;
+    if (fgets(line, sizeof(line), file) != NULL) {
+        if (strstr(line, "on") != NULL || strstr(line, "ON") != NULL || strchr(line, '1') != NULL) enabled = 1;
+    }
+    fclose(file);
+    return enabled;
+}
+
+/* Written at start-up and every ~1000 worker iterations, so a hung thread is visible from the SD
+ * card without a debugger. */
+static void write_async_status(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/async_status.txt", "w");
+    if (file == NULL) return;
+    fprintf(file, "enabled=%d create=0x%x start=0x%x hb=%u\n", g_rfvp_async_enabled,
+            (unsigned) g_rfvp_async_create_rc, (unsigned) g_rfvp_async_start_rc,
+            g_rfvp_async_heartbeat);
+    fclose(file);
+}
