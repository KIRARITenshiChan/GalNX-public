+            DecoderError::Io(e) => write!(f, "I/O error: {e}"),
+            DecoderError::InvalidData(m) => write!(f, "Invalid data: {m}"),
+            DecoderError::Unsupported(m) => write!(f, "Unsupported feature: {m}"),
+            DecoderError::EndOfStream => f.write_str("End of stream"),
+        }
+    }
+}
