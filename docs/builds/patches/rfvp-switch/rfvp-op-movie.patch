--- /dev/null
+++ b/crates/na_wmv_player/src/byte_read.rs
@@ -0,0 +1,53 @@
+//! Little-endian primitive readers for the ASF demuxer.
+//!
+//! `byteorder`'s `ReadBytesExt` extension trait is `std`-only, so this module
+//! implements the handful of readers the demuxer needs on top of either
+//! `std::io::Read` (desktop) or the `no_std` `crate::io::Read` shim (Switch).
+//! Call sites keep the `read_u32::<LittleEndian>()` spelling used before.
+
+use byteorder::{ByteOrder, LittleEndian};
+
+use crate::error::Result;
+
+#[cfg(feature = "nostd")]
+use crate::io::Read;
+#[cfg(not(feature = "nostd"))]
+use std::io::Read;
+
+pub trait ReadBytesExt: Read {
+    fn read_u8(&mut self) -> Result<u8> {
+        let mut b = [0u8; 1];
+        self.read_exact(&mut b)?;
+        Ok(b[0])
+    }
+
+    fn read_u16<E: ByteOrder>(&mut self) -> Result<u16> {
+        let mut b = [0u8; 2];
+        self.read_exact(&mut b)?;
+        Ok(E::read_u16(&b))
+    }
+
+    fn read_u32<E: ByteOrder>(&mut self) -> Result<u32> {
+        let mut b = [0u8; 4];
+        self.read_exact(&mut b)?;
+        Ok(E::read_u32(&b))
+    }
+
+    fn read_u64<E: ByteOrder>(&mut self) -> Result<u64> {
+        let mut b = [0u8; 8];
+        self.read_exact(&mut b)?;
+        Ok(E::read_u64(&b))
+    }
+
+    fn read_i32<E: ByteOrder>(&mut self) -> Result<i32> {
+        let mut b = [0u8; 4];
+        self.read_exact(&mut b)?;
+        Ok(E::read_i32(&b))
+    }
+}
+
+impl<R: Read + ?Sized> ReadBytesExt for R {}
+
+// Keep the little-endian marker type re-exported for call sites that spell
+// `read_u32::<LittleEndian>()` without importing `byteorder` themselves.
+// (no public byte-order re-export needed)
