+int rfvp_switch_debug_movie(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/debug.txt", "r");
+    if (file == NULL) return 0;
+    char buf[512] = { 0 };
+    const size_t got = fread(buf, 1, sizeof(buf) - 1, file);
+    fclose(file);
+    buf[got] = '\0';
+    return strstr(buf, "movie=1") != NULL;
+}
