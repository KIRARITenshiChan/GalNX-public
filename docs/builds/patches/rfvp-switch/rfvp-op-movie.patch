diff --git a/crates/na_wmv_player/src/nostd_support.rs b/crates/na_wmv_player/src/nostd_support.rs
new file mode 100644
index 0000000..18c922a
--- /dev/null
+++ b/crates/na_wmv_player/src/nostd_support.rs
@@ -0,0 +1,228 @@
+//! Minimal `std` stand-ins for the `nostd` build (Nintendo Switch / UEFI).
+//!
+//! The ASF demuxer and the video decoders are written against `std::io`,
+//! `std::fmt`, `std::array`, `std::collections` and friends. Instead of
+//! rewriting every module, `src/lib.rs` does `extern crate self as std;` and
+//! re-exports the modules defined here under those names, so the existing
+//! `std::...` paths resolve into this file. This mirrors the shim the rfvp
+//! engine already uses for its Switch port (crates/rfvp/src/lib.rs).
+
+pub mod array {
+    pub use core::array::*;
+}
+
+pub mod fmt {
+    pub use core::fmt::*;
+}
+
+pub mod mem {
+    pub use core::mem::*;
+}
+
+pub mod result {
+    pub use core::result::*;
+}
+
+pub mod slice {
+    pub use core::slice::*;
+}
+
+pub mod str {
+    pub use core::str::*;
+}
+
+pub mod ffi {
+    pub use core::ffi::c_void;
+}
+
+pub mod hash {
+    pub use core::hash::{BuildHasher, Hash, Hasher};
+
+    /// Deterministic FNV-1a hasher.
+    ///
+    /// `std`'s `RandomState` needs OS entropy, which a no_std build does not
+    /// have; the demuxer's frame-assembly map is tiny and local to one stream,
+    /// so a fixed-seed hasher is both sufficient and reproducible.
+    #[derive(Clone, Copy)]
+    pub struct FnvHasher(u64);
+
+    impl Default for FnvHasher {
+        fn default() -> Self {
+            Self(0xcbf2_9ce4_8422_2325)
+        }
+    }
+
+    impl Hasher for FnvHasher {
+        fn finish(&self) -> u64 {
+            self.0
+        }
+
+        fn write(&mut self, bytes: &[u8]) {
+            let mut h = self.0;
+            for &b in bytes {
+                h ^= b as u64;
+                h = h.wrapping_mul(0x0000_0100_0000_01b3);
+            }
+            self.0 = h;
+        }
+    }
+
+    #[derive(Clone, Copy, Default)]
+    pub struct FnvBuildHasher;
+
+    impl BuildHasher for FnvBuildHasher {
+        type Hasher = FnvHasher;
+
+        fn build_hasher(&self) -> FnvHasher {
+            FnvHasher::default()
+        }
+    }
+}
+
+pub mod collections {
+    pub use alloc::collections::VecDeque;
+
+    /// `std::collections::HashMap` stand-in. The decoder only needs a plain
+    /// keyed map, so hashbrown (already in the workspace lock file) provides
+    /// the same API surface without `std`.
+    pub type HashMap<K, V> = hashbrown::HashMap<K, V, crate::hash::FnvBuildHasher>;
+
+    pub mod hash_map {
+        pub use crate::hash::FnvHasher as DefaultHasher;
+    }
+}
+
+pub mod io {
+    //! `std::io` subset: byte-oriented `Read`/`Seek` plus an in-memory `Cursor`.
+    use alloc::vec::Vec;
+    use core::fmt;
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum ErrorKind {
+        UnexpectedEof,
+        Other,
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub struct Error {
+        kind: ErrorKind,
+    }
+
+    impl Error {
+        pub fn new(kind: ErrorKind, _msg: &str) -> Self {
+            Self { kind }
+        }
+
+        pub fn kind(&self) -> ErrorKind {
+            self.kind
+        }
+    }
+
+    impl fmt::Display for Error {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            match self.kind {
+                ErrorKind::UnexpectedEof => f.write_str("failed to fill whole buffer"),
+                ErrorKind::Other => f.write_str("I/O error"),
+            }
+        }
+    }
+
+    impl core::error::Error for Error {}
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub enum SeekFrom {
+        Start(u64),
+        End(i64),
+        Current(i64),
+    }
+
+    pub trait Read {
+        fn read(&mut self, buf: &mut [u8]) -> Result<usize, Error>;
+
+        fn read_exact(&mut self, mut buf: &mut [u8]) -> Result<(), Error> {
+            while !buf.is_empty() {
+                match self.read(buf) {
+                    Ok(0) => {
+                        return Err(Error::new(
+                            ErrorKind::UnexpectedEof,
+                            "failed to fill whole buffer",
+                        ));
+                    }
+                    Ok(n) => buf = &mut buf[n..],
+                    Err(e) => return Err(e),
+                }
+            }
+            Ok(())
+        }
+    }
+
+    pub trait Seek {
+        fn seek(&mut self, pos: SeekFrom) -> Result<u64, Error>;
+
+        /// Matches `std::io::Seek::stream_position`.
+        fn stream_position(&mut self) -> Result<u64, Error> {
+            self.seek(SeekFrom::Current(0))
+        }
+    }
+
+    /// In-memory reader used to decode a movie that was already loaded into RAM.
+    pub struct Cursor<T> {
+        inner: T,
+        pos: usize,
+    }
+
+    impl<T> Cursor<T> {
+        pub fn new(inner: T) -> Self {
+            Self { inner, pos: 0 }
+        }
+
+        pub fn into_inner(self) -> T {
+            self.inner
+        }
+
+        pub fn position(&self) -> u64 {
+            self.pos as u64
+        }
+
+        pub fn set_position(&mut self, pos: u64) {
+            self.pos = pos as usize;
+        }
+    }
+
+    impl Cursor<Vec<u8>> {
+        pub fn len(&self) -> usize {
+            self.inner.len()
+        }
+
+        pub fn is_empty(&self) -> bool {
+            self.inner.is_empty()
+        }
+    }
+
+    impl Read for Cursor<Vec<u8>> {
+        fn read(&mut self, buf: &mut [u8]) -> Result<usize, Error> {
+            let remaining = self.inner.len().saturating_sub(self.pos);
+            let n = remaining.min(buf.len());
+            if n > 0 {
+                buf[..n].copy_from_slice(&self.inner[self.pos..self.pos + n]);
+                self.pos += n;
+            }
+            Ok(n)
+        }
+    }
+
+    impl Seek for Cursor<Vec<u8>> {
+        fn seek(&mut self, pos: SeekFrom) -> Result<u64, Error> {
+            let new = match pos {
+                SeekFrom::Start(p) => p as i64,
+                SeekFrom::End(o) => self.inner.len() as i64 + o,
+                SeekFrom::Current(o) => self.pos as i64 + o,
+            };
+            if new < 0 {
+                return Err(Error::new(ErrorKind::Other, "invalid seek"));
+            }
+            self.pos = new as usize;
+            Ok(self.pos as u64)
+        }
+    }
+}
