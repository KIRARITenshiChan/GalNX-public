--- /dev/null
+++ b/crates/rfvp/src/subsystem/resources/videoplayer/horizon.rs
@@ -0,0 +1,337 @@
+//! Nintendo Switch (no_std) movie backend: ASF/WMV (VC-1/WMV3) video-only playback.
+//!
+//! GalNX P29: the console build has no `std` and no audio decoder for WMA, so the
+//! OP movie has always been skipped ("no movie decoder in this build"). This
+//! backend compiles wmv-decoder with its nostd feature (rfvp switch-video) and
+//! plays the movie video-only; the WMA track is dropped and the rest of the
+//! game audio keeps flowing through the P27 ring buffer.
+//!
+//! Two input paths are used:
+//!
+//! * streaming: the ASF packet reader pulls bytes from the game pack on demand
+//!   through a tiny Read + Seek adapter over PackSource::read_at (movie/01.wmv
+//!   is 244 MiB, far too big for the console heap and far too slow to read whole);
+//! * in memory: a fallback for loose files (Vfs::read_file) when the asset is not
+//!   inside a pack.
+//!
+//! Decoding is soft VC-1 at 1920x1080; it is far below real time, so the player
+//! decodes at most one frame per engine tick and never blocks the frame on the
+//! decoder backlog. The known limitation is documented in
+//! docs/builds/036-rfvp-op-movie.md.
+
+use alloc::boxed::Box;
+use alloc::collections::VecDeque;
+use alloc::vec::Vec;
+
+use anyhow::{anyhow, Result};
+
+use crate::platform_time::Instant;
+
+use wmv_decoder::io::{self as wmv_io, ErrorKind, Read as WmvRead, Seek as WmvSeek, SeekFrom};
+use wmv_decoder::{AsfWmv2Decoder, BytesDecoder, DecodedFrame, yuv420p_to_rgba_scaled};
+
+use super::{MovieFrame, MovieRequest, MovieSource};
+
+#[cfg(feature = "switch-async")]
+use alloc::sync::Arc;
+#[cfg(feature = "switch-async")]
+use crate::subsystem::resources::vfs::PackSource;
+
+/// One decoded frame per engine tick at most: the OP is 1080p VC-1 and decodes
+/// an order of magnitude slower than real time on the console, so anything more
+/// only piles up latency (the first P29 build decoded four frames per tick and
+/// ran the whole app at 2 fps).
+const MAX_DECODE_PER_TICK: usize = 1;
+
+/// Log one line every this many decoded frames (plus the first frame).
+const DECODE_LOG_EVERY: u32 = 30;
+
+struct WmvRgbaFrame {
+    pts_ms: u32,
+    rgba: Vec<u8>,
+}
+
+/// VFS-backed byte reader handed to the ASF demuxer.
+///
+/// The demuxer only needs sequential packet reads plus the occasional seek, so
+/// this adapter turns them into PackSource::read_at calls. It keeps the whole
+/// 244 MiB movie out of memory.
+#[cfg(feature = "switch-async")]
+struct VfsMovieReader {
+    source: Arc<dyn PackSource>,
+    base: u64,
+    len: u64,
+    pos: u64,
+}
+
+#[cfg(feature = "switch-async")]
+impl VfsMovieReader {
+    fn new(source: Arc<dyn PackSource>, base: u64, len: u64) -> Self {
+        Self {
+            source,
+            base,
+            len,
+            pos: 0,
+        }
+    }
+}
+
+#[cfg(feature = "switch-async")]
+impl WmvRead for VfsMovieReader {
+    fn read(&mut self, buf: &mut [u8]) -> core::result::Result<usize, wmv_io::Error> {
+        let remaining = self.len.saturating_sub(self.pos);
+        if remaining == 0 || buf.is_empty() {
+            return Ok(0);
+        }
+        let want = remaining.min(buf.len() as u64) as usize;
+        match self.source.read_at(self.base + self.pos, &mut buf[..want]) {
+            Ok(0) => Ok(0),
+            Ok(n) => {
+                let n = n.min(want);
+                self.pos += n as u64;
+                Ok(n)
+            }
+            Err(_) => Err(wmv_io::Error::new(ErrorKind::Other, "pack read failed")),
+        }
+    }
+}
+
+#[cfg(feature = "switch-async")]
+impl WmvSeek for VfsMovieReader {
+    fn seek(&mut self, pos: SeekFrom) -> core::result::Result<u64, wmv_io::Error> {
+        let target: i128 = match pos {
+            SeekFrom::Start(offset) => offset as i128,
+            SeekFrom::Current(delta) => self.pos as i128 + delta as i128,
+            SeekFrom::End(delta) => self.len as i128 + delta as i128,
+        };
+        if target < 0 || target > self.len as i128 {
+            return Err(wmv_io::Error::new(ErrorKind::Other, "movie seek out of range"));
+        }
+        self.pos = target as u64;
+        Ok(self.pos)
+    }
+}
+
+/// A decoder fed either from the pack (streaming) or from a whole-file buffer.
+enum WmvDecoder {
+    #[cfg(feature = "switch-async")]
+    Stream(AsfWmv2Decoder<VfsMovieReader>),
+    Memory(BytesDecoder),
+}
+
+impl WmvDecoder {
+    fn next_frame(&mut self) -> wmv_decoder::Result<Option<DecodedFrame>> {
+        match self {
+            #[cfg(feature = "switch-async")]
+            WmvDecoder::Stream(dec) => dec.next_frame(),
+            WmvDecoder::Memory(dec) => dec.next_frame(),
+        }
+    }
+}
+
+struct WmvPlayback {
+    dec: WmvDecoder,
+    stash: VecDeque<WmvRgbaFrame>,
+    started_at: Option<Instant>,
+    base_pts_ms: Option<u32>,
+    last_presented_pts_ms: u32,
+    eof: bool,
+    screen_w: u32,
+    screen_h: u32,
+    decoded_frames: u32,
+    presented_frames: u32,
+    last_decode_us: u32,
+}
+
+impl WmvPlayback {
+    fn new(dec: WmvDecoder, screen_w: u32, screen_h: u32) -> Self {
+        Self {
+            dec,
+            stash: VecDeque::new(),
+            started_at: None,
+            base_pts_ms: None,
+            last_presented_pts_ms: u32::MAX,
+            eof: false,
+            screen_w,
+            screen_h,
+            decoded_frames: 0,
+            presented_frames: 0,
+            last_decode_us: 0,
+        }
+    }
+
+    /// Decode at most one frame. Returns true when a frame entered the stash.
+    fn decode_one(&mut self) -> Result<bool> {
+        if self.eof {
+            return Ok(false);
+        }
+        let started = Instant::now();
+        let decoded = self
+            .dec
+            .next_frame()
+            .map_err(|err| anyhow!("WMV next_frame failed: {err}"))?;
+        let Some(frame) = decoded else {
+            self.eof = true;
+            return Ok(false);
+        };
+        let rgba = yuv420p_to_rgba_scaled(&frame.frame, self.screen_w, self.screen_h);
+        self.decoded_frames = self.decoded_frames.saturating_add(1);
+        self.last_decode_us = started.elapsed().as_micros().min(u32::MAX as u128) as u32;
+        if self.decoded_frames == 1 || self.decoded_frames % DECODE_LOG_EVERY == 0 {
+            log::info!(
+                "movie: decoded frame={} pts={} ms {}x{} decode_us={}",
+                self.decoded_frames,
+                frame.pts_ms,
+                self.screen_w,
+                self.screen_h,
+                self.last_decode_us
+            );
+        }
+        self.stash.push_back(WmvRgbaFrame {
+            pts_ms: frame.pts_ms,
+            rgba,
+        });
+        Ok(true)
+    }
+
+    fn next_due_frame(&mut self) -> Result<Option<WmvRgbaFrame>> {
+        // Top the stash up first; MAX_DECODE_PER_TICK keeps the frame thread from
+        // spending several hundred ms per tick inside the decoder.
+        for _ in 0..MAX_DECODE_PER_TICK {
+            if !self.stash.is_empty() || self.eof {
+                break;
+            }
+            self.decode_one()?;
+        }
+
+        if self.started_at.is_none() {
+            if let Some(front) = self.stash.front() {
+                self.started_at = Some(Instant::now());
+                self.base_pts_ms = Some(front.pts_ms);
+            } else {
+                return Ok(None);
+            }
+        }
+
+        let started_at = match self.started_at {
+            Some(started_at) => started_at,
+            None => return Ok(None),
+        };
+        let elapsed_ms = started_at.elapsed().as_millis() as u32;
+        let target_pts_ms = self.base_pts_ms.unwrap_or(0).saturating_add(elapsed_ms);
+        let mut latest_due = None;
+        while let Some(front) = self.stash.front() {
+            if front.pts_ms <= target_pts_ms {
+                latest_due = self.stash.pop_front();
+            } else {
+                break;
+            }
+        }
+        if latest_due.is_some() {
+            self.presented_frames = self.presented_frames.saturating_add(1);
+        }
+        Ok(latest_due)
+    }
+
+    fn is_finished(&mut self) -> Result<bool> {
+        Ok(self.eof && self.stash.is_empty())
+    }
+}
+
+impl MovieSource for WmvPlayback {
+    fn next_frame(&mut self) -> Result<Option<MovieFrame>> {
+        let Some(frame) = self.next_due_frame()? else {
+            return Ok(None);
+        };
+        if frame.pts_ms == self.last_presented_pts_ms {
+            return Ok(None);
+        }
+        self.last_presented_pts_ms = frame.pts_ms;
+        Ok(Some(MovieFrame {
+            rgba: frame.rgba,
+            width: self.screen_w,
+            height: self.screen_h,
+        }))
+    }
+
+    fn is_finished(&mut self) -> Result<bool> {
+        WmvPlayback::is_finished(self)
+    }
+
+    fn stop(self: Box<Self>) {}
+}
+
+/// Open a movie for the Switch (no_std) backend: WMV/ASF only, video only.
+///
+/// The game ships exactly one movie (movie/01.wmv), so MPEG/MP4 support is out
+/// of scope here; those formats fall back to the engine's "no movie decoder"
+/// warning path instead of a panic.
+pub(super) fn open(request: &MovieRequest<'_>) -> Result<Box<dyn MovieSource>> {
+    let name = request.name;
+    let lower = name.to_ascii_lowercase();
+    let is_wmv = lower.ends_with(".wmv") || lower.ends_with(".asf");
+    if !is_wmv {
+        return Err(anyhow!(
+            "no movie decoder for this format in the Switch build: {name}"
+        ));
+    }
+
+    let (w, h) = (request.screen_w, request.screen_h);
+
+    #[cfg(feature = "switch-async")]
+    if let Some((source, offset, size)) = request.vfs.pack_location(name) {
+        let reader = VfsMovieReader::new(source, offset, size);
+        match AsfWmv2Decoder::open(reader) {
+            Ok(dec) => {
+                warn_movie_audio(request);
+                log::info!(
+                    "Movie: opened (Switch WMV video-only, streaming) name={name} bytes={size}"
+                );
+                return Ok(Box::new(WmvPlayback::new(WmvDecoder::Stream(dec), w, h)));
+            }
+            Err(err) => {
+                log::warn!(
+                    "movie: streaming open failed for {name}: {err}; falling back to a whole-file read"
+                );
+            }
+        }
+    }
+
+    let bytes = request
+        .vfs
+        .read_file(name)
+        .map_err(|err| anyhow!("read movie {name}: {err}"))?;
+    warn_movie_audio(request);
+    log::info!(
+        "Movie: opened (Switch WMV video-only, memory) name={name} bytes={}",
+        bytes.len()
+    );
+    let dec = BytesDecoder::open_bytes(bytes).map_err(|err| anyhow!("WMV open failed: {err}"))?;
+    Ok(Box::new(WmvPlayback::new(WmvDecoder::Memory(dec), w, h)))
+}
+
+fn warn_movie_audio(request: &MovieRequest<'_>) {
+    if request.audio.is_some() {
+        log::warn!(
+            "movie audio is not decoded on Switch (no WMA decoder); playing video only: {}",
+            request.name
+        );
+    }
+}
+
+/// GalNX P29 debug-only hook: rfvp_switch_debug_movie() is implemented in
+/// platform/switch/runtime/main.c and returns non-zero when
+/// sdmc:/switch/rfvp/debug.txt contains movie=1. It lets the Citron probe start
+/// the OP without playing through the prologue; shipping builds leave it off.
+#[cfg(target_os = "horizon")]
