+/// GalNX P33 P33_VARIANTS: pre-encoded OP quality variants. The shipped OP is a 1920x1080p VC-1
+/// master re-encoded to 1280x720 WMV2 for the console; software WMV2 decode on the A57 is still
+/// far below 30 fps, so the payload also carries downscaled copies next to the original:
+///
+/// * movie/01_q540.wmv  960x540@29.97  (level 1)
+/// * movie/01_q480.wmv  854x480@24     (level 2, default)
+/// * movie/01_q360.wmv  640x360@24     (level 3)
+///
+/// The level comes from sdmc:/switch/rfvp/video.txt (read by rfvp_switch_movie_quality in
+/// main.c). Level 0, or a missing variant file, keeps playing the original 720p asset, so a
+/// payload without the variants behaves exactly like before.
+fn movie_variant_name(name: &str, level: u8) -> Option<String> {
+    let suffix = match level {
+        1 => "_q540",
+        2 => "_q480",
+        3 => "_q360",
+        _ => return None,
+    };
+    let dot = name.rfind('.')?;
+    let (base, ext) = name.split_at(dot);
+    let ext_lower = ext.to_ascii_lowercase();
+    if ext_lower != ".wmv" && ext_lower != ".asf" {
+        return None;
+    }
+    let mut out = String::with_capacity(name.len() + 5);
+    out.push_str(base);
+    out.push_str(suffix);
+    out.push_str(ext);
+    Some(out)
+}
