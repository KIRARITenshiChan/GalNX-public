+/* GalNX P33: debug-only second trigger. The game itself plays the OP as a layer movie
+ * (flag = nil), which used to mean "no soundtrack". "movie=nil" starts exactly that variant
+ * so the device path (layer movie + Ogg soundtrack) can be checked under Citron. */
+int rfvp_switch_debug_movie_nil(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/debug.txt", "r");
+    if (file == NULL) return 0;
+    char buf[512] = { 0 };
+    const size_t got = fread(buf, 1, sizeof(buf) - 1, file);
+    fclose(file);
+    buf[got] = '\0';
+    return strstr(buf, "movie=nil") != NULL;
+}
+
+
+/* GalNX P33 P33_VARIANTS: OP video quality preset. sdmc:/switch/rfvp/video.txt holds one
+ * keyword and picks which pre-encoded movie variant plays next to the original movie/01.wmv:
+ *   720 | 0 -> 1280x720p30  (original asset, best quality)
+ *   540 | 1 -> 960x540p30
+ *   480 | 2 -> 854x480p24   (default: the OP stays close to real time)
+ *   360 | 3 -> 640x360p24
+ * The soundtrack is unchanged (movie/01.ogg), so only the video decode cost moves. */
+int rfvp_switch_movie_quality(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/video.txt", "r");
+    if (file == NULL) return 2;
+    char line[64] = { 0 };
+    const bool got = fgets(line, sizeof(line), file) != NULL;
+    fclose(file);
+    if (!got) return 2;
+    if (strncmp(line, "720", 3) == 0 || line[0] == '0') return 0;
+    if (strncmp(line, "540", 3) == 0 || line[0] == '1') return 1;
+    if (strncmp(line, "480", 3) == 0 || line[0] == '2') return 2;
+    if (strncmp(line, "360", 3) == 0 || line[0] == '3') return 3;
+    return 2;
+}
 
