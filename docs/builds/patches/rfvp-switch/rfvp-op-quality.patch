+/// Convert a WMV YUV420p frame to packed RGBA8 at the frame's native size.
+///
+/// This is the console path's converter: the Switch build uploads the decoded
+/// 1280x720 frame as a texture and lets the GPU stretch it over the 1920x1080
+/// screen, so the CPU must not resample. Two horizontally adjacent luma samples
+/// share one chroma pair and the loops walk the planes as rows, so there is no
+/// per-pixel division (\`yuv420p_to_rgba_scaled\` spent two integer divisions per
+/// output pixel, which dominated the OP frame time on the device).
+///
+/// \`rgba\` is resized in place, so a caller can hand in an empty Vec and let it
+/// grow once (and, if it wants, reuse the allocation).
+pub fn yuv420p_to_rgba_native_into(frame: &YuvFrame, rgba: &mut Vec<u8>) {
+    let width = frame.width as usize;
+    let height = frame.height as usize;
+    if width == 0 || height == 0 {
+        rgba.clear();
+        return;
+    }
+    let needed = width.saturating_mul(height).saturating_mul(4);
+    if rgba.len() != needed {
+        rgba.clear();
+        rgba.resize(needed, 255);
+    }
+
+    let chroma_width = (width / 2).max(1);
+    let chroma_row_len = (width + 1) / 2;
+    let matrix = VideoTransferMatrix::for_unspecified_source(frame.height);
+
+    for y in 0..height {
+        let luma_start = y * width;
+        let Some(luma_row) = frame.y.get(luma_start..luma_start + width) else {
+            break;
+        };
+        let chroma_start = (y >> 1) * chroma_width;
+        let cb_row = frame
+            .cb
+            .get(chroma_start..chroma_start + chroma_row_len)
+            .unwrap_or(&[]);
+        let cr_row = frame
+            .cr
+            .get(chroma_start..chroma_start + chroma_row_len)
+            .unwrap_or(&[]);
+        let out_start = y * width * 4;
+        let Some(out_row) = rgba.get_mut(out_start..out_start + width * 4) else {
+            break;
+        };
+
+        // Pairs of luma samples sharing one chroma sample.
+        let mut luma_pairs = luma_row.chunks_exact(2);
+        let mut out_chunks = out_row.chunks_exact_mut(8);
+        for (index, (pair, out)) in (&mut luma_pairs).zip(&mut out_chunks).enumerate() {
+            let cb = cb_row.get(index).copied().unwrap_or(128);
+            let cr = cr_row.get(index).copied().unwrap_or(128);
+            let [r0, g0, b0] = yuv_limited_to_rgb(pair[0], cb, cr, matrix);
+            let [r1, g1, b1] = yuv_limited_to_rgb(pair[1], cb, cr, matrix);
+            out[0] = r0;
+            out[1] = g0;
+            out[2] = b0;
+            out[3] = 255;
+            out[4] = r1;
+            out[5] = g1;
+            out[6] = b1;
+            out[7] = 255;
+        }
+
+        // Odd widths leave one luma sample whose partner is out of range.
+        let paired = luma_row.len() & !1;
+        if paired < luma_row.len() {
+            let index = paired >> 1;
+            let cb = cb_row.get(index).copied().unwrap_or(128);
+            let cr = cr_row.get(index).copied().unwrap_or(128);
+            let [r, g, b] = yuv_limited_to_rgb(luma_row[paired], cb, cr, matrix);
+            let out = paired * 4;
+            if let Some(pixel) = out_row.get_mut(out..out + 4) {
+                pixel[0] = r;
+                pixel[1] = g;
+                pixel[2] = b;
+                pixel[3] = 255;
+            }
+        }
+    }
+}
