+/// GalNX P33 P33_VARIANTS: sdmc:/switch/rfvp/video.txt selects the OP quality level
+/// (0=720p original, 1=540p, 2=480p, 3=360p). main.c defaults to 2 when the file is missing,
+/// so a freshly installed NSP plays the OP closer to real time; writing 720 restores the
+/// original asset.
+#[cfg(target_os = "horizon")]
+pub(crate) fn movie_quality_level() -> u8 {
+    extern "C" {
+        fn rfvp_switch_movie_quality() -> core::ffi::c_int;
+    }
+    let level = unsafe { rfvp_switch_movie_quality() };
+    if level < 0 {
+        0
+    } else if level > 3 {
+        3
+    } else {
+        level as u8
+    }
+}
+
+#[cfg(not(target_os = "horizon"))]
+pub(crate) fn movie_quality_level() -> u8 {
+    0
