+/// GalNX P32: the OP soundtrack shipped as an Ogg Vorbis file next to the video.
+/// It is handed to the engine audio backend as an in-memory encoded source; on
+/// the Switch that backend is the command queue drained by the P30 JIT audio
+/// thread, so neither decoding nor mixing happens on the frame thread.
+struct MovieAudio {
+    manager: Arc<AudioManager>,
+    bytes: Arc<[u8]>,
+    /// VFS path of the .ogg file, for logs only.
+    path: String,
+    /// The backend load+play commands were queued.
+    started: bool,
+    /// The backend accepted play; stop/unload are required.
+    playing: bool,
+}
+
+impl MovieAudio {
+    /// Start the soundtrack. Called when the first video frame is presented so
+    /// audio and video start together (same rule as threaded.rs).
+    fn start(&mut self) {
+        if self.started {
+            return;
+        }
+        self.started = true;
+        // The soundtrack is already in memory; the backend does not read game
+        // files for it, so an empty Vfs is enough (as in threaded.rs).
+        let vfs = Vfs::default();
+        let backend = self.manager.backend();
+        let params = AudioParams {
+            volume: 1.0,
+            pan: 0.0,
+            repeat: false,
+        };
+        let result = backend
+            .load(
+                AudioStreamId::MOVIE,
+                &SoundSource::Bytes(self.bytes.clone()),
+                &vfs,
+            )
+            .and_then(|()| backend.play(AudioStreamId::MOVIE, params, Tween::default(), &vfs));
+        match result {
+            Ok(()) => {
+                self.playing = true;
+                log::info!(
+                    "movie audio: playing {} (Ogg Vorbis, {} bytes)",
+                    self.path,
+                    self.bytes.len()
+                );
+            }
+            Err(err) => {
+                log::warn!("movie audio: could not play {}: {err:?}", self.path);
+            }
+        }
+    }
+
+    fn stop(&mut self) {
+        if !self.playing {
+            return;
+        }
+        self.playing = false;
+        let backend = self.manager.backend();
+        backend.stop(AudioStreamId::MOVIE, Tween::default());
+        backend.unload(AudioStreamId::MOVIE);
+        log::info!("movie audio: stopped {}", self.path);
+    }
+}
+
+/// Derive the soundtrack path from the movie path: movie/01.wmv becomes
+/// movie/01.ogg. Returns None for a path without a file name extension.
+fn ogg_sibling(name: &str) -> Option<String> {
+    let slash = name.rfind('/').map(|index| index + 1).unwrap_or(0);
+    let dot = name.rfind('.')?;
+    if dot < slash {
+        return None;
+    }
+    let mut ogg = String::from(&name[..dot]);
+    ogg.push_str(".ogg");
+    Some(ogg)
+}
+
+/// Load the OP soundtrack next to the movie. Failure only disables the music;
+/// the video keeps playing.
+fn load_movie_audio(request: &MovieRequest<'_>) -> Option<MovieAudio> {
+    let manager = request.audio.clone()?;
+    let Some(path) = ogg_sibling(request.name) else {
+        log::warn!(
+            "movie audio: cannot derive an .ogg soundtrack path from {}",
+            request.name
+        );
+        return None;
+    };
+    match request.vfs.read_file(&path) {
+        Ok(bytes) => {
+            log::info!(
+                "movie audio: loaded {} (Ogg Vorbis, {} bytes); queued for the audio thread",
+                path,
+                bytes.len()
+            );
+            Some(MovieAudio {
+                manager,
+                bytes: Arc::from(bytes),
+                path,
+                started: false,
+                playing: false,
+            })
+        }
+        Err(err) => {
+            log::warn!(
+                "movie audio: {} is missing or unreadable ({err}); playing the movie video only",
+                path
+            );
+            None
+        }
+    }
+}
