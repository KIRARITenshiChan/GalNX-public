diff --git a/crates/rfvp/src/subsystem/resources/resource_cache.rs b/crates/rfvp/src/subsystem/resources/resource_cache.rs
new file mode 100644
index 0000000..d2338c7
--- /dev/null
+++ b/crates/rfvp/src/subsystem/resources/resource_cache.rs
@@ -0,0 +1,255 @@
+//! Runtime caches for decoded textures and raw file bytes (GalNX P17).
+//!
+//! The game re-loads the same assets constantly: every time the pause/save/backlog UI opens it
+//! re-executes `GraphLoad` for the whole menu atlas, CG expression switches re-load the same
+//! `graph_bs/CHR_*` files, and every sound play re-reads the `.wav`/`.ogg` payload. Without a
+//! cache each of those pays the full SD read plus NVSG/zlib decode, which showed up as 150-1400 ms
+//! stalls on the Switch.
+//!
+//! The caches are process-global, bounded by byte budget, and use a simple LRU order. They are
+//! purely derived data: evicting an entry only costs a re-read/re-decode, never correctness.
+
+use alloc::collections::{BTreeMap, VecDeque};
+use alloc::string::{String, ToString};
+use alloc::sync::Arc;
+use alloc::vec::Vec;
+
+use image::DynamicImage;
+
+use crate::subsystem::resources::texture::NvsgTexture;
+
+/// Budget for decoded `GraphLoad` images (the largest single consumer).
+const TEXTURE_BUDGET: usize = 160 * 1024 * 1024;
+/// Budget for decoded `PartsLoad` textures (CG expression sheets).
+const PARTS_BUDGET: usize = 48 * 1024 * 1024;
+/// Budget for raw file bytes (audio, scripts, and the bytes feed of the decoders above).
+const BYTES_BUDGET: usize = 192 * 1024 * 1024;
+/// Never cache a single entry larger than this (bytes).
+const MAX_ENTRY_BYTES: usize = 16 * 1024 * 1024;
+
+/// A decoded `GraphLoad` texture plus the metadata `load_texture` would have set.
+#[derive(Clone)]
+pub struct DecodedTexture {
+    pub image: Arc<DynamicImage>,
+    pub width: u16,
+    pub height: u16,
+    pub offset_x: u16,
+    pub offset_y: u16,
+    pub u: u16,
+    pub v: u16,
+}
+
+struct Lru<K, V> {
+    map: BTreeMap<K, (V, usize)>,
+    order: VecDeque<K>,
+    bytes: usize,
+    budget: usize,
+}
+
+impl<K: Ord + Clone, V> Lru<K, V> {
+    const fn new(budget: usize) -> Self {
+        Self {
+            map: BTreeMap::new(),
+            order: VecDeque::new(),
+            bytes: 0,
+            budget,
+        }
+    }
+
+    fn get(&mut self, key: &K) -> Option<&V> {
+        if !self.map.contains_key(key) {
+            return None;
+        }
+        self.touch(key);
+        self.map.get(key).map(|(value, _)| value)
+    }
+
+    fn touch(&mut self, key: &K) {
+        if let Some(pos) = self.order.iter().position(|k| k == key) {
+            self.order.remove(pos);
+        }
+        self.order.push_back(key.clone());
+    }
+
+    fn put(&mut self, key: K, value: V, size: usize) {
+        if size > MAX_ENTRY_BYTES {
+            return;
+        }
+        if let Some((_, old)) = self.map.remove(&key) {
+            self.bytes = self.bytes.saturating_sub(old);
+        }
+        self.map.insert(key.clone(), (value, size));
+        self.bytes += size;
+        self.touch(&key);
+        while self.bytes > self.budget {
+            let Some(victim) = self.order.pop_front() else {
+                break;
+            };
+            if let Some((_, old)) = self.map.remove(&victim) {
+                self.bytes = self.bytes.saturating_sub(old);
+            }
+        }
+    }
+
+    fn clear(&mut self) {
+        self.map.clear();
+        self.order.clear();
+        self.bytes = 0;
+    }
+}
+
+struct Caches {
+    textures: Lru<String, DecodedTexture>,
+    parts: Lru<String, Arc<NvsgTexture>>,
+    bytes: Lru<String, Arc<[u8]>>,
+}
+
+static CACHES: spin::Mutex<Option<Caches>> = spin::Mutex::new(None);
+
+fn with_caches<R>(f: impl FnOnce(&mut Caches) -> R) -> R {
+    let mut guard = CACHES.lock();
+    if guard.is_none() {
+        *guard = Some(Caches {
+            textures: Lru::new(TEXTURE_BUDGET),
+            parts: Lru::new(PARTS_BUDGET),
+            bytes: Lru::new(BYTES_BUDGET),
+        });
+    }
+    f(guard.as_mut().expect("caches initialized"))
+}
+
+/// Cache key: the game addresses assets case-insensitively with either slash.
+pub fn key(path: &str) -> String {
+    let trimmed = path.trim_start_matches("./").replace('\\', "/");
+    trimmed.trim_start_matches('/').to_ascii_lowercase()
+}
+
+pub fn get_texture(path: &str) -> Option<DecodedTexture> {
+    let key = key(path);
+    with_caches(|c| c.textures.get(&key).cloned())
+}
+
+pub fn put_texture(path: &str, entry: DecodedTexture, size: usize) {
+    let key = key(path);
+    with_caches(|c| {
+        c.textures.put(key, entry, size);
+        if crate::perf::enabled() {
+            let (bytes, budget) = (c.textures.bytes, c.textures.budget);
+            crate::perf::event(format_args!("[cache] texture put size={size} total={bytes}/{budget}"));
+        }
+    });
+}
+
+pub fn get_parts(path: &str) -> Option<Arc<NvsgTexture>> {
+    let key = key(path);
+    with_caches(|c| c.parts.get(&key).cloned())
+}
+
+pub fn put_parts(path: &str, texture: Arc<NvsgTexture>, size: usize) {
+    let key = key(path);
+    with_caches(|c| {
+        c.parts.put(key, texture, size);
+        if crate::perf::enabled() {
+            let (bytes, budget) = (c.parts.bytes, c.parts.budget);
+            crate::perf::event(format_args!("[cache] parts put size={size} total={bytes}/{budget}"));
+        }
+    });
+}
+
+pub fn get_bytes(path: &str) -> Option<Arc<[u8]>> {
+    let key = key(path);
+    with_caches(|c| c.bytes.get(&key).cloned())
+}
+
+pub fn put_bytes(path: &str, bytes: &[u8]) {
+    let key = key(path);
+    with_caches(|c| {
+        let size = bytes.len();
+        if size > MAX_ENTRY_BYTES {
+            return;
+        }
+        c.bytes.put(key, Arc::from(bytes), size);
+        if crate::perf::enabled() {
+            let (total, budget) = (c.bytes.bytes, c.bytes.budget);
+            crate::perf::event(format_args!("[cache] bytes put size={size} total={total}/{budget}"));
+        }
+    });
+}
+
+/// Human readable sizes, used by the debug report.
+pub fn report() -> String {
+    with_caches(|c| {
+        alloc::format!(
+            "textures {}/{} B entries={} parts {}/{} B entries={} bytes {}/{} B entries={}",
+            c.textures.bytes,
+            c.textures.budget,
+            c.textures.map.len(),
+            c.parts.bytes,
+            c.parts.budget,
+            c.parts.map.len(),
+            c.bytes.bytes,
+            c.bytes.budget,
+            c.bytes.map.len()
+        )
+    })
+}
+
+/// Drop every cache (used when a new game is loaded).
+pub fn clear() {
+    with_caches(|c| {
+        c.textures.clear();
+        c.parts.clear();
+        c.bytes.clear();
+    });
+}
+
+/// Decode every texture under `folders` whose name starts with one of `prefixes` and cache it.
+///
+/// Returns `(decoded, skipped, decoded_bytes, elapsed_us)`. The boot path calls this for the UI
+/// atlases: opening the pause/save/backlog panel re-executes `GraphLoad` for the whole menu, and a
+/// cold decode inside that frame was a 150-400 ms hitch on the Switch. Pre-decoding during boot
+/// moves that work to the loading screen, where nothing is being drawn yet.
+#[cfg(not(feature = "psx"))]
+pub fn prefetch_graph_textures(
+    vfs: &super::vfs::Vfs,
+    folders: &[&str],
+    prefixes: &[&str],
+    max_entry_bytes: u64,
+    budget_bytes: usize,
+) -> (usize, usize, usize, u64) {
+    let started = crate::perf::start();
+    let paths = vfs.list_by_prefix(folders, prefixes, max_entry_bytes);
+    let mut decoded = 0usize;
+    let mut skipped = 0usize;
+    let mut bytes = 0usize;
+    for path in paths {
+        if bytes >= budget_bytes {
+            break;
+        }
+        if get_texture(&path).is_some() {
+            skipped += 1;
+            continue;
+        }
+        // Reading through the VFS keeps the raw bytes cached too, so a later re-decode is cheap.
+        let Ok(buff) = vfs.read_file(&path) else {
+            skipped += 1;
+            continue;
+        };
+        match super::graph_buff::GraphBuff::decode_texture_image(&path, &buff) {
+            Ok(texture) => {
+                let size = texture.width as usize * texture.height as usize * 4;
+                bytes += size;
+                put_texture(&path, texture, size);
+                decoded += 1;
+            }
+            Err(err) => {
+                skipped += 1;
+                if crate::perf::enabled() {
+                    crate::perf::event(format_args!("[cache] prefetch skip path={path:?}: {err:?}"));
+                }
+            }
+        }
+    }
+    let us = crate::perf::start().saturating_sub(started);
+    (decoded, skipped, bytes, us)
+}
