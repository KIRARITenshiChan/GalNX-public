diff --git a/crates/rfvp/src/subsystem/resources/async_decode.rs b/crates/rfvp/src/subsystem/resources/async_decode.rs
new file mode 100644
index 0000000..2220864
--- /dev/null
+++ b/crates/rfvp/src/subsystem/resources/async_decode.rs
@@ -0,0 +1,338 @@
+//! Background decoding for the Nintendo Switch port (GalNX P18).
+//!
+//! A CG background is a 2400x1350 NVSG picture: roughly 13 MB of RGBA to inflate and convert.
+//! On the console that costs 80-160 ms per picture, and entering a CG loads two backgrounds plus
+//! a character sheet, so the frame thread (and the audio with it) stalled for 0.3-0.9 s.
+//!
+//! Large pictures are now queued here instead: the frame thread keeps drawing the previous
+//! texture, a worker thread started by the C runtime (platform/switch/runtime/main.c) reads the
+//! pack bytes and decodes them into the process caches, and the next tick applies the result.
+//! Small assets are decoded inline; they cost a few milliseconds and the game draws them at once.
+
+#[cfg(feature = "no_std")]
+use alloc::{
+    collections::VecDeque,
+    format,
+    string::{String, ToString},
+    sync::Arc,
+    vec,
+    vec::Vec,
+};
+use anyhow::{anyhow, Result};
+
+use super::graph_buff::GraphBuff;
+use super::resource_cache;
+use super::texture::{NvsgTexture, TextureType};
+use super::vfs::PackSource;
+
+/// A queued GraphLoad.
+pub const KIND_GRAPH: u8 = 0;
+/// A queued PartsLoad.
+pub const KIND_PARTS: u8 = 1;
+/// A speculative prefetch of a GraphLoad the scene is likely to issue next.
+pub const KIND_GRAPH_PREFETCH: u8 = 2;
+
+/// Assets at least this large are decoded on the worker thread.
+pub const ASYNC_MIN_BYTES: u64 = 384 * 1024;
+
+/// Pictures at least this large are loaded asynchronously: the frame thread keeps drawing the
+/// previous texture instead of inflating the new one (GalNX P18).
+pub const ASYNC_INLINE_MIN_BYTES: u64 = 1024 * 1024;
+
+struct Job {
+    kind: u8,
+    id: u16,
+    path: String,
+    source: Arc<dyn PackSource>,
+    offset: u64,
+    size: u64,
+}
+
+/// A finished (or failed) job, reported to the frame thread by take_done.
+pub struct Done {
+    pub kind: u8,
+    pub id: u16,
+    pub path: String,
+    pub ok: bool,
+    pub us: u64,
+}
+
+static QUEUE: spin::Mutex<VecDeque<Job>> = spin::Mutex::new(VecDeque::new());
+static DONE: spin::Mutex<Vec<Done>> = spin::Mutex::new(Vec::new());
+/// The jobs still in flight, so the engine does not queue the same load twice.
+static PENDING: spin::Mutex<Vec<(u8, u16, String)>> = spin::Mutex::new(Vec::new());
+
+/// The path each graph/parts id last asked for. A finished inline-async job is applied only
+/// while this still matches, so a texture never lands on an id the script already reassigned.
+static REQUESTED: spin::Mutex<Vec<(u8, u16, String)>> = spin::Mutex::new(Vec::new());
+
+fn is_pending(kind: u8, id: u16, path: &str) -> bool {
+    PENDING
+        .lock()
+        .iter()
+        .any(|(k, i, p)| *k == kind && *i == id && p == path)
+}
+
+fn set_requested(kind: u8, id: u16, path: &str) {
+    let mut req = REQUESTED.lock();
+    req.retain(|(k, i, _)| !(*k == kind && *i == id));
+    req.push((kind, id, path.to_string()));
+}
+
+/// True while `id` still wants `path` (the picture the worker decoded is still the right one).
+pub fn requested_matches(kind: u8, id: u16, path: &str) -> bool {
+    REQUESTED
+        .lock()
+        .iter()
+        .any(|(k, i, p)| *k == kind && *i == id && p == path)
+}
+
+/// Forget the pending request for `id` (applied, or superseded by a synchronous load).
+pub fn clear_requested(kind: u8, id: u16) {
+    REQUESTED.lock().retain(|(k, i, _)| !(*k == kind && *i == id));
+}
+
+fn push(kind: u8, id: u16, path: &str, source: Arc<dyn PackSource>, offset: u64, size: u64) {
+    PENDING.lock().push((kind, id, path.to_string()));
+    QUEUE.lock().push_back(Job {
+        kind,
+        id,
+        path: path.to_string(),
+        source,
+        offset,
+        size,
+    });
+}
+
+/// Queue a large GraphLoad. Returns true when the frame thread should keep the previous
+/// texture and let the worker decode this file.
+pub fn submit_graph(
+    id: u16,
+    path: &str,
+    source: Arc<dyn PackSource>,
+    offset: u64,
+    size: u64,
+) -> bool {
+    if size < ASYNC_MIN_BYTES || resource_cache::get_texture(path).is_some() {
+        return false;
+    }
+    if is_pending(KIND_GRAPH, id, path) {
+        return true;
+    }
+    set_requested(KIND_GRAPH, id, path);
+    log::info!("[async] submit graph id={id} path={path:?} bytes={size}");
+    push(KIND_GRAPH, id, path, source, offset, size);
+    true
+}
+
+/// Queue a large PartsLoad; see submit_graph.
+pub fn submit_parts(
+    id: u16,
+    path: &str,
+    source: Arc<dyn PackSource>,
+    offset: u64,
+    size: u64,
+) -> bool {
+    if size < ASYNC_MIN_BYTES || resource_cache::get_parts(path).is_some() {
+        return false;
+    }
+    if is_pending(KIND_PARTS, id, path) {
+        return true;
+    }
+    set_requested(KIND_PARTS, id, path);
+    log::info!("[async] submit parts id={id} path={path:?} bytes={size}");
+    push(KIND_PARTS, id, path, source, offset, size);
+    true
+}
+
+/// The jobs finished since the last call.
+pub fn take_done() -> Vec<Done> {
+    core::mem::take(&mut *DONE.lock())
+}
+
+/// The number of jobs still queued or running.
+pub fn pending_count() -> usize {
+    PENDING.lock().len()
+}
+
+fn is_pending_path(kind: u8, path: &str) -> bool {
+    PENDING.lock().iter().any(|(k, _, p)| *k == kind && p == path)
+}
+
+/// Sleep a little while the frame thread waits for a worker result.
+fn idle_wait() {
+    #[cfg(feature = "no_std")]
+    unsafe {
+        svcSleepThread(1_000_000);
+    }
+    #[cfg(not(feature = "no_std"))]
+    std::thread::sleep(core::time::Duration::from_millis(1));
+}
+
+#[cfg(feature = "no_std")]
+extern "C" {
+    fn svcSleepThread(ns: i64);
+}
+
+/// Wait (up to `max_ms`) for a graph texture that a worker is decoding.
+///
+/// Returns true when the texture is in the cache and the frame thread can apply it without
+/// decoding anything. Returns immediately when no job for this path is in flight.
+pub fn wait_for_graph(path: &str, max_ms: u32) -> bool {
+    for _ in 0..max_ms {
+        if resource_cache::get_texture(path).is_some() {
+            return true;
+        }
+        if !is_pending_path(KIND_GRAPH, path) && !is_pending_path(KIND_GRAPH_PREFETCH, path) {
+            return resource_cache::get_texture(path).is_some();
+        }
+        idle_wait();
+    }
+    resource_cache::get_texture(path).is_some()
+}
+
+/// Wait (up to `max_ms`) for a parts sheet that a worker is decoding.
+pub fn wait_for_parts(path: &str, max_ms: u32) -> bool {
+    for _ in 0..max_ms {
+        if resource_cache::get_parts(path).is_some() {
+            return true;
+        }
+        if !is_pending_path(KIND_PARTS, path) {
+            return resource_cache::get_parts(path).is_some();
+        }
+        idle_wait();
+    }
+    resource_cache::get_parts(path).is_some()
+}
+
+/// Queue a speculative decode for an asset the scene is likely to load next.
+///
+/// The result is only put into the texture cache; no engine texture is touched, so a wrong
+/// guess costs a little memory and CPU but never changes what is on screen.
+/// Prefetch the sibling of a texture path that was just loaded synchronously
+/// (used by save-state restore, which bypasses graph_load/parts_load).
+///
+/// Pairs that the IROSEKA art assets use:
+/// - `graph_bg/X` <-> `graph_bg/Xb` (base / layered variant)
+/// - `graph_bs/SHEET` -> `graph_bs/SHEET_昞忣` (expression parts sheet)
+pub fn prefetch_path(vfs: &super::vfs::Vfs, path: &str) {
+    if path.is_empty() {
+        return;
+    }
+    let lower = path.to_ascii_lowercase();
+    let candidate = if lower.contains("_昞忣") {
+        None
+    } else if lower.contains("graph_bg/") {
+        if lower.ends_with('b') && path.len() > 1 {
+            Some(path[..path.len() - 1].to_string())
+        } else {
+            Some(alloc::format!("{path}b"))
+        }
+    } else if lower.contains("graph_bs/") {
+        Some(alloc::format!("{path}_昞忣"))
+    } else {
+        None
+    };
+    let Some(candidate) = candidate else { return };
+    if super::resource_cache::get_texture(&candidate).is_some() {
+        return;
+    }
+    if let Some((source, offset, size)) = vfs.pack_location(&candidate) {
+        submit_prefetch_graph(&candidate, source, offset, size);
+    }
+}
+
+pub fn submit_prefetch_graph(
+    path: &str,
+    source: Arc<dyn PackSource>,
+    offset: u64,
+    size: u64,
+) -> bool {
+    if size < ASYNC_MIN_BYTES || resource_cache::get_texture(path).is_some() {
+        return false;
+    }
+    if is_pending_path(KIND_GRAPH_PREFETCH, path) || is_pending_path(KIND_GRAPH, path) {
+        return false;
+    }
+    log::info!("[async] prefetch graph path={path:?} bytes={size}");
+    push(KIND_GRAPH_PREFETCH, u16::MAX, path, source, offset, size);
+    true
+}
+
+fn read_bytes(job: &Job) -> Result<Vec<u8>> {
+    let size = usize::try_from(job.size).map_err(|_| anyhow!("entry too large"))?;
+    let mut out = vec![0u8; size];
+    let mut done = 0usize;
+    while done < out.len() {
+        let n = job
+            .source
+            .read_at(job.offset + done as u64, &mut out[done..])?;
+        if n == 0 {
+            return Err(anyhow!("short read at {} of {}", done, out.len()));
+        }
+        done += n;
+    }
+    Ok(out)
+}
+
+fn decode(job: &Job, bytes: &[u8]) -> Result<()> {
+    match job.kind {
+        KIND_GRAPH | KIND_GRAPH_PREFETCH => {
+            let entry = GraphBuff::decode_texture_image(&job.path, bytes)?;
+            let pixels = entry.width as usize * entry.height as usize * 4;
+            resource_cache::put_texture(&job.path, entry, pixels);
+            Ok(())
+        }
+        KIND_PARTS => {
+            let mut texture = NvsgTexture::new(&job.path);
+            texture.read_texture(bytes, |typ| typ == TextureType::Multi32Bit)?;
+            texture.set_name(&job.path);
+            let decoded = texture.cache_size_hint();
+            resource_cache::put_parts(&job.path, Arc::new(texture), decoded);
+            Ok(())
+        }
+        _ => Err(anyhow!("unknown job kind {}", job.kind)),
+    }
+}
+
+/// Decode one queued job on the worker thread; returns false when the queue is empty.
+pub fn run_next_job() -> bool {
+    let job = match QUEUE.lock().pop_front() {
+        Some(job) => job,
+        None => return false,
+    };
+    let started = crate::perf::start();
+    let result = read_bytes(&job).and_then(|bytes| decode(&job, &bytes));
+    let us = crate::perf::start().saturating_sub(started);
+    let ok = match &result {
+        Ok(()) => true,
+        Err(err) => {
+            log::warn!("[async] decode failed path={:?}: {err:#}", job.path);
+            false
+        }
+    };
+    PENDING
+        .lock()
+        .retain(|(kind, id, path)| !(*kind == job.kind && *id == job.id && path == &job.path));
+    log::info!(
+        "[async] decoded {:?} id={} bytes={} us={} ok={}",
+        job.path,
+        job.id,
+        job.size,
+        us,
+        ok
+    );
+    let queued_done = {
+        let mut done = DONE.lock();
+        done.push(Done {
+            kind: job.kind,
+            id: job.id,
+            path: job.path,
+            ok,
+            us,
+        });
+        done.len()
+    };
+    log::info!("[async] done pushed kind={} id={} total={queued_done}", job.kind, job.id);
+    true
+}
