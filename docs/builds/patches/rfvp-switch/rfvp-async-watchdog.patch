+/// True when the worker has left jobs in flight for too long without finishing any (GalNX P20).
+///
+/// The frame thread calls this once per tick. A healthy worker finishes a 13 MB picture in
+/// 160 ms, so three seconds without progress means it is wedged on something an emulator does
+/// not reproduce; the engine then decodes the queue on the frame thread instead of freezing.
+pub fn watchdog_stalled() -> bool {
+    if !async_enabled() {
+        return false;
+    }
+    let pending = pending_count();
+    if pending == 0 {
+        *WATCH_PENDING.lock() = None;
+        return false;
+    }
+    let now = crate::perf::start();
+    let mut watch = WATCH_PENDING.lock();
+    match *watch {
+        Some((count, since)) if count == pending => now.saturating_sub(since) > WATCHDOG_STALL_US,
+        _ => {
+            *watch = Some((pending, now));
+            false
+        }
+    }
+}
