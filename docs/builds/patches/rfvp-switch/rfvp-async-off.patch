+/* GalNX v1.0.9: optional frame heartbeat. When sdmc:/switch/rfvp/debug.txt exists the frame
+ * thread rewrites frame_status.txt every few frames, so a hang still leaves the last frame number
+ * on the card even if the per-second report never completes. */
+static int debug_probe_enabled(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/debug.txt", "r");
+    if (file == NULL) return 0;
+    fclose(file);
+    return 1;
+}
+
+static void write_frame_status(unsigned frame, int status) {
+    FILE* file = fopen("sdmc:/switch/rfvp/frame_status.txt", "w");
+    if (file == NULL) return;
+    fprintf(file, "frame=%u status=%d async=%d\n", frame, status, g_rfvp_async_enabled);
+    fclose(file);
+}
