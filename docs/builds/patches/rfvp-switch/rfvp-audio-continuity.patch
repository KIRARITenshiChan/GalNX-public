+            atomic_store_explicit(&audio_ring_read, consumed, memory_order_release);
+            atomic_fetch_add_explicit(&audio_consumed_frames,
+                                      (uint64_t) refilled * AudioBufferFrames,
+                                      memory_order_relaxed);
