+/* Frame thread: keep the ring topped up; the audio thread drains it on its own schedule. */
+static void audio_pump(void* app) {
+    if (!audio_driver_ready) return;
+    if (g_audio_thread_started) {
+        audio_render_pages(app, AudioProducePagesPerFrame);
+        return;
+    }
+    audio_pump_direct(app);
