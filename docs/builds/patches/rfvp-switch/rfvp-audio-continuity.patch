+/* GalNX P27: prime the ring, then hand playback to its own thread. Core 2 keeps it off the frame
+ * thread's core 0 and the decode worker's core 1; prio 0x2D is above the worker's 0x30 and below
+ * the frame thread's 0x2C, so a long audio mix can never outrank the frame thread, and the thread
+ * only sleeps, copies 4 KiB and issues audrvUpdate(). Thread creation can fail on the console's
+ * small thread allowance: then audio_pump() keeps the pre-P27 direct path and the game still has
+ * audio, it just does not survive a long frame. */
+static void start_audio_thread(void* app) {
+    if (!audio_driver_ready) return;
+    audio_render_pages(app, AudioPrimePages);
+    FILE* truncate = fopen("sdmc:/switch/rfvp/audio_stall.txt", "w");
+    if (truncate != NULL) fclose(truncate);
+    static const int cpus[] = { 2, 1, -2 };
+    Result rc = 0;
+    for (unsigned i = 0; i < sizeof(cpus) / sizeof(cpus[0]); ++i) {
+        rc = threadCreate(&g_audio_thread, rfvp_audio_thread, NULL, NULL, 0x10000, 0x2D, cpus[i]);
+        if (R_FAILED(rc)) continue;
+        rc = threadStart(&g_audio_thread);
+        if (R_FAILED(rc)) continue;
+        g_audio_thread_cpu = cpus[i];
+        g_audio_thread_started = 1;
+        audio_write_status();
+        char message[128];
+        int len = snprintf(message, sizeof(message),
+                           "rfvp: audio thread cpu=%d ring=%d frames prio=0x2d\n",
+                           g_audio_thread_cpu, AudioRingFrames);
+        rfvp_switch_log(message, (size_t) len);
+        return;
+    }
+    log_result("audio thread", rc);
+    g_audio_thread_cpu = -2;
+    audio_write_status();
+}
