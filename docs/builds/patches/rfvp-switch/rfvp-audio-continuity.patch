+/* GalNX P27: the audio thread. It never touches the rfvp Session; it only moves PCM the frame
+ * thread already rendered out of the ring and into the six wave buffers, then commits them. The
+ * frame thread may be stuck inside a multi-second SD read: with three seconds of PCM queued the
+ * device keeps playing past it. Four milliseconds is shorter than the ~21 ms one page lasts, so a
+ * free buffer is noticed and refilled long before it is needed. */
+static void rfvp_audio_thread(void* arg) {
+    (void) arg;
+    g_audio_thread_alive = 1;
+    unsigned logged_underruns = 0;
+    uint64_t last_refresh_us = 0;
+    for (;;) {
+        if (g_audio_thread_stop) break;
+        if (!audio_driver_ready) {
+            svcSleepThread(20000000ULL); /* 20 ms */
+            continue;
+        }
+        const uint64_t now = rfvp_switch_ticks_us();
+        /* Audren reports a finished wave buffer only through audrvUpdate(): its state field is
+         * filled in by that call. Without a periodic update a buffer we queued once stays
+         * "queued" forever, we never see it free again and the ring stops draining. One update
+         * per ~20 ms (about the length of one page) is enough to keep all six buffers turning and
+         * keeps the audren IPC cost off the frame thread. */
+        if (last_refresh_us == 0 || now - last_refresh_us >= 20000ULL) {
+            audrvUpdate(&audio_driver);
+            last_refresh_us = now;
+        }
+        const uint64_t read = atomic_load_explicit(&audio_ring_read, memory_order_relaxed);
+        const uint64_t write = atomic_load_explicit(&audio_ring_write, memory_order_acquire);
+        const uint64_t available = write - read;
+        unsigned refilled = 0;
+        int needed = 0;
+        for (unsigned i = 0; i < AudioBufferCount; ++i) {
+            AudioDriverWaveBuf* wavebuf = &audio_wavebufs[i];
+            if (wavebuf->state != AudioDriverWaveBufState_Free &&
+                wavebuf->state != AudioDriverWaveBufState_Done) {
+                continue;
+            }
+            needed = 1;
+            if (available < ((uint64_t) refilled + 1) * AudioBufferFrames) continue;
+            const uint64_t frame = read + (uint64_t) refilled * AudioBufferFrames;
+            memcpy(audio_buffers[i], &audio_ring[(size_t) (frame % AudioRingFrames) * 2],
+                   sizeof(audio_buffers[i]));
+            armDCacheFlush(audio_buffers[i], sizeof(audio_buffers[i]));
+            wavebuf->data_raw = audio_buffers[i];
+            wavebuf->size = sizeof(audio_buffers[i]);
+            wavebuf->start_sample_offset = 0;
+            wavebuf->end_sample_offset = AudioBufferFrames;
+            wavebuf->is_looping = false;
