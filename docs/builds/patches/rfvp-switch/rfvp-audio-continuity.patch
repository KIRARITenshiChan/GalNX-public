+ * AudioStallEveryFrames frames up to AudioStallMaxCount times). */
+static unsigned read_debug_stall_ms(void) {
+    FILE* file = fopen("sdmc:/switch/rfvp/debug.txt", "r");
+    if (file == NULL) return 0;
+    char line[128];
+    unsigned ms = 0;
+    while (fgets(line, sizeof(line), file)) {
+        unsigned value;
+        if (sscanf(line, "stall=%u", &value) == 1) ms = value;
+        if (sscanf(line, "stall_at=%u", &value) == 1) g_audio_stall_at = value;
+    }
+    fclose(file);
+    if (ms > AudioStallMaxMs) ms = AudioStallMaxMs;
+    if (g_audio_stall_at < 300u) g_audio_stall_at = 300u;
+    if (g_audio_stall_at > 60000u) g_audio_stall_at = 60000u;
+    return ms;
+}
