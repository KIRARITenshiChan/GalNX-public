 {
+#ifdef __SWITCH__
+	{
+		// GALNX: TVPPreNormalizeStorageName wraps native Switch paths (romfs:/..., sdmc:/...)
+		// as file://?/<native>. Strip the "?/" marker so the native path reaches stat()/fopen().
+		tjs_string galnx_wname(name.AsStdString());
+		std::string galnx_nname;
+		if (TVPUtf16ToUtf8(galnx_nname, galnx_wname) && galnx_nname.size() >= 2 && galnx_nname[0] == (char)63 && galnx_nname[1] == (char)47)
+		{
+			tjs_string galnx_sub = galnx_wname.substr(2);
+			name = ttstr(galnx_sub);
+			return;
+		}
+	}
+#endif
 #ifdef _WIN32
 	ttstr newname;
 
