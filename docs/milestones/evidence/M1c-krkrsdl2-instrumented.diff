index 5c16a31..47b38c3 100644
--- a/src/core/sdl2/SDLApplication.cpp
+++ b/src/core/sdl2/SDLApplication.cpp
@@ -43,6 +43,55 @@
 
 #ifdef __SWITCH__
 #include <switch.h>
+#include <stdio.h>
+
+/* GALNX-DIAG: temporary instrumentation for Citron/Ryujinx smoke tests. */
+extern "C" void GXDiag(const char *msg)
+{
+	FILE *f = fopen("sdmc:/galnx-diag.txt", "a");
+	if (!f) return;
+	fprintf(f, "%s\n", msg);
+	fflush(f);
+	fclose(f);
+}
+
+extern "C" void GXDiagW(const unsigned short *s)
+{
+	if (!s) return;
+	char buf[2048];
+	int n = 0;
+	for (; *s && n < 2000; ++s)
+	{
+		unsigned int c = *s;
+		if (c < 0x80) buf[n++] = (char)c;
+		else if (c < 0x800) { buf[n++] = (char)(0xC0 | (c >> 6)); buf[n++] = (char)(0x80 | (c & 0x3F)); }
+		else { buf[n++] = (char)(0xE0 | (c >> 12)); buf[n++] = (char)(0x80 | ((c >> 6) & 0x3F)); buf[n++] = (char)(0x80 | (c & 0x3F)); }
+	}
+	buf[n] = 0;
+	GXDiag(buf);
+}
+
+extern "C" void GXDiagRomfs(void)
+{
+	char buf[256];
+	FILE *f = fopen("romfs:/data.xp3", "rb");
+	if (f)
+	{
+		fseek(f, 0, SEEK_END);
+		long sz = ftell(f);
+		fclose(f);
+		snprintf(buf, sizeof(buf), "probe: romfs:/data.xp3 OK size=%ld", sz);
+	}
+	else
+	{
+		snprintf(buf, sizeof(buf), "probe: romfs:/data.xp3 FAILED");
+	}
+	GXDiag(buf);
+}
+#else
+extern "C" void GXDiag(const char *) {}
+extern "C" void GXDiagW(const unsigned short *) {}
+extern "C" void GXDiagRomfs(void) {}
 #endif
 
